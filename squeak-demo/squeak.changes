lver support' stamp: 'dtl 3/28/2025 21:54'!testWildcard6	| result |	self shouldnt: [result := SocketAddress wildcard6] raise: Error description: 'requires primitive support'.	self assert: SocketAddressInformation equals: result class.! !!SocketAddressTest methodsFor: 'tests - resolver support' stamp: 'dtl 2/23/2025 13:20'!testWildcards	| result |	self shouldnt: [result := SocketAddress wildcards] raise: Error description: 'requires primitive support'.	self deny: result isEmpty description: 'expect resolver to answer address information'.	self assert: SocketAddressInformation equals: result first class.! !!SocketAddressTest commentStamp: 'dtl 3/29/2025 22:05' prior: 0!SocketAddressTest verifies that calls to the net name resolver for certain loopback and wildcard addresses are functional. Test failures indicate problems in the underlying primitives, or in the resolver for the underlying platform.!SymbolListTile subclass: #TypeListTile	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Etoys-Scripting Tiles'!!TypeListTile methodsFor: 'arrows' stamp: 'sw 7/13/2007 21:45' prior: 118689367!addCaretsAsAppropriate: showingCarets	"If the argument provided is true, make any expected up-down and suffix-retract carets visible; if false, hide them all."	self setVisibilityOfUpDownCarets: true.  "regardless of setting..."	self addMenuIcon! !XMLNode subclass: #XMLStringNode	instanceVariableNames: 'string'	classVariableNames: ''	poolDictionaries: ''	category: 'XML-Parser'!!XMLStringNode methodsFor: '*XML-Explorer' stamp: 'eem 6/1/2023 10:21' prior: 121761703!asExplorerString	^ self string size > 1000		ifTrue: [(string copyFrom: 1 to: 1000), ' ...']		ifFalse: [self string]! !TileMorph subclass: #RandomNumberTile	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Etoys-Scripting Tiles'!!RandomNumberTile methodsFor: 'code generation' stamp: 'yo 4/12/2007 11:47' prior: 66692895!basicParseNodeWith: encoder	^ MessageNode new				receiver: (encoder encodeLiteral: literal)				selector: #atRandom				arguments: #()				precedence: (#atRandom precedence)				from: encoder				sourceRange: nil.! !!RandomNumberTile methodsFor: 'code generation' stamp: 'yo 6/22/2007 01:11' prior: 66693212!kedamaParseNodeWith: encoder actualObject: obj	^ MessageNode new				receiver: (encoder encodePlayer: obj)				selector: #random:				arguments: (encoder encodeLiteral: literal)				precedence: (#random: precedence)				from: encoder				sourceRange: nil.! !!RandomNumberTile methodsFor: 'code generation' stamp: 'yo 4/12/2007 11:47' prior: 66693948!parseNodeWith: encoder	| phrase player costume |	phrase := self outermostMorphThat: [:m| m isKindOf: PhraseTileMorph].	phrase ifNil: [^ self basicParseNodeWith: encoder].	player := phrase associatedPlayer.	player ifNil: [^ self basicParseNodeWith: encoder].	costume := player costume.	costume ifNil: [^ self basicParseNodeWith: encoder].	(player isKindOf: KedamaExamplerPlayer) ifTrue: [		^ self kedamaParseNodeWith: encoder actualObject: player costume renderedMorph kedamaWorld player].	(costume renderedMorph isMemberOf: KedamaMorph) ifTrue: [		^ self kedamaParseNodeWith: encoder actualObject: self].	^ self basicParseNodeWith: encoder.! !!RandomNumberTile methodsFor: 'misc' stamp: 'yo 1/8/2007 22:14' prior: 66693559!labelMorphs	^ submorphs select: [:m | m isKindOf: StringMorph].! !!RandomNumberTile methodsFor: 'misc' stamp: 'yo 1/8/2007 22:13' prior: 66693713!unhibernate	self labelMorphs do: [:l | l label: l contents font: Preferences standardEToysFont].	self removeProperty: #needsLayoutFixed.! !Object subclass: #CommandHistory	instanceVariableNames: 'lastCommand history excursions'	classVariableNames: ''	poolDictionaries: ''	category: 'MorphicExtras-Undo'!!CommandHistory methodsFor: 'called from the ui' stamp: 'mt 5/13/2024 09:15' prior: 23375487!undoTo	"Not yet functional, and not yet sent.  Allow the user to choose a point somewhere in the undo/redo tape, and undo his way to there.   Applicable only if infiniteUndo is set. "	| anIndex commandList reply |	(anIndex := self historyIndexOfLastCommand) = 0 ifTrue: [^ Beeper beep].	commandList := history		copyFrom:	((anIndex - 10) max: 1)		to:			((anIndex + 10) min: history size).	reply := UIManager default chooseFrom: (commandList collect: [:cmd | cmd cmdWording truncateWithEllipsisTo: 20]) values: commandList title: 'undo or redo to...'.	reply ifNotNil: [self inform: #deferred]	"ActiveWorld commandHistory undoTo"! !!CommandHistory methodsFor: 'menu' stamp: 'mt 5/13/2024 09:15' prior: 23379516!redoMenuWording	"Answer the wording to be used in a menu offering the current 	Redo command"	| nextCommand |	((nextCommand := self nextCommand) isNil			or: [Preferences useUndo not])		ifTrue: [^ 'can''t redo' translated].	^ String		streamContents: [:aStream | 			aStream nextPutAll: 'redo' translated.			aStream nextPutAll: ' "'.			aStream nextPutAll: (nextCommand cmdWording truncateWithEllipsisTo: 20).			aStream nextPut: $".			lastCommand phase == #done				ifFalse: [aStream nextPutAll: ' (z)']]! !!CommandHistory methodsFor: 'menu' stamp: 'mt 5/13/2024 09:15' prior: 23380921!undoMenuWording	"Answer the wording to be used in an 'undo' menu item"	(lastCommand isNil			or: [Preferences useUndo not			or: [(Preferences infiniteUndo not and: [lastCommand phase == #undone])			or: [self nextCommandToUndo isNil]]])		ifTrue: [^ 'can''t undo' translated].	^ String		streamContents: [:aStream | 			aStream nextPutAll: 'undo' translated.			aStream nextPutAll: ' "'.			aStream nextPutAll: (self nextCommandToUndo cmdWording truncateWithEllipsisTo: 20).			aStream nextPut: $".			lastCommand phase == #done				ifTrue: [aStream nextPutAll: ' (z)']].! !!CommandHistory methodsFor: 'menu' stamp: 'mt 5/13/2024 09:15' prior: 23382068!undoOrRedoMenuWording	"Answer the wording to be used in a menu item offering undo/redo (i.e., the form used when the #infiniteUndo preference is false)"	| pre |	self assureLastCommandStillValid. 	lastCommand ifNil: [^ 'can''t undo' translated].	pre := lastCommand phase == #done		ifTrue: ['undo' translated]		ifFalse: ['redo' translated].	^ pre, ' "', (lastCommand cmdWording truncateWithEllipsisTo: 20), '" (z)'! !LargePositiveInteger variableByteSubclass: #LargeNegativeInteger	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Numbers'!!LargeNegativeInteger methodsFor: 'bit manipulation' stamp: 'eem 9/9/2025 16:43'!bitShift: shiftCount	"Answer an Integer whose value (in twos-complement representation) is  	 the receiver's value (in twos-complement representation) shifted left by 	 the number of bits indicated by the argument. Negative arguments  	 shift right. Zeros are shifted in from the right in left shifts. N.B. override	 LargePositiveInteger's implementation, allowing LargePositiveInteger>>	 #bitShift: to directly invoke the primDigitBitShiftMagnitude primitive."	^(shiftCount negative		and: [self anyBitOfMagnitudeFrom: 1 to: shiftCount negated])		ifTrue: [(self bitShiftMagnitude: shiftCount) - 1]		ifFalse: [self bitShiftMagnitude: shiftCount]! !Morph subclass: #CalendarMorph	instanceVariableNames: 'date stepTime shouldUpdate'	classVariableNames: ''	poolDictionaries: ''	category: 'MorphicExtras-Demo'!!CalendarMorph methodsFor: 'actions' stamp: 'Richo 1/4/2012 11:52' prior: 20011127!addDays: aNumber	[self date: (date addDays: aNumber)]		on: Error		do: ["Nothing"]! !!CalendarMorph methodsFor: 'actions' stamp: 'Richo 1/4/2012 11:52' prior: 20011284!addMonths: aNumber	[self date: (date addMonths: aNumber)]		on: Error		do: ["Nothing"]! !!CalendarMorph methodsFor: 'actions' stamp: 'Richo 1/4/2012 11:53' prior: 20011445!nextMonth	self addMonths: 1! !!CalendarMorph methodsFor: 'actions' stamp: 'Richo 1/4/2012 11:53' prior: 20011546!nextYear	self addMonths: 12! !!CalendarMorph methodsFor: 'actions' stamp: 'Richo 1/4/2012 11:53' prior: 20011647!previousMonth	self addMonths: -1! !!CalendarMorph methodsFor: 'actions' stamp: 'Richo 1/4/2012 11:53' prior: 20011753!previousYear	self addMonths: -12! !!CalendarMorph methodsFor: 'building' stamp: 'Richo 1/4/2012 12:06' prior: 20011861!buildMonthRow	^ self newRow		addMorphBack: ((self newButtonWithContents: '<-') actionSelector: #previousMonth; target: self);		addMorphBack: AlignmentMorph newVariableTransparentSpacer;		addMorphBack: (date month name translated asMorph color: self labelsDefaultColor);		addMorphBack: AlignmentMorph newVariableTransparentSpacer;		addMorphBack: ((self newButtonWithContents: '->') actionSelector: #nextMonth; target: self)! !!CalendarMorph methodsFor: 'building' stamp: 'Richo 1/4/2012 12:06' prior: 20012363!buildYearRow	^ self newRow		addMorphBack: ((self newButtonWithContents: '<-') actionSelector: #previousYear; target: self);		addMorphBack: AlignmentMorph newVariableTransparentSpacer;		addMorphBack: (date year name asMorph color: self labelsDefaultColor);		addMorphBack: AlignmentMorph newVariableTransparentSpacer;		addMorphBack: ((self newButtonWithContents: '->') actionSelector: #nextYear; target: self)! !!CalendarMorph methodsFor: 'building' stamp: 'ct 8/23/2022 16:47' prior: 20012848!dayInitialsRow	| newRow |	newRow := self newRow.	Week dayNames		do: [:dayName|			newRow addMorphBack: (TextMorph new 				contentsWrapped: dayName translated first asString;				textColor: self labelsDefaultColor;				autoFit: false;				width: 30 px;				centered;				lock)]		separatedBy: [newRow addMorphBack: AlignmentMorph newVariableTransparentSpacer].	^newRow ! !!CalendarMorph methodsFor: 'building' stamp: 'ct 8/23/2022 16:47' prior: 37151703!dayInitialsRow	| newRow |	newRow := self newRow.	Week dayNames		do: [:dayName|			newRow addMorphBack: (TextMorph new 				contentsWrapped: dayName translated first asString;				textColor: self labelsDefaultColor;				autoFit: false;				width: 30 px;				centered;				lock)]		separatedBy: [newRow addMorphBack: AlignmentMorph newVariableTransparentSpacer].	^newRow ! !!CalendarMorph methodsFor: 'building' stamp: 'Richo 1/4/2012 12:05' prior: 20013293!labelsDefaultColor	^ self color makeForegroundColor ! !!CalendarMorph methodsFor: 'building' stamp: 'ct 8/23/2022 16:48' prior: 20013682!newButtonWithContents: aString 	^ SimpleButtonMorph new 		label: aString;		color: (self color mixed: 0.5 with: Color gray);		borderStyle: (BorderStyle raised width: 2 px);		yourself! !!CalendarMorph methodsFor: 'building' stamp: 'ct 8/23/2022 16:48' prior: 37152770!newButtonWithContents: aString 	^ SimpleButtonMorph new 		label: aString;		color: (self color mixed: 0.5 with: Color gray);		borderStyle: (BorderStyle raised width: 2 px);		yourself! !!CalendarMorph methodsFor: 'building' stamp: 'ct 8/23/2022 16:48' prior: 20014218!newDateButtonWithContents: aString	^ SimpleButtonMorph new		label: aString;		cornerStyle: #square;		color: self color muchLighter;		borderStyle: (BorderStyle raised width: 2 px);		width: 30 px;		yourself! !!CalendarMorph methodsFor: 'building' stamp: 'ct 8/23/2022 16:48' prior: 37153320!newDateButtonWithContents: aString	^ SimpleButtonMorph new		label: aString;		cornerStyle: #square;		color: self color muchLighter;		borderStyle: (BorderStyle raised width: 2 px);		width: 30 px;		yourself! !!CalendarMorph methodsFor: 'building' stamp: 'Richo 1/4/2012 12:05' prior: 20014492!newRow	^ AlignmentMorph newRow		vResizing: #shrinkWrap;		color: Color transparent! !!CalendarMorph methodsFor: 'accessing' stamp: 'Richo 1/4/2012 11:59' prior: 20014652!color: aColor	super color: aColor.	shouldUpdate := true! !!CalendarMorph methodsFor: 'accessing' stamp: 'Richo 1/4/2012 11:55' prior: 20014784!date	^ date! !!CalendarMorph methodsFor: 'accessing' stamp: 'Richo 1/4/2012 12:00' prior: 20014871!date: aDate	date := aDate.	shouldUpdate := true! !!CalendarMorph methodsFor: 'accessing' stamp: 'Richo 1/4/2012 12:00' prior: 20014995!fillStyle: aFillStyle	super fillStyle: aFillStyle.	shouldUpdate := true! !!CalendarMorph methodsFor: 'stepping' stamp: 'Richo 1/4/2012 10:58' prior: 20015143!incrementStepTime	stepTime := (stepTime + 1) min: self maximumStepTime! !!CalendarMorph methodsFor: 'stepping' stamp: 'Richo 1/4/2012 10:59' prior: 20015288!maximumStepTime	^ 200! !!CalendarMorph methodsFor: 'stepping' stamp: 'Richo 1/4/2012 12:06' prior: 20015384!minimumStepTime	^ 20! !!CalendarMorph methodsFor: 'stepping' stamp: 'Richo 1/4/2012 12:00' prior: 20015479!step	shouldUpdate		ifTrue: [self update.			stepTime := self minimumStepTime.			shouldUpdate := false]		ifFalse: [self incrementStepTime]! !!CalendarMorph methodsFor: 'stepping' stamp: 'Richo 1/4/2012 12:06' prior: 20015694!stepTime	^ stepTime ! !!CalendarMorph methodsFor: 'initialize' stamp: 'sw 1/25/2012 21:20' prior: 20015790!initialColor	"Answer the color to use for a new Calendar."	^  Color r: 0.516 g: 0.677 b: 1.0"Note: Richo's initial implementation was to use a randomly-chosen color for each new Calendar, for which the code in this method would be:	^ Color random... but in this version, a standard, sedate color is used for each new calendar.   The user can of course change the color using the standard halo recolor tool"! !!CalendarMorph methodsFor: 'initialize' stamp: 'sw 1/25/2012 21:17' prior: 20016279!initialize	"One-time initialization of a new calendar."	super initialize.	date := Date today.	stepTime := self minimumStepTime.	shouldUpdate := false.	self layoutPolicy: TableLayout new;		listDirection: #topToBottom;		hResizing: #shrinkWrap;		vResizing: #shrinkWrap;		color: self initialColor;		cornerStyle: #rounded;		initializeSubmorphs! !!CalendarMorph methodsFor: 'initialize' stamp: 'Richo 1/4/2012 11:57' prior: 20016706!initializeSubmorphs	| weekRow dateButton |	self addMorphBack: self buildYearRow;		 addMorphBack: self buildMonthRow;		 addMorphBack: self dayInitialsRow.	date month weeks		do: [:week | 			weekRow := self newRow.			week dates				do: [:aDate | 					dateButton := self newDateButtonWithContents: aDate dayOfMonth asString.					dateButton actionSelector: #date:; 						 target: self;						 arguments: {aDate}.					date = aDate						ifTrue: [dateButton								color: (self color										mixed: 0.5										with: (self color adjustSaturation: 1 brightness: 1))].					date month ~= aDate month						ifTrue: [dateButton color: self color.							(dateButton findA: StringMorph)								color: Color gray].					weekRow addMorphBack: dateButton]				separatedBy: [weekRow addMorphBack: AlignmentMorph newVariableTransparentSpacer].			self addMorphBack: weekRow]! !!CalendarMorph methodsFor: 'update' stamp: 'Richo 12/27/2011 11:24' prior: 20017656!localeChanged	self update! !!CalendarMorph methodsFor: 'update' stamp: 'Richo 1/4/2012 11:57' prior: 20017754!update	self submorphsDo: [:m | m delete].	self initializeSubmorphs ! !!CalendarMorph commentStamp: 'sw 1/25/2012 21:09' prior: 0!CalendarMorph, by Ricardo Moran, 2011, with some changes by Scott Wallace, January 2012.A CalendarMorph is single-month calendar that is scriptable using tiles in its viewer.  It always has a 'selected' date, for which the correct month and year are shown; the actual day corresponding to the selected date is highlighted on the calendar.!CalendarMorph class	instanceVariableNames: ''!!CalendarMorph class methodsFor: 'viewer categories' stamp: 'sw 1/25/2012 21:53' prior: 20018018!additionsToViewerCategories	"Answer definitions for viewer categories of a Calendar."	^ #(		(#'calendar' (			(slot date 'Shows the selected date' String readOnly Player getDate Player unused  )			(slot day 'Shows the selected day and lets you modify it' Number readWrite Player getDay Player setDay: )			(slot month 'Shows the selected month and lets you modify it' Number readWrite Player getMonth Player setMonth:  )			(slot year 'Shows the selected year and lets you modify it' Number readWrite Player getYear Player setYear:  )			(slot dayName 'Shows the name of the selected day' String readOnly Player getDayName Player unused  )			(slot monthName 'Shows the name of the selected month' String readOnly Player getMonthName Player unused  )			(slot dateFormat 'Lets you choose a format for displaying the date' DateFormat readWrite Player getDateFormat Player setDateFormat:  )			(command goToToday 'Show the current month and highlight the current day on it')			(slot julianDay 'The Julian day of the selected date' Number readWrite Player getJulianDay Player setJulianDay:))))! !!CalendarMorph class methodsFor: 'class initialization' stamp: 'sw 3/17/2012 01:31' prior: 20019209!assureDateFormatEstablished	"Make certain that there is a DateFormat vocabulary in the system's list."	Vocabulary addStandardVocabulary: (SymbolListType new vocabularyName: #DateFormat;				 symbols: #(#'dd/mm/yyyy' #'yyyy/mm/dd' #'mm/dd/yyyy')).! !!CalendarMorph class methodsFor: 'class initialization' stamp: 'sw 3/17/2012 01:32' prior: 20019548!initialize	"Class initialization."	self assureDateFormatEstablished! !!CalendarMorph class methodsFor: 'parts bin' stamp: 'sw 1/25/2012 15:41' prior: 20019698!descriptionForPartsBin	"Answer a description for use in parts bins"	^ self partName: 	'Calendar' translatedNoop		categories:		{'Just for Fun' translatedNoop}		documentation:	'A scriptable calendar' translatedNoop! !Model subclass: #FontImporterTool	instanceVariableNames: 'title allFonts currentSelection currentParent selectedFont previewTextSelector customPreviewText pointSize lineSpacing editModeWidgets'	classVariableNames: 'CustomPreviewTexts'	poolDictionaries: ''	category: 'Morphic-Support'!!FontImporterTool methodsFor: 'edit mode - ui' stamp: 'ct 11/13/2023 18:04' prior: 30094305!ttExtraGapInputHelp	| tt |	tt := self selectedFont ifNotNil: [:f | f isTTCFont ifTrue: [ f ttcDescription ] ].	^ '<b>Extra line gap</b> in font measures. This font''s own value is <b>{1}</b> with units-per-em (UPM) being <b>{2}</b>. Adjust to change the font''s line grid (or "height") to compensate for <b>extra glyph scale</b>. The value may be negative.<br><br>Note that there is also <b>line spacing</b>, which is not per font but per <b>text style</b> and thus application-specific.<br><br>Make empty to reset to default value.' translated asTextFromHtml		format: { 			tt ifNil: ['?'] ifNotNil: [tt typographicLineGap].			tt ifNil: ['?'] ifNotNil: [tt unitsPerEm].		 }! !!FontImporterTool methodsFor: 'edit mode - ui' stamp: 'ct 11/13/2023 18:05' prior: 30095657!ttExtraScaleInputHelp	(self selectedFont isNil or: [self selectedFont isTTCFont not])		ifTrue: [ ^ ''].			^ '<b>Extra glyph scale</b> to accommodate varying heights when using different fonts side-by-side. This font has a relative x-height of <b>{1}</b> while the system''s reference is <b>{2}</b>. You can only use values greater than 0.0.<br><br>Note that this does not change the font''s "pixel height" and is thus unrelated to the system''s overall <b>UI scale factor</b>. You may want to adjust <b>extra line gap</b> as well to retain the font''s aesthetics.<br><br>Make empty to reset to default value.' translated asTextFromHtml		format: {			self selectedFont xHeightFraction printShowingDecimalPlaces: 3.			TextStyle defaultTTFont xHeightFraction printShowingDecimalPlaces: 3 }! !!FontImporterTool methodsFor: 'preview text - ui' stamp: 'ct 11/13/2023 18:04' prior: 30101484!pointSizeInputHelp	self editModeEnabled ifFalse: [		^ 'Point size in the preview box' translated].	^ '<b>Point size</b> in the preview box. The system''s default is currently <b>{1}</b> points. It is recommended to adjust the font''s <b>extra glyph scale</b> and <b>extra line gap</b> using the default point size. Look at other text in the system to assess whether this font would integrate nicely.<br><br>Make empty to reset to default value.' translated asTextFromHtml		format: {TextStyle defaultFont pointSize}! !!MIMELocalFileDocument commentStamp: '<historical>' prior: 0!For local files, we do not read the entire contents unless we absolutely have to.!MCTestCase subclass: #MCEnvironmentLoadTest	instanceVariableNames: 'environment'	classVariableNames: ''	poolDictionaries: ''	category: 'Tests-Monticello'!!MCEnvironmentLoadTest methodsFor: 'running' stamp: 'mt 11/7/2023 11:19' prior: 52886531!tearDown	(environment allClassesAndTraits sorted: [:a :b |		(a allSuperclasses includes: b) or: [a name < b name]])			do: [:each | each removeFromSystemUnlogged].		super tearDown.! !RectangleMorph subclass: #SoundLoopMorph	instanceVariableNames: 'samplesUntilNextControl seqSound cursor controlIndex'	classVariableNames: ''	poolDictionaries: ''	category: 'MorphicExtras-SoundInterface'!!SoundLoopMorph methodsFor: 'stepping' stamp: 'jm 11/14/97 11:21' prior: 89711016!step	self positionCursor! !!SoundLoopMorph methodsFor: 'stepping' stamp: 'jm 11/14/97 11:21' prior: 89711245!stepTime	^ 50! !!SoundLoopMorph methodsFor: 'stepping' stamp: 'jm 11/14/97 11:11' prior: 89711347!stop	"Stop playing this sound."	SoundPlayer pauseSound: self.! !RxsNode subclass: #RxsPredicate	instanceVariableNames: 'predicate negation'	classVariableNames: 'NamedClassSelectors'	poolDictionaries: ''	category: 'Regex-Core'!!RxsPredicate methodsFor: 'initialize-release' stamp: 'ct 10/5/2022 19:44'!beUnicodeCategory: categoryName	| unicodeClass |	unicodeClass := self class unicodeClass.	self predicate: [:char |		(unicodeClass generalCategoryTagOf: char asUnicode) beginsWith: categoryName].! !!RxsPredicate methodsFor: 'initialize-release' stamp: 'ct 12/1/2023 14:57' prior: 37163969!beUnicodeCategory: categoryName	| unicodeClass |	unicodeClass := self class unicodeClass.	self predicate: [:char |		(unicodeClass generalCategoryTagOf: char codePoint) beginsWith: categoryName].! !!RxsPredicate methodsFor: 'initialize-release' stamp: 'ct 8/23/2021 20:50'!predicate: aBlock	predicate := aBlock.	negation := [:char | (predicate value: char) not].! !!RxsPredicate methodsFor: 'accessing' stamp: 'ct 10/5/2022 19:15' prior: 84870247!maximumCharacterCodeIgnoringCase: aBoolean	"Answer the largest character code among the characters I represent."	^-1 "Not enumerable"! !!RxsPredicate methodsFor: 'accessing' stamp: 'ct 10/27/2021 08:53'!predicateIgnoringCase: aBoolean	^predicate! !!RxsPredicate methodsFor: 'accessing' stamp: 'ct 10/27/2021 08:53'!predicateNegationIgnoringCase: aBoolean	^negation! !!RxsPredicate methodsFor: 'building' stamp: 'vb 4/11/09 21:56' prior: 84870007!dispatchTo: anObject	^anObject syntaxPredicate: self! !!RxsPredicate methodsFor: 'building' stamp: 'ul 3/26/2016 20:49' prior: 84870133!enumerateTo: aSet	^self "Not enumerable"! !!RxsPredicate methodsFor: 'converting' stamp: 'vb 4/11/09 21:56' prior: 84870453!negated	^self copy negate! !!RxsPredicate commentStamp: 'Tbn 11/12/2010 23:15' prior: 0!-- Regular Expression Matcher v 1.1 (C) 1996, 1999 Vassili Bykov--This represents a character that satisfies a certain predicate.Instance Variables:	predicate	<BlockClosure>	A one-argument block. If it evaluates to the value defined by <negated> when it is passed a character, the predicate is considered to match.	negation	<BlockClosure>	A one-argument block that is a negation of <predicate>.!RxsPredicate class	instanceVariableNames: ''!!RxsPredicate class methodsFor: 'class initialization' stamp: 'ct 10/27/2021 08:16' prior: 84872029!initialize	"self initialize"	self initializeNamedClassSelectors! !!RxsPredicate class methodsFor: '*61Deprecated-instance creation' stamp: 'ct 10/27/2021 08:16' prior: 84871481!forEscapedLetter: aCharacter	"Return a predicate instance for the given character, or nil if there's no such predicate."	self deprecated.	^ RxParser new		initialize: {aCharacter} readStream;		backslashPredicate! !!RxsPredicate class methodsFor: 'support' stamp: 'ct 10/5/2022 19:47'!isValidUnicodeCategory: categoryName	^ (self unicodeClass allCategoryTags anySatisfy: [:tag | tag beginsWith: categoryName])! !!RxsPredicate class methodsFor: 'support' stamp: 'ct 10/5/2022 19:45'!supportsUnicode	^ self unicodeClass notNil! !!RxsPredicate class methodsFor: 'support' stamp: 'ct 10/5/2022 19:44'!unicodeClass	^ Smalltalk classNamed: #Unicode! !Object subclass: #Chess960Configuration	instanceVariableNames: 'positions king leftRook rightRook'	classVariableNames: ''	poolDictionaries: 'ChessConstants'	category: 'MorphicExtras-Games-Chess960'!!Chess960Configuration methodsFor: 'positions' stamp: 'spfa 6/1/2020 11:15' prior: 21408269!initialKingPosition	^ king ifNil: [king := positions indexOf: King]! !!Chess960Configuration methodsFor: 'positions' stamp: 'spfa 6/1/2020 11:15' prior: 21408420!initialLeftRookPosition	^ leftRook ifNil: [leftRook := positions indexOf: Rook]! !!Chess960Configuration methodsFor: 'positions' stamp: 'spfa 6/1/2020 11:16' prior: 21408583!initialRightRookPosition	^ rightRook ifNil: [rightRook := positions indexOf: Rook startingAt: self initialKingPosition]! !!Chess960Configuration methodsFor: 'positions' stamp: 'spfa 6/1/2020 10:55' prior: 21408786!positions	^ positions! !!Chess960Configuration methodsFor: 'positions' stamp: 'spfa 6/1/2020 11:16' prior: 21408891!positions: anArray	positions := anArray.	king := leftRook := rightRook := nil! !!Chess960Configuration commentStamp: 'spfa 6/2/2020 15:13' prior: 0!A Chess960Configuration is a Fisher-style random starting arrangement of pieces in the home ranks!Chess960Configuration class	instanceVariableNames: ''!!Chess960Configuration class methodsFor: 'as yet unclassified' stamp: 'spfa 6/1/2020 10:54' prior: 21409185!new	| rand positions k |	rand := Random new.	positions := Array new: 8.	positions at: (rand nextInt: 4) * 2 - 1 put: Bishop.	positions at: (rand nextInt: 4) * 2 put: Bishop.	positions at: (k := (((1 to: 8) select: [:n | (positions at: n) isNil]) copyFrom: 2 to: 5) atRandom: rand) put: King.	positions at: (((1 to: k-1) select: [:n | (positions at: n) isNil]) atRandom: rand) put: Rook.	positions at: (((k+1 to: 8) select: [:n | (positions at: n) isNil]) atRandom: rand) put: Rook.	positions at: (((1 to: 8) select: [:n | (positions at: n) isNil]) atRandom: rand) put: Queen.	positions at: ((1 to: 8) detect: [:n | (positions at: n) isNil]) put: Knight.	positions at: ((1 to: 8) detect: [:n | (positions at: n) isNil]) put: Knight.	^ self basicNew positions: positions! !Collection subclass: #CharacterSet	instanceVariableNames: 'byteArrayMap'	classVariableNames: 'Ascii CrLf NonAscii NonSeparators Separators'	poolDictionaries: ''	category: 'Collections-Support'!!CharacterSet methodsFor: 'copying' stamp: 'mt 8/10/2023 09:34'!copyWithoutDuplicates	 self shouldNotImplement.! !UTF8ClipboardInterpreter subclass: #UTF8JPClipboardInterpreter	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Multilingual-TextConversion'!!UTF8JPClipboardInterpreter methodsFor: 'conversion-clipboard' stamp: 'yo 10/29/2007 17:47' prior: 119564190!fromSystemClipboard: aString	^aString convertFromWithConverter: UTF8TextConverter new.! !Object subclass: #TheWorldMenu	instanceVariableNames: 'myProject myWorld myHand'	classVariableNames: 'OpenMenuRegistry'	poolDictionaries: ''	category: 'Morphic-Kernel'!!TheWorldMenu methodsFor: 'commands' stamp: 'mt 1/9/2023 10:46' prior: 100536554!openTranscript	Transcript open.! !!TheWorldMenu methodsFor: 'commands' stamp: 'mt 7/13/2022 09:07' prior: 100544004!setDisplayDepth	"Let the user choose a new depth for the display. "	| menu effect oldDepth allDepths allLabels hasBoth |	oldDepth := Display nativeDepth.	allDepths := #(1 -1 2 -2 4 -4 8 -8 16 -16 32 -32) select: [:d | Display supportsDisplayDepth: d].	hasBoth := (allDepths anySatisfy:[:d| d > 0]) and:[allDepths anySatisfy:[:d| d < 0]].	allLabels := allDepths collect:[:d|		String streamContents:[:s|			s nextPutAll: (d = oldDepth ifTrue:['<on>'] ifFalse:['<off>']).			s print: d abs.			hasBoth ifTrue:[s nextPutAll: (d > 0 ifTrue:['  (big endian)'] ifFalse:['  (little endian)'])].		]].	effect := [:choice | | newDepth |		newDepth := allDepths at: choice.		Display newDepth: newDepth].		oldDepth := oldDepth abs.		(Smalltalk isMorphic and: [(Display depth < 4) ~= (oldDepth < 4)])			ifTrue:				["Repaint windows since they look better all white in depth < 4"				(SystemWindow windowsIn: myWorld satisfying: [:w | true]) do:					[:w |					oldDepth < 4						ifTrue: [w restoreDefaultPaneColor]						ifFalse: [w updatePaneColors]]].	menu := MenuMorph new		title: 'Choose a display depth' translated;		target: effect;		yourself.	allLabels withIndexDo: [:label :index |		menu add: label action: #value:.		menu lastItem arguments: {index}].	menu		invokeAt: self currentHand position		in: self currentWorld		allowKeyboard: true.! !!TheWorldMenu methodsFor: '*Etoys-action' stamp: 'RAA 5/26/2000 10:18' prior: 100526499!menuColorString	^ Preferences menuColorString! !!TheWorldMenu methodsFor: '*Etoys-action' stamp: 'mt 7/28/2016 10:43' prior: 100528094!roundedCornersString	^ (((SystemWindow roundedWindowCorners)		ifTrue: ['stop']		ifFalse: ['start']) , ' rounding window corners') translated! !!TheWorldMenu methodsFor: '*Etoys-action' stamp: 'mt 8/27/2015 10:14' prior: 100529138!toggleMenuColorPolicy	Preferences toggle: #menuColorFromWorld.! !!TheWorldMenu methodsFor: '*Etoys-*MorphicExtras-mechanics' stamp: 'RAA 6/15/2000 10:16' prior: 100638929!adaptToWorld: aWorld        myWorld := aWorld.        myProject := nil.                "figure it out if and when needed. maybe make it easier to find"        myHand := aWorld primaryHand.! !!TheWorldMenu methodsFor: '*Etoys-commands' stamp: 'RAA 5/24/2000 17:31' prior: 100533737!mvcProjectsAllowed	^Preferences mvcProjectsAllowed and: [Smalltalk includesKey: #StandardSystemView]! !DebuggerMethodMapForClosureCompiledMethods subclass: #DebuggerMethodMapForFullBlockCompiledMethods	instanceVariableNames: 'sortedSourceMaps'	classVariableNames: ''	poolDictionaries: ''	category: 'Tools-Debugger'!!DebuggerMethodMapForFullBlockCompiledMethods methodsFor: 'source mapping' stamp: 'eem 7/22/2024 14:28' prior: 25582891!rangeForPC: contextsConcretePC in: method contextIsActiveContext: contextIsActiveContext	"Answer the indices in the source code for the supplied pc.	 If the context is the actve context (is at the hot end of the stack)	 then its pc is the current pc.  But if the context isn't, because it is	 suspended sending a message, then its current pc is the previous pc."	| pc i end mapForMethod sortedMap |	pc := method abstractPCForConcretePC: (contextIsActiveContext													ifTrue: [contextsConcretePC]													ifFalse: [(method pcPreviousTo: contextsConcretePC)																ifNotNil: [:prevpc| prevpc]																ifNil: [contextsConcretePC]]).	((mapForMethod := self abstractSourceMapForMethod: method) includesKey: pc) ifTrue:		[^mapForMethod at: pc].	sortedSourceMap ifNil:		[sortedSourceMap := IdentityDictionary new].	sortedMap := sortedSourceMap						at: method						ifAbsentPut: [mapForMethod associations										replace: [ :each | each copy ];										sort].	sortedMap isEmpty ifTrue: [^1 to: 0].	i := sortedMap			findBinaryIndex: [:assoc| pc - assoc key]			ifNone: [:lower :upper | upper].	i < 1 ifTrue: [^1 to: 0].	i > sortedMap size ifTrue:		[end := sortedMap inject: 0 into:			[:prev :this | prev max: this value last].		^end + 1 to: end].	^(sortedMap at: i) value	"| method source scanner map |	 method := DebuggerMethodMapForFullBlockCompiledMethods compiledMethodAt: #rangeForPC:in:contextIsActiveContext:.	 source := method getSourceFromFile asString.	 scanner := InstructionStream on: method.	 map := method debuggerMap.	 Array streamContents:		[:ranges|		[scanner atEnd] whileFalse:			[| range |			 range := map rangeForPC: scanner pc in: method contextIsActiveContext: true.			 ((map abstractSourceMap includesKey: scanner abstractPC)			  and: [range first ~= 0]) ifTrue:				[ranges nextPut: (source copyFrom: range first to: range last)].			scanner interpretNextInstructionFor: InstructionClient new]]"! !AlignmentMorphBob1 subclass: #NebraskaServerMorph	instanceVariableNames: 'server slowCounter previousBacklog lastFullUpdateTime currentStatusString fullDisplay previousClients currentBacklogString'	classVariableNames: ''	poolDictionaries: ''	category: 'Nebraska-Morphic-Remote'!!NebraskaServerMorph methodsFor: 'stepping' stamp: 'RAA 12/11/2000 12:19' prior: 59253946!step	| now |	self server ifNil: [ ^self ].	self server step.	now := Time millisecondClockValue.	(now - lastFullUpdateTime) abs > 5000 ifTrue: [		lastFullUpdateTime := now.		(previousBacklog = self server backlog and: [self server clients = previousClients]) ifFalse: [			previousClients := self server clients copy.			self rebuild		]	].! !NebraskaServerMorph class	instanceVariableNames: ''!!NebraskaServerMorph class methodsFor: 'as yet unclassified' stamp: 'ct 12/26/2023 17:58' prior: 59257466!serveWorld: aWorld	"Check to make sure things won't crash. See Mantis #0000519"	^aWorld isSafeToServe ifTrue:[		self serveWorld: aWorld onPort: NebraskaServer defaultPort]	! !MorphicModel subclass: #ScrollPane	instanceVariableNames: 'scrollBar scroller retractableScrollBar scrollBarOnLeft getMenuSelector getMenuTitleSelector hasFocus hScrollBar hScrollBarPolicy vScrollBarPolicy scrollBarThickness'	classVariableNames: 'HorizontalScrollDeltaPerMouseWheelNotch UseRetractableScrollBars VerticalScrollDeltaPerMouseWheelNotch'	poolDictionaries: ''	category: 'Morphic-Windows'!!ScrollPane methodsFor: 'event handling' stamp: 'mt 11/16/2023 15:07' prior: 86666443!handlesMouseWheel: evt	evt isWheelUp ifTrue: [^ scrollBar value > scrollBar minimumValue].	evt isWheelDown ifTrue: [^ scrollBar value < scrollBar maximumValue].	evt isWheelLeft ifTrue: [^ hScrollBar value > hScrollBar minimumValue].	evt isWheelRight ifTrue: [^ hScrollBar value < hScrollBar maximumValue].	^ false! !!ScrollPane methodsFor: 'event handling' stamp: 'mt 11/16/2023 15:06' prior: 86674243!scrollByKeyboard: event 	"Backwards compatibility. If event is ctrl+up/down then scroll and answer true. Use mouse-wheel events by default, see #mouseWheel:."		(event controlKeyPressed or: [event commandKeyPressed]) ifFalse: [^ false].		event keyCharacter = Character arrowUp ifTrue: [		^ scrollBar value > scrollBar minimumValue			ifTrue: [scrollBar scrollUp: 3. true]			ifFalse: [false] ].	event keyCharacter = Character arrowDown ifTrue: [		^ scrollBar value < scrollBar maximumValue			ifTrue: [scrollBar scrollDown: 3. true]			ifFalse: [false] ].	"	event keyCharacter = Character arrowRight ifTrue: [		^ hScrollBar value > hScrollBar minimumValue			ifTrue [hScrollBar scrollDown: 3. true]			ifFalse: [false] ].	event keyCharacter = Character arrowLeft ifTrue: [		^ hScrollBar value < hScrollBar maximumValue			ifTrue: [hScrollBar scrollUp: 3. true]			ifFalse: [false] ].	"		^ false! !!ScrollPane methodsFor: 'geometry' stamp: 'ct 10/10/2022 14:57' prior: 86681513!scrollDeltaHeight	"Return the increment in pixels which this pane should be scrolled (normally a subclass responsibility)."	^ 10 px! !!ScrollPane methodsFor: 'geometry' stamp: 'ct 10/10/2022 14:58' prior: 86681713!scrollDeltaWidth	"Return the increment in pixels which this pane should be scrolled (normally a subclass responsibility)."	^ 10 px! !!ScrollPane methodsFor: 'initialization' stamp: 'ct 10/7/2022 15:45' prior: 86688872!defaultExtent	^150 px @ 120 px! !!ScrollPane methodsFor: 'initialization' stamp: 'mt 11/16/2023 14:56' prior: 86690824!initialize		"initialize the state of the receiver"	super initialize.	""	self initializePreferences.	hasFocus := false.	self initializeScrollBars.	""		self extent: self defaultExtent.	self updateMinimumExtent.		self setDefaultParameters.	self addKeyboardBubbleFilter: self.! !!ScrollPane methodsFor: 'initialization' stamp: 'mt 8/31/2023 10:46' prior: 86703334!setDefaultParameters	"change the receiver's appareance parameters"	self		color: (self userInterfaceTheme color ifNil: [Color white]);		borderStyle: (self userInterfaceTheme borderStyle ifNil: [BorderStyle simple]) copy;		borderColor: (self userInterfaceTheme borderColor ifNil: [Color gray: 0.6]);		borderWidth: (self userInterfaceTheme borderWidth ifNil: [1]) px.		self removeProperty: #keyboardFocusWidth.	self removeProperty: #keyboardFocusColor.! !!ScrollPane methodsFor: 'scrolling' stamp: 'mt 6/8/2023 10:09' prior: 86719466!scrollToShow: aRectangle	"Change the receiver's scroller's offset to make aRectangle visible, which is determined by the scroller's current bounds on screen. Note that if aRectangle depends on the receiver's layout being already computed, you must call #fullBounds before fetching the info used for aRectangle."		| newOffset |	newOffset := self offsetToShow: aRectangle.	self hScrollBar setValue: newOffset x.	self vScrollBar setValue: newOffset y.! !!ScrollPane methodsFor: 'layout' stamp: 'mt 9/19/2023 09:34'!newScrollerBounds	"Answer the new bounds for the receiver's scrolling area. Should be called after a #layoutChanged."	| inner bottomOffset leftOffset rightOffset |	(retractableScrollBar or: [self vIsScrollbarShowing not])		ifTrue: [leftOffset := rightOffset := 0]		ifFalse: [			scrollBarOnLeft				ifTrue: [					leftOffset := self scrollBarThickness - self borderWidth.					rightOffset := 0.]				ifFalse: [					leftOffset := 0.					rightOffset := self scrollBarThickness - self borderWidth]].				(retractableScrollBar or: [self hIsScrollbarShowing not])		ifTrue: [bottomOffset := 0]		ifFalse: [bottomOffset := self scrollBarThickness - self borderWidth].		inner := self innerBounds.	^ (inner left + leftOffset) @ (inner top "+ topOffset")		corner: (inner right - rightOffset) @ (inner bottom - bottomOffset)! !!ScrollPane methodsFor: 'layout' stamp: 'mt 9/20/2023 11:10' prior: 37179933!newScrollerBounds	"Answer the new bounds for the receiver's scrolling area. Should be called after a #layoutChanged."	| inner bottomOffset leftOffset rightOffset |	(retractableScrollBar or: [self vIsScrollbarShowing not])		ifTrue: [leftOffset := rightOffset := 0]		ifFalse: [			scrollBarOnLeft				ifTrue: [					leftOffset := self scrollBarThickness - self borderWidth.					rightOffset := 0.]				ifFalse: [					leftOffset := 0.					rightOffset := self scrollBarThickness - self borderWidth]].				(retractableScrollBar or: [self hIsScrollbarShowing not])		ifTrue: [bottomOffset := 0]		ifFalse: [bottomOffset := self scrollBarThickness - self borderWidth].		self flag: #todo. "mt: Make layoutInset appear outside all scrollbars, not just the scroller."	inner := self layoutBounds.	^ (inner left + leftOffset) @ (inner top "+ topOffset")		corner: (inner right - rightOffset) @ (inner bottom - bottomOffset)! !!ScrollPane methodsFor: 'layout' stamp: 'mt 9/27/2023 15:09' prior: 86725703!submorphBoundsForShrinkWrap	"Like #newScrollerBounds but uses the current scroller bounds, which were already shrink-wrapped at this point. See #hResizing: and #vResizing:."	| inner bottomOffset leftOffset rightOffset |	(retractableScrollBar or: [self vIsScrollbarShowing not])		ifTrue: [leftOffset := rightOffset := 0]		ifFalse: [			scrollBarOnLeft				ifTrue: [					leftOffset := self scrollBarThickness - self borderWidth.					rightOffset := 0.]				ifFalse: [					leftOffset := 0.					rightOffset := self scrollBarThickness - self borderWidth]].				(retractableScrollBar or: [self hIsScrollbarShowing not])		ifTrue: [bottomOffset := 0]		ifFalse: [bottomOffset := self scrollBarThickness - self borderWidth].		inner := scroller bounds.	^ (inner left - leftOffset) @ (inner top "+ topOffset")		corner: (inner right + rightOffset) @ (inner bottom + bottomOffset)! !!ScrollPane methodsFor: 'event filtering' stamp: 'mt 11/16/2023 15:07' prior: 86744549!filterEvent: aKeyboardEvent for: morphOrNil	"See #initialize. This filter should be installed as keyboard event filter during the bubbling phase to support nested scroll panes from innermost to outermost, like the default #mouseWheel: support does because of normal event dispatching."	(aKeyboardEvent isKeystroke		and: [self scrollByKeyboard: aKeyboardEvent])			ifTrue: [aKeyboardEvent ignore].	^ aKeyboardEvent! !!ScrollPane methodsFor: 'layout - resizing' stamp: 'mt 9/19/2023 09:34' prior: 86764646!resizeScroller	scroller		bounds: self newScrollerBounds;		fullBounds. "To make #shrinkWrap work."! !ScrollPane class	instanceVariableNames: ''!!ScrollPane class methodsFor: 'defaults' stamp: 'mt 8/31/2023 10:46' prior: 86781564!scrollBarThickness	^ Preferences scrollBarsNarrow ifTrue: [10px] ifFalse: [14px]! !MonokaiTheme class	instanceVariableNames: ''!!MonokaiTheme class methodsFor: 'instance creation' stamp: 'mt 1/26/2023 15:33' prior: 56755091!addDarkScrollables: theme	"self createDark apply."	"Scroll bars"	theme		set: #thumbColor for: #ScrollBar to: self backgroundColor;		set: #thumbBorderColor for: #ScrollBar to: self backgroundColor;		set: #thumbBorderWidth for: #ScrollBar to: 1;		set: #thumbColorModifier for: #ScrollBar to: [ [:c | c adjustBrightness: -0.2] ];		set: #pagingAreaColorModifier for: #ScrollBar to: [ [:c | Color transparent ] ];		set: #borderColorModifier for: #ScrollBar to: [ [:c | c adjustBrightness: -0.2] ].		"Scroll panes (includes generic stuff for list widgets, tree widgets, and text widgets."	theme		set: #borderWidth for: #ScrollPane to: 0;	"	set: #borderColor for: #ScrollPane to: Color transparent;"		set: #color for: #ScrollPane to: self backgroundColor.			"List widgets"	theme		set: #textColor for: #PluggableListMorph to: self foregroundColor;		set: #selectionColor for: #PluggableListMorph to: self invisibleColor;		set: #selectionTextColor for: #PluggableListMorph to: self yellow;		set: #filterColor for: #PluggableListMorph to: self yellow;		set: #filterTextColor for: #PluggableListMorph to: self backgroundColor;		set: #preSelectionModifier for: #PluggableListMorph to: [ [:c | c lighter alpha: 0.5 ] ];		set: #hoverSelectionModifier for: #PluggableListMorph to: [ [:c | c lighter alpha: 0.5 ] ].			"Tree widgets"	theme		set: #highlightTextColor for: #SimpleHierarchicalListMorph to: self yellow lighter lighter;		set: #lineColor for: #SimpleHierarchicalListMorph to: self grayLight;		set: #toggleColor for: #SimpleHierarchicalListMorph to: self grayLightest.		"Text widgets"	theme		set: #textColor for: #PluggableTextMorph to: self foregroundColor;		set: #caretColor for: #PluggableTextMorph to: self yellow;		set: #selectionColor for: #PluggableTextMorph to: self invisibleColor;		set: #unfocusedSelectionModifier for: #PluggableTextMorph to: [ [:c | (Color r: 0.285 g: 0.282 b: 0.242) "invisible color"] ];		set: #adornmentReadOnly for: #PluggableTextMorph to: self magenta;		set: #adornmentRefuse for: #PluggableTextMorph to: self cyan;		set: #adornmentConflict for: #PluggableTextMorph to: self red;		set: #adornmentDiff for: #PluggableTextMorph to: self green;		set: #adornmentNormalEdit for: #PluggableTextMorph to: self orange;		set: #adornmentDiffEdit for: #PluggableTextMorph to: self yellow.	theme		set: #balloonTextColor for: #PluggableTextMorphPlus to: self grayLight.! !Object subclass: #MorphExtension	instanceVariableNames: 'locked visible sticky balloonText balloonTextSelector externalName isPartsDonor actorState player eventHandler otherProperties'	classVariableNames: ''	poolDictionaries: ''	category: 'Morphic-Kernel'!!MorphExtension methodsFor: 'accessing' stamp: 'ct 5/12/2025 19:37' prior: 57894198!balloonTextSelector: aSymbolOrBlock	"change the receiver's balloonTextSelector"	balloonTextSelector := aSymbolOrBlock! !!MorphExtension methodsFor: '*Etoys-accessing' stamp: 'dgd 2/16/2003 21:42' prior: 57895962!player	"answer the receiver's player"	^ player! !!MorphExtension methodsFor: '*Etoys-accessing' stamp: 'dgd 2/16/2003 21:53' prior: 57896246!player: anObject 	"change the receiver's player"	player := anObject ! !ClassTestCase subclass: #ClassBuilderTest	instanceVariableNames: 'baseClass subClass baseClass2 subSubClass'	classVariableNames: ''	poolDictionaries: ''	category: 'KernelTests-Classes'!!ClassBuilderTest methodsFor: 'private' stamp: 'ClassBuilderTest 11/9/2025 12:12'!actualUndeclareAndRedeclareTest: undeclareds	| space bsBinding |	space := Character space.	baseClass := Object subclass: self baseClassName		instanceVariableNames: 'a b c'		classVariableNames: ''		poolDictionaries: ''		category: self categoryNameForTemporaryClasses.	self assert: 3 equals: baseClass instSize.	'abc' do:		[:char|		 baseClass		 	compile: (String with: char with: space with: $^ with: char);			compile: ('<1s>: v <1s> := v' expandMacrosWith: char asString)].	'abc' withIndexDo:		[:char :index| | sym |		sym := char asSymbol.		(undeclareds includes: char) ifFalse:			[self deny: (Undeclared includesKey: sym)].		self assert: ((baseClass >> sym) isQuick and: [(baseClass >> sym) returnField + 1 = index]).		self assert: (baseClass >> (String with: char with: $:) asSymbol writesField: index)].	Object subclass: self baseClassName		instanceVariableNames: 'a c'		classVariableNames: ''		poolDictionaries: ''		category: self categoryNameForTemporaryClasses.	self assert: 2 equals: baseClass instSize.	self assert: (Undeclared includesKey: #b).	bsBinding := Undeclared bindingOf: #b.	self assert: (baseClass >> #b readsRef: bsBinding).	self assert: (baseClass >> #b: writesRef: bsBinding).	baseClass := Object subclass: self baseClassName		instanceVariableNames: 'a b c'		classVariableNames: ''		poolDictionaries: ''		category: self categoryNameForTemporaryClasses.	self assert: 3 equals: baseClass instSize.	"N.B. declaring b as an inst var does not remove it from Undeclared!!!!"	self assert: (Undeclared includesKey: #b).	self deny: (baseClass >> #b readsRef: bsBinding).	self deny: (baseClass >> #b: writesRef: bsBinding).	'abc' withIndexDo:		[:char :index| | sym |		sym := char asSymbol.		char ~~ $b ifTrue:			[self deny: (Undeclared includesKey: sym)].		self assert: ((baseClass >> sym) isQuick and: [(baseClass >> sym) returnField + 1 = index]).		self assert: (baseClass >> (String with: char with: $:) asSymbol writesField: index)]! !!ClassBuilderTest methodsFor: 'tests - reshape' stamp: 'ClassBuilderTest 11/9/2025 12:07'!testUndeclareAndRedeclare	| undeclareds |	undeclareds := 'abc' select: [:char| Undeclared includesKey: char asSymbol].	[self actualUndeclareAndRedeclareTest: undeclareds] ensure:		['abc' do:			[:char|			 (undeclareds includes: char) ifFalse:				[Undeclared removeKey: char asSymbol ifAbsent: []]]].	self assert: undeclareds equals: ('abc' select: [:char| Undeclared includesKey: char asSymbol])! !HandleMorph subclass: #NewHandleMorph	instanceVariableNames: 'hand offset waitingForClickInside'	classVariableNames: ''	poolDictionaries: ''	category: 'Morphic-Widgets'!!NewHandleMorph methodsFor: 'stepping' stamp: 'RAA 4/19/2001 11:37' prior: 59388473!step	| eventSource |	eventSource := self sensorMode ifTrue: [		Sensor	] ifFalse: [		hand lastEvent	].	eventSource anyButtonPressed		ifTrue: [waitingForClickInside := false.				self position: eventSource cursorPoint - (self extent // 2).				pointBlock value: self center]		ifFalse: [waitingForClickInside					ifTrue: [(self containsPoint: eventSource cursorPoint)								ifFalse: ["mouse wandered out before clicked"										^ self delete]]					ifFalse: [lastPointBlock value: self center.							^ self delete]]! !DataType subclass: #FullVocabulary	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Protocols-Kernel'!!FullVocabulary methodsFor: 'method list' stamp: 'ct 11/19/2024 03:35'!allSelectorsInCategory: categoryName forInstance: anObject ofClass: aClass	"Answer a list of all selectors which are in the given category, on behalf of anObject"	| classToUse |	classToUse := aClass ifNil: [anObject class].	^ classToUse allSelectorsInCategory: categoryName! !AssemblerEncoderInterface subclass: #BytecodeSizer	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'MethodMassage-Kernel'!!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 11/18/2018 18:33'!blockReturnConstant: aLiteral	"Rubbish way of handling special constants."	^[aLiteral == nil		ifTrue: [encoder sizeReturnNilToCaller]		ifFalse: [encoder sizeReturnSpecialLiteralToCaller: aLiteral]]		on: Error		do: [:ex| ex return: (self pushLiteral: aLiteral) + self blockReturnTop]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/22/2013 15:26'!blockReturnTop	^encoder sizeReturnTopToCaller! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/24/2017 10:23'!branchIfInstanceOf: behaviorOrArrayOfBehaviors distance: distanceOrLabel	| litIndex distance |	litIndex := encoder litIndexOrNilFor: behaviorOrArrayOfBehaviors.	litIndex ifNil:		[litIndex := encoder litIndex: behaviorOrArrayOfBehaviors].	distance := (assembler isLabel: distanceOrLabel)				ifTrue: [assembler spanToLabel: distanceOrLabel]				ifFalse: [distanceOrLabel].	^distance ifNotNil:		[encoder sizeBranchIfInstanceOf: litIndex distance: distance]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/24/2017 10:23'!branchIfInstanceOfLiteralAtIndex: litIndex distance: distanceOrLabel	| distance |	distance := (assembler isLabel: distanceOrLabel)				ifTrue: [assembler spanToLabel: distanceOrLabel]				ifFalse: [distanceOrLabel].	^distance ifNotNil:		[encoder sizeBranchIfInstanceOf: litIndex distance: distance]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/24/2017 10:23'!branchIfNotInstanceOf: behaviorOrArrayOfBehaviors distance: distanceOrLabel	| litIndex distance |	litIndex := encoder litIndexOrNilFor: behaviorOrArrayOfBehaviors.	litIndex ifNil:		[litIndex := encoder litIndex: behaviorOrArrayOfBehaviors].	distance := (assembler isLabel: distanceOrLabel)				ifTrue: [assembler spanToLabel: distanceOrLabel]				ifFalse: [distanceOrLabel].	^distance ifNotNil:		[encoder sizeBranchIfNotInstanceOf: litIndex distance: distance]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/24/2017 10:23'!branchIfNotInstanceOfLiteralAtIndex: litIndex distance: distanceOrLabel	| distance |	distance := (assembler isLabel: distanceOrLabel)				ifTrue: [assembler spanToLabel: distanceOrLabel]				ifFalse: [distanceOrLabel].	^distance ifNotNil:		[encoder sizeBranchIfNotInstanceOf: litIndex distance: distance]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 4/10/2015 11:04'!callInlinePrimitive: primitiveIndex	^encoder sizeCallInlinePrimitive: primitiveIndex! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/23/2013 21:35'!callPrimitive: primitiveIndex	^encoder sizeCallPrimitive: primitiveIndex! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 4/6/2015 12:08'!directedSuperSend: selector numArgs: nArgs	^encoder sizeSendDirectedSuper: (encoder sharableLitIndex: selector) numArgs: nArgs! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/23/2013 17:46'!doDup	^encoder sizeDup! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/22/2013 13:21'!doPop	^encoder sizePop! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/15/2013 14:01'!extA: anInteger 	^encoder sizeUnsignedSingleExtendA: anInteger! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/15/2013 14:00'!extB: anInteger 	^encoder sizeUnsignedSingleExtendB: anInteger! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/22/2013 15:02'!jump: offsetOrLabel	| offset |	offset := (assembler isLabel: offsetOrLabel)				ifTrue: [assembler spanToLabel: offsetOrLabel]				ifFalse: [offsetOrLabel].	^offset		ifNotNil: [encoder sizeJump: offset]		ifNil: ["If this is a backward jump that is as-yet unsized, answer the long backward jump size.			   c.f. e.g. MessageNode>>#sizeCodeForWhile:value:"			  offsetOrLabel value <= assembler index ifTrue:				[encoder sizeJumpLong: -1]]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/22/2013 14:21'!jump: offsetOrLabel if: condition	| offset |	offset := (assembler isLabel: offsetOrLabel)				ifTrue: [assembler spanToLabel: offsetOrLabel]				ifFalse: [offsetOrLabel].	^offset ifNotNil:		[condition			ifTrue: [encoder sizeBranchPopTrue: offset]			ifFalse: [encoder sizeBranchPopFalse: offset]]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/15/2013 15:48'!jumpLong: offsetOrLabel	| offset |	offset := (assembler isLabel: offsetOrLabel)				ifTrue: [assembler spanToLabel: offsetOrLabel]				ifFalse: [offsetOrLabel].	^offset ifNotNil:		[encoder sizeJumpLong: offset]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/15/2013 15:38'!jumpLong: offsetOrLabel if: condition	| offset |	offset := (assembler isLabel: offsetOrLabel)				ifTrue: [assembler spanToLabel: offsetOrLabel]				ifFalse: [offsetOrLabel].	^offset ifNotNil:		[condition			ifTrue: [encoder sizeBranchPopTrueLong: offset]			ifFalse: [encoder sizeBranchPopFalseLong: offset]]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/23/2013 16:27'!methodReturnConstant: aLiteral	"Rubbish way of handling special constants."	^[encoder sizeReturnSpecialLiteral: aLiteral]		on: