fy' stamp: 'tobe 4/13/2024 11:43'!wrap: aRange in: aString open: anotherString close: aThirdString	self		example: [PNode new]		args: [{PRange start: 3 size: 3. 'abcdefghi'. '('. ')'}]		label: 'example'.		^ (aString first: aRange start index), anotherString, (aString copyFrom: aRange start index + 1 to: aRange end index), aThirdString, (aString allButFirst: aRange end index)! !!PNode methodsFor: 'as yet unclassified'!absolutePositionOf: aMorph	| n |	n := 0.	self allChildrenDo: [:m |		n := n + 1.		m = aMorph ifTrue: [^ n]].	^ self assert: false! !!PNode methodsFor: 'as yet unclassified'!adaptInput: input in: source at: cursorIndex textMorph: textMorph event: anEvent	"do not place closing pair characters if they are coming up right after"	| index |	index := cursorIndex isNumber ifTrue: [cursorIndex] ifFalse: [cursorIndex start index].	(self pairMap keyAtValue: input ifAbsent: nil) ifNotNil: [:openChar |		(source at: index + 1 ifPresent: [:char | input first = char] ifAbsent: [false]) ifTrue: [			self owner startInputAtSourceIndex: index + 1.			^ '']].		self pairMap at: input ifPresent: [:complete |		"do not autocomplete quotes in words"		(complete = '''' and: [source at: index ifPresent: #isAlphaNumeric ifAbsent: [false]]) ifTrue: [^ input].				"do not autocomplete after backslash"		(source at: index ifPresent: [:c | c = $\] ifAbsent: [false]) ifTrue: [^ input].				^ input, complete].		^ input! !!PNode methodsFor: 'base accessing' stamp: 'tobe 4/16/2024 08:53'!addBaseChild: aNode at: aNumber	aNode baseParent ifNotNil: [aNode baseRemoveFromParent].	self baseChildren add: aNode beforeIndex: aNumber.	aNode baseParent: self! !!PNode methodsFor: 'as yet unclassified'!alias	^ nil! !!PNode methodsFor: 'queries' stamp: 'tobe 12/8/2025 20:14'!all: aCollection	^ Array streamContents: [:s | self allBlocksDo: [:b | (PQuery script: aCollection with: b) ifNotNil: [:res | s nextPut: res]]]! !!PNode methodsFor: 'queries' stamp: 'tobe 12/8/2025 20:14'!all: aCollection do: aBlock	(self allBlocksSelect: [:b | (PQuery script: aCollection with: b) notNil]) do: aBlock! !!PNode methodsFor: 'base accessing'!allBaseChildrenDo: aBlock	self baseChildren do: [:c | c allBaseChildrenDo: aBlock].	aBlock value: self! !!PNode methodsFor: 'base accessing'!allBaseChildrenExceptSelfDo: aBlock	self baseChildren do: [:c | c allBaseChildrenDo: aBlock]! !!PNode methodsFor: 'as yet unclassified'!allChildrenDetect: aBlock ifFound: aSuccessBlock ifNone: aFailBlock	self allChildrenDo: [:block | (aBlock value: block) ifTrue: [^ aSuccessBlock value: block]].	^ aFailBlock value! !!PNode methodsFor: 'hierarchy'!allDomainBlocksWithDepthDo: aBlock leafDo: anotherBlock depth: aNumber	self submorphs do: [:m | m allDomainBlocksWithDepthDo: aBlock leafDo: anotherBlock depth: aNumber + 1].	aBlock value: self value: aNumber! !!PNode methodsFor: 'hierarchy'!allParents	^ self allParentsUpTo: self rootBlock! !!PNode methodsFor: 'hierarchy'!allParentsUpTo: aBlock	| current parents |	self = aBlock ifTrue: [^ #()].		current := self parent.	parents := OrderedCollection new.		[		parents add: current.		current = aBlock ifTrue: [^ parents].		current := current parent] repeat! !!PNode methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 14:10'!allVisibleNodesDo: aBlock hidden: aCollection	(aCollection includes: self) ifFalse: [		self baseChildren do: [:c | c allVisibleNodesDo: aBlock hidden: aCollection].		aBlock value: self]! !!PNode methodsFor: 'base accessing' stamp: 'tobe 4/19/2024 18:18'!appendBaseChild: aNode	self addBaseChild: aNode at: self baseChildren size + 1! !!PNode methodsFor: 'as yet unclassified'!applyBlock	^ [:new :edit :undo | self applyEdit: edit source: new cursorAt: edit newEndByte undoDo: undo]! !!PNode methodsFor: 'as yet unclassified'!applyBlockWithCursor: aNumber	^ [:new :edit :undo | self applyEdit: edit source: new cursorAt: aNumber undoDo: undo]! !!PNode 