bol! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:40'!init: aBlock update: anotherBlock	self buildReplacement: [PReplacementPluggable new init: aBlock update: anotherBlock]! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'ct 12/9/2025 01:45'!init: aBlock update: anotherBlock delete: aThirdBlock	self buildReplacement: [PReplacementPluggable new init: aBlock update: anotherBlock delete: aThirdBlock]! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:09'!initialize	super initialize.		selectionInteraction := #skip.	deletionInteraction := #character! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:34'!model	^ model! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:03'!model: aModel	model := aModel! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:10'!name	^ name! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:10'!name: aString	name := aString! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:10'!query	^ query! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:10'!query: aQuery	query := aQuery! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:08'!selectionInteraction: aSymbol	selectionInteraction := aSymbol! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:08'!selectionInteractive	^ selectionInteraction! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 13:46'!validate	^ validate! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 13:46'!validate: aBlock	validate := aBlock! !!PWhitespaceParser class methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:23'!parse: aString old: aNode	| doc stream |	doc := PNode new		type: 'document';		language: self;		range: (PRange indexStart: 0 end: aString size);		privateSource: aString.		stream := aString readStream.	[stream atEnd] whileFalse: [ | c node type |		c := stream next.		node := PText new contents: ''.		type := #text.		c			caseOf: {				[Character tab] -> [					node contents: c asString.					type := #tab].				[Character cr] -> [					node contents: c asString.					type := #newline]}			otherwise: [[({Character tab. Character cr} includes: stream peek) or: [stream atEnd]] whileFalse: [node contents: node contents, stream next]].		node range: (PRange indexStart: stream position - node contents size end: stream position).		doc appendBaseChild: (PNode new			type: type;			language: self;			range: node range;			appendBaseChild: node)].		^ doc! !!PWhitespaceParser class methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:11'!rootRuleName	^ 'document'! !"Painting-Editor"!SystemOrganization addCategory: #'Painting-Watch'!Object subclass: #PTracer	instanceVariableNames: 'methods values'	classVariableNames: 'Current'	poolDictionaries: ''	category: 'Painting-Watch'!!Object methodsFor: '*Painting-Watch' stamp: 'ct 12/9/2025 01:26'!sbWatch	PTracer current ifNotNil: [:tracer |		tracer trace: self from: thisContext home sender].	^ self! !!Object methodsFor: '*Painting-Watch' stamp: 'ct 12/9/2025 01:25'!sbWatchWithId: id	PTracer current ifNotNil: [:tracer |		tracer trace: self withId: id from: thisContext sender].	^ self! !!PTracer class methodsFor: 'accessing' stamp: 'ct 7/7/2025 17:21'!current	^ Current! !!PTracer class methodsFor: 'accessing' stamp: 'ct 7/7/2025 18:36'!current: aTracerOrNil	Current := aTracerOrNil.! !!PTracer class methodsFor: 'accessing' stamp: 'ct 7/7/2025 17:23'!current: aTracer during: aBlock	| previous |	previous := self current.	Current := aTracer.	^ aBlock ensure:		[Current := previous]! !!PTracer class methodsFor: 'tracing' stamp: 'ct 7/7/2025 20:23'!disableTracingDuring: aBlock	^ self current: nil during: aBlock! !!PTracer class methodsFor: 'class initialization' stamp: 'ct 12/9/2025 02:18'!initialize	self current: self new.! !!PTracer class methodsFor: 'as yet unclassified' stamp: 'ct 12/9/2025 01:25'!test	| x y |	x := 1 sbWatchWithId: 1.	y := 2 sbWatchWithId: 2.	^ (x + y) sbWatchWithId: 3! !!PTracer class methodsFor: 'tracing' stamp: 'ct 7/7/2025 17:22'!trace: aBlock	| tracer |	tracer := self new.	self current: tracer during: aBlock.	^ tracer! !!PTracer methodsFor: 'initialize-release' stamp: 'ct 7/7/2025 17:29'!initialize	super initialize.	methods := Dictionary new.	values := Dictionary new.! !!PTracer methodsFor: 'accessing' stamp: 'ct 12/9/2025 01:41'!reset	methods removeAll.	values removeAll.! !!PTracer methodsFor: 'accessing' stamp: 'ct 12/9/2025 01:50'!trace: value from: aContext	self halt! !!PTracer methodsFor: 'accessing' stamp: 'ct 12/9/2025 01:48'!trace: value withId: id from: aContext	| method |	method := aContext homeMethod.	methods at: id ifPresent: [:existingMethod | existingMethod = method ifFalse: [self error: 'This trace id is already used for another method: ' , existingMethod]] ifAbsentPut: [method].	(values at: id ifAbsentPut: OrderedCollection new)		addLast: value.		self triggerEvent: #traced.! !!PTracer methodsFor: 'accessing' stamp: 'ct 12/9/2025 01:39'!valueForId: id ifPresent: presentBlock ifAbsent: absentBlock	^ self values		at: id		ifPresent: presentBlock		ifAbsent: absentBlock! !!PTracer methodsFor: 'accessing' stamp: 'ct 12/9/2025 01:39'!values	^ values! !"Painting-Watch"!aVariableUsageNode!!PSmalltalkParser methodsFor: 'visiting' stamp: 'demo 12/22/2025 18:29' prior: 39669643!visitVariableUsageNode: aVariableUsageNode	^ self visitVariableNode: (aVariableUsageNode instVarNamed: #variableNode)! !PEditorState example.!PEditorState example.!PEditorState example