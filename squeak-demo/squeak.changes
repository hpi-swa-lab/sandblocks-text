 ignoreOuterContext: ignoreOuterContext	^encoder sizePushFullClosure: compiledBlockLiteralIndex numCopied: numCopied receiverOnStack: rcvrOnStack ignoreOuterContext: ignoreOuterContext! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/22/2013 14:09'!pushLiteralVariable: aLiteral	| litIndex |	litIndex := encoder litIndexOrNilFor: aLiteral.	litIndex ifNil:		[litIndex := encoder litIndex: aLiteral].	^encoder sizePushLiteralVar: litIndex! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/14/2013 16:47'!pushLiteralVariableAtIndex: litIndex	^encoder sizePushLiteralVar: litIndex! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/23/2013 17:48'!pushNewArrayOfSize: numElements	^encoder sizePushNewArray: numElements! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/22/2013 13:20'!pushReceiver	^encoder sizePushReceiver! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/24/2013 11:40'!pushReceiverVariable: offsetOrName	| offset |	offset := offsetOrName isInteger				ifTrue: [offsetOrName]				ifFalse: [assembler offsetForInstVarName: offsetOrName].	"handle context inst var access"	^(assembler shouldUseLongAccessForInstVarOffset: offset)		ifTrue: [encoder sizePushInstVarLong: offset]		ifFalse: [encoder sizePushInstVar: offset]! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 3/22/2017 16:29'!pushRemoteInstanceVariable: tempIndex inObjectAt: InstVarIndex	"For symmetry with pop/storeIntoRemoteTemp:inVectorAt:."	^encoder sizePushRemoteInstanceVariable: tempIndex inObjectAt: InstVarIndex! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 2/23/2013 17:49'!pushRemoteTemp: remoteTempIndex inVectorAt: tempVectorIndex	^encoder sizePushRemoteTemp: remoteTempIndex inVectorAt: tempVectorIndex! !!BytecodeSizer methodsFor: 'assembly' stamp: 'eem 9/17/2021 11:43'!pushSpecialConstant: aLiteral	^(encoder sizePushSpecialLiteral: aLiteral)		ifNotNil: [:size| size]		ifNil: [encoder sizePushLiteral: (encoder litIndex: aLiteral)]! !!