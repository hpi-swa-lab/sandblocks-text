eInspectorClassTo: ContextVariablesInspector].	contextVariablesInspector object == newContext		ifFalse: [contextVariablesInspector object: newContext]		ifTrue: [contextVariablesInspector update]. "ct: this fixes missing context variable updates when stepping from non-top context"	self restoreContextVariablesInspectorState.	receiverInspector context: newContext.	receiverInspector object == self receiver		ifFalse: [receiverInspector inspect: self receiver]		ifTrue: [receiverInspector update].	self restoreReceiverInspectorState.		isNewMethod ifFalse:		[self changed: #contentsSelection]! !!Debugger methodsFor: 'private' stamp: 'ct 9/6/2025 00:04' prior: 37259140!contextStackIndex: anInteger oldContextWas: oldContext 	"Change the context stack index to anInteger, perhaps in response to user selection."	| isNewMethod newContext cviClass |	self saveReceiverInspectorState.	self saveContextVariablesInspectorState.	contextStackIndex := anInteger.	anInteger = 0 ifTrue:		[currentCompiledMethod := contents := nil.		 self changed: #contextStackIndex.		 self decorateButtons.		 self contentsChanged.		 contextVariablesInspector			changeInspectorClassTo: DebuggerProcessInspector;			object: self interruptedProcess.		 self restoreContextVariablesInspectorState.		 receiverInspector			context: nil;			inspectObject: self receiver.		 self restoreReceiverInspectorState.		 ^self].	isNewMethod := oldContext isNil		or: [oldContext home method ~= (currentCompiledMethod := self selectedContext home method)].	isNewMethod ifTrue:		[contents := self selectedMessage.		 self contentsChanged.		 self pcRange].	self changed: #contextStackIndex.	self decorateButtons.		newContext := self selectedContext.	cviClass := newContext contextVariablesInspectorClass.	(contextVariablesInspector isKindOf: cviClass) ifFalse:		[contextVariablesInspector			object: nil;			changeInspectorClassTo: cviClass].	contextVariablesInspector object == newContext		ifFalse: [contextVariablesInspector object: newContext]		ifTrue: [contextVariablesInspector update]. "ct: this fixes missing context variable updates when stepping from non-top context"	self restoreContextVariablesInspectorState.	receiverInspector context: newContext.	receiverInspector object == self receiver		ifFalse: [receiverInspector inspectCarefully: self receiver]		ifTrue: [receiverInspector update].	self restoreReceiverInspectorState.		isNewMethod ifFalse:		[self changed: #contentsSelection]! !!Debugger methodsFor: 'private' stamp: 'eem 9/20/2024 13:05' prior: 25457452!newStack: stack	| oldStack diff matchIndex |	oldStack := contextStack.	contextStack := stack.	(oldStack isNil or: [oldStack last ~~ stack last or: [oldStack first ~~ stack first]]) ifTrue:		[contextStackList := stack collect: [:ctx | ctx printString].		 ^self].	"May be able to re-use some of previous list"	diff := stack size - oldStack size.	contextStackList := diff <= 0		ifTrue: [contextStackList copyFrom: 1 - diff to: oldStack size]		ifFalse:			[matchIndex := stack lastIndexOf: oldStack first startingAt: diff + 1.			 matchIndex = 0				ifTrue: [contextStack collect: [:ctx | ctx printString]]				ifFalse: [((contextStack first: matchIndex - 1) collect: [:ctx| ctx printString]), contextStackList]]						"#(d e f h i) => #(a b c d e f g h i)						diff := 3.						matchIndex := 4.						#(a b c d e f g h i) := #(a b c), #(d e f h i)"! !!Debugger methodsFor: 'private' stamp: 'ct 5/12/2025 19:15' prior: 25465670!selectedContext	^ self hasContextSelected		ifFalse: [contextStack first]		ifTrue: [contextStack at: self contextStackIndex]! !!Debugger methodsFor: 'private' stamp: 'ct 9/5/2025 02:38'!tryPrint: printBlock errorMessage: errorMessage	^ printBlock on: Error do: [:ex |		self receiverInspector emphasizeError:			('{1}: {2}. {3} to debug the error.' translated asText format:				{errorMessage value.				ex description.				Text string: 'Click here' translated attributes: