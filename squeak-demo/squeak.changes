 !!VariableUsageNode methodsFor: 'testing' stamp: 'eem 6/28/2024 15:23'!isUnusedTemp	Usage ifNotNil: [Usage add: #isUnusedTemp].	^variableNode isUnusedTemp! !!VariableUsageNode methodsFor: 'testing' stamp: 'eem 6/28/2024 15:23'!isVariableNode	Usage ifNotNil: [Usage add: #isVariableNode].	^variableNode isVariableNode! !!VariableUsageNode methodsFor: 'testing' stamp: 'eem 07/12/2024 12:07'!isVariableReference	^variableNode isVariableReference! !!VariableUsageNode methodsFor: 'testing' stamp: 'eem 7/11/2024 16:35'!isVariableUsage	^true! !!VariableUsageNode methodsFor: 'testing' stamp: 'eem 07/12/2024 12:07'!nowHasDef  "Ignored in all but VariableNode"	^variableNode nowHasDef ! !!VariableUsageNode methodsFor: 'testing' stamp: 'eem 07/12/2024 12:07'!nowHasRef  "Ignored in all but VariableNode"	^variableNode nowHasRef ! !!VariableUsageNode methodsFor: 'testing' stamp: 'eem 6/28/2024 15:23'!scope	Usage ifNotNil: [Usage add: #scope].	^variableNode scope! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!code	^variableNode code! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!emitCodeForBlockValue: stack encoder: encoder	^variableNode emitCodeForBlockValue: stack encoder: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!emitCodeForEffect: stack encoder: encoder	pc := encoder nextPC.	^variableNode emitCodeForEffect: stack encoder: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!emitCodeForLoad: stack forValue: forValue encoder: encoder	pc := encoder nextPC.	^variableNode emitCodeForLoad: stack forValue: forValue encoder: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!emitCodeForReturn: stack encoder: encoder	^variableNode emitCodeForReturn: stack encoder: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 7/12/2024 13:39'!emitCodeForStore: stack encoder: encoder	"Don't assign the pc here, because this will shadow the pc for the assignment,	 and the debugger shows the assigned expression, not the target variable."	^variableNode emitCodeForStore: stack encoder: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 7/12/2024 13:39'!emitCodeForStorePop: stack encoder: encoder	"Don't assign the pc here, because this will shadow the pc for the assignment,	 and the debugger shows the assigned expression, not the target variable."	^variableNode emitCodeForStorePop: stack encoder: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!emitCodeForValue: stack encoder: encoder	pc := encoder nextPC.	^variableNode emitCodeForValue: stack encoder: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 7/11/2024 14:24'!resetFromCopy: node	Usage ifNotNil: [Usage add: #resetFromCopy:].	^variableNode resetFromCopy: node realNode! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!sizeCodeForBlockValue: encoder	^variableNode sizeCodeForBlockValue: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!sizeCodeForEffect: encoder	^variableNode sizeCodeForEffect: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!sizeCodeForLoad: encoder forValue: forValue	^variableNode sizeCodeForLoad: encoder forValue: forValue! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!sizeCodeForReturn: encoder	^variableNode sizeCodeForReturn: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!sizeCodeForStore: encoder	^variableNode sizeCodeForStore: encoder! !!VariableUsageNode methodsFor: 'code generation' stamp: 'eem 07/12/2024 12:07'!sizeCodeForStorePop: encoder	^variableNode sizeCodeForStorePop: encoder! !!VariableUsageNode methodsFor: 'code 