;		init: [:node :replacement |				replacement color: (Color r: 0.25 g: 0.25 b: 0.25).				replacement layoutInset: 1 px.				replacement					addMorphBack: (replacement createShard extensions: {testExt});					addMorphBack: (TextMorph new						color: (Color r: 1 g: 1 b: 1);						lock;						hResizing: #shrinkWrap)]			update: [:node :replacement | | watchId updateWatch |				replacement setProperty: #node toValue: node.				replacement firstSubmorph nodes: {node baseChildren first}.				watchId := node baseChildren third contents asInteger.				updateWatch := [					replacement submorphs second contents: (PTracer current ifNil: ['(not watching)'] ifNotNil: [:tracer |						tracer							valueForId: watchId							ifPresent: [:value | value asArray printString]							ifAbsent: ['(not yet watched)']])].				updateWatch value.				PTracer current ifNotNil: [:tracer |					tracer when: #traced send: #value to: updateWatch.					replacement setProperty: #watchId toValue: watchId.					(replacement valueOfProperty: #watchTracerReceivers ifAbsentPut: [Dictionary new])						at: watchId						put: updateWatch]]			delete: [:node :replacement | | watchId |				watchId := replacement valueOfProperty: #watchId.				(replacement valueOfProperty: #watchTracerReceivers) removeKey: watchId]).		e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: 'test	3 + ((2 + 8) sbWatchWithId: 1664525).	1 to: 3 do: [:i | 12313432 + i].	'.		container := Morph new		addMorphBack: e rootShard;		layoutPolicy: TableLayout new;		color: (Color r: 1 g: 1 b: 1);		layoutInset: 4;		hResizing: #shrinkWrap;		vResizing: #shrinkWrap;		openInWindow.		e		when: #isPending		evaluate: [:is | container color: (is ifTrue: [Color r: 1 g: 0.6 b: 0.0] ifFalse: [Color r: 1 g: 1 b: 1])]! !!PEditorState methodsFor: 'changes' stamp: 'tobe 12/22/2025 17:08' prior: 35428815!applyChanges: aCollection force: aBoolean	| newSourceString pair oldSourceString editScripts oldModels |	newSourceString := (aCollection, pendingChanges) reversed		inject: sourceString		into: [:new :change | change applyTo: new].	oldSourceString := sourceString.	oldModels := models copy.		editScripts := oldModels collect: [:oldRoot | | newRoot |		newRoot := [oldRoot language parse: newSourceString old: oldRoot]			on: SyntaxErrorNotification			do: [^ false].				pair := PTrueDiff new compare: oldRoot to: newRoot.		pair first privateSource: newSourceString.		models at: oldRoot language put: pair first.		pair second].		aBoolean ifFalse: [		(self checkValidation: editScripts changes: aCollection) ifFalse: [			models := oldModels.			editScripts do: [:script | script undo].			models do: [:root | root privateSource: oldSourceString].			pendingChanges addAll: aCollection.			pendingChangesRevert addAll: (aCollection collect: [:change |				PChange					range: (change from to: change from + change insert size)					insert: (self sourceString copyFrom: change from + 1 to: change to)]).			self shards do: [:shard | shard applyRejectedChanges: aCollection].			self isPending: true.			^ false]].		self isPending: false.	pendingChanges := OrderedCollection new.	self basicSourceString: newSourceString.		self shards do: [:shard |		editScripts keysAndValuesDo: [:model :editScript | shard updateReplacementsFor: editScript root: (models at: model)].		shard updateText].		self evaluateCode.		^ true! !!PEditorState methodsFor: 'changes' stamp: 'tobe 12/22/2025 13:50'!checkValidation: editScripts changes: aCollection	validationBlocks do: [:b | (b value value: (models at: b key) value: aCollection value: (editScripts at: b key)) ifFalse: [^ false]].	shards do: [:shard | shard replacements do: [:r | r definition validate ifNotNil: [(r definition validate value: r) ifFalse: [^ false]]]].	^ true! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 18:06'!isPending: aBoolean	self triggerEvent: #isPending with: aBoolean! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 13:46'!validate	^ validate! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 13:46'!validate: aBlock	validate := aBlock! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 16:55' prior: 35378745!basicApplyChanges: aCollection editScript: aScript	(aCollection reject: [:change | change sourceShard = self]) do: [:change |		view handleEdit: [			view				selectInvisiblyFrom: (self adjustGlobalIndex: change from) + 1 to: (self adjustGlobalIndex: change to);				replaceSelectionWith: (change insert ifNil: [''])]]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 17:05'!copySelection: doCut	| string |	string := self allSelectedSourceString.	doCut ifFalse: [		string := string asString			copyWithRegex: '(?<=sbWatchWithId\:\s*)\d+\b'			matchesTranslatedUsing: [:match | match asNumber hashMultiply asString]].	Clipboard clipboardText: string.	doCut ifTrue: [		view replaceSelectionWith: view textMorph editor nullText.		view textEdited: view text]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 16:53' prior: 35461499!filterEvent: anEvent for: aMorph	(anEvent isMouse and: [anEvent isMouseMove and: [anEvent isDraggingEvent]]) ifTrue: [		anEvent wasHandled ifFalse: [ "capturing"			anEvent hand releaseMouseFocus.			^ anEvent]].		anEvent wasHandled ifTrue: [ "bubbling"		| containingReplacement containingTextMorph |		((anEvent isKeystroke and: [anEvent shiftPressed]) or: [anEvent isMouse and: [anEvent isDraggingEvent]]) ifFalse: [^ anEvent].		self replacements do: [:ea | | childTextMorph |			childTextMorph := ea firstSubmorph view.			(((self adjustLocalIndex: aMorph selectionInterval start) to: ((self adjustLocalIndex: aMorph selectionInterval stop))) includesAllOf: ((ea firstSubmorph range first + 1) to: (ea firstSubmorph range last))) ifTrue: [				childTextMorph selectFrom: 1 to: childTextMorph text size].			anEvent isDraggingEvent ifTrue: [				(((self adjustLocalIndex: aMorph selectionInterval start) - 1 to: ((self adjustLocalIndex: aMorph selectionInterval stop) + 1)) includesAnyOf: ((ea firstSubmorph range first + 1) to: (ea firstSubmorph range last))) ifFalse: [					childTextMorph selectFrom: childTextMorph selectionInterval start to: childTextMorph selectionInterval start - 1]]].		((containingReplacement := self owner) isKindOf: PReplacementPluggable) ifFalse: [^ anEvent].		containingTextMorph := containingReplacement owner.		^ anEvent].		anEvent isKeystroke ifFalse: [^ anEvent].	aMorph hasKeyboardFocus ifFalse: [^ anEvent].		(anEvent commandKeyPressed and: [#($c $x) includes: anEvent keyCharacter]) ifTrue: [		| containingReplacement |		((containingReplacement := self owner) isKindOf: PReplacementPluggable) ifTrue: [			| containingTextMorph containingShard |			containingTextMorph := containingReplacement owner.			containingShard := containingTextMorph owner owner owner.			^ containingShard filterEvent: anEvent for: aMorph].		self copySelection: anEvent keyCharacter = $x.		^ anEvent wasHandled: true].		"capturing"	(anEvent keyCharacter = Character arrowLeft and: [aMorph selectionInterval start <= 2]) ifTrue: [ | containingReplacement containingTextMorph containingShard index |		((containingReplacement := self owner) isKindOf: PReplacementPluggable) ifFalse: [^ anEvent].		containingTextMorph := containingReplacement owner.		containingShard := containingTextMorph owner owner owner.		anEvent hand newKeyboardFocus: containingTextMorph.		index := (containingShard adjustGlobalIndex: containingReplacement range first) - (1 - aMorph selectionInterval start).		aMorph selectFrom: 1 to: (anEvent shiftPressed ifFalse: [0] ifTrue: [aMorph selectionInterval stop]).		containingTextMorph selectFrom: ((anEvent shiftPressed and: [containingTextMorph selectionInterval notEmpty]) ifFalse: [index] ifTrue: [containingTextMorph selectionInterval stop + 1]) to: index - 1.		^ anEvent wasHandled: true].	(anEvent keyCharacter = Character arrowRight and: [aMorph selectionInterval stop >= (aMorph text size - 1)]) ifTrue: [ | containingReplacement containingTextMorph index |		((containingReplacement := self owner) isKindOf: PReplacementPluggable) ifFalse: [^ anEvent].		containingTextMorph := containingReplacement owner.		anEvent hand newKeyboardFocus: containingTextMorph.		index := containingReplacement range first + 2.		aMorph selectFrom: (anEvent shiftPressed ifFalse: [aMorph text size] ifTrue: [aMorph selectionInterval start]) to: (anEvent shiftPressed ifFalse: [aMorph text size - 1] ifTrue: [aMorph text size]).		containingTextMorph selectFrom: ((anEvent shiftPressed and: [containingTextMorph selectionInterval notEmpty]) ifFalse: [index] ifTrue: [containingTextMorph selectionInterval start]) to: index - 1.		^ anEvent wasHandled: true].	anEvent keyCharacter = Character arrowLeft ifTrue: [		1 to: 0 by: -1 do: [:i |			| index |			index := aMorph selectionInterval start - 1 - i.			(aMorph text attributesAt: index)				detect: [:ea | ea anchoredMorph isKindOf: PReplacementPluggable]				ifFound: [:ea | | childShard |					childShard := ea anchoredMorph firstSubmorph.					anEvent hand newKeyboardFocus: childShard view.					aMorph selectFrom: (anEvent shiftPressed ifFalse: [index] ifTrue: [aMorph selectionInterval stop + 1]) to: (anEvent shiftPressed ifFalse: [index - 1] ifTrue: [index]).					childShard view selectFrom: childShard view text size - (1 - i) + 1 to: childShard view text size - (1 - i).					^ anEvent wasHandled: true]]].	anEvent keyCharacter = Character arrowRight ifTrue: [		1 to: 0 by: -1 do: [:i |			| index |			index := aMorph selectionInterval stop + 1 + i.			(aMorph text attributesAt: index)				detect: [:ea | ea anchoredMorph isKindOf: PReplacementPluggable]				ifFound: [:ea | | childShard |					childShard := ea anchoredMorph firstSubmorph.					anEvent hand newKeyboardFocus: childShard view.					aMorph selectFrom: (anEvent shiftPressed ifFalse: [index] ifTrue: [aMorph selectionInterval start]) to: (anEvent shiftPressed ifFalse: [index - 1] ifTrue: [index - 1]).					childShard view selectFrom: (1 - i) + 1 to: 1 - i.					^ anEvent wasHandled: true]]].		^ anEvent! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 18:15' prior: 35383868!onChange: aNewString	| change |	change := self		findChange: lastActualSourceString		b: aNewString string		preferredPos: self editor selectionRange first		preferredSide: nil.		((change includesKey: #delete) and: [(change at: #delete) = Character startOfHeader asString])		ifTrue: [ | replacement |			replacement := self replacementForStartIndex: (self adjustLocalIndex: (change at: #from) - 1).			self editor applyChanges: {				(PChange range: (replacement range last - 1 to: replacement range last) insert: '')					sourceShard: self;					sideAffinity: ((change at: #from) = 1 ifTrue: [1] ifFalse: [-1])}]		ifFalse: [ | string |			string := (change at: #insert ifAbsent: ['']) string.			self assert: [(string includes: Character startOfHeader) not].			self editor applyChanges: {				(PChange					range: ((self adjustLocalIndex: (change at: #from) - 1) to: (self adjustLocalIndex: (change at: #to) - 1))					insert: string)					sourceShard: self;					sideAffinity: ((self isShowingIndex: (change at: #from) - 1) ifTrue: [-1] ifFalse: [1])}]! !!PShard methodsFor: 'replacements' stamp: 'tobe 12/22/2025 13:24' prior: 35385942!uninstallReplacement: aReplacement	aReplacement beforeUninstall.		replacements remove: aReplacement.		aReplacement delete! !!PShard methodsFor: 'replacements' stamp: 'tobe 12/22/2025 13:39' prior: 35386115!updateReplacementsFor: anEditScript root: aRoot	anEditScript removeDo: [:op |		self replacements detect: [:r | op node = r node] ifFound: [:r |			self uninstallReplacement: r].		attributes do: [:attr | op node = attr node ifTrue: [attr definition detach value: self value: op node value: attr]]].		extensions value do: [:ext |		(ext replacementDefinitions select: [:def | def model = aRoot language]) do: [:def |			self				allVisibleNodesDo: [:node | | matches |					matches := (PQuery script: def query with: node) notNil.					self replacements						detect: [:r | r definition name = def name and: [node = r node]]						ifFound: [:r | matches ifFalse: [self uninstallReplacement: r]]						ifNone: [matches ifTrue: [self installReplacement: def for: node]]]				root: aRoot]].		extensions value do: [:ext |		(ext markerDefinitions select: [:def | def model = aRoot language]) do: [:def |			self				allVisibleNodesDo: [:node | | matches |					matches := (PQuery script: def query with: node) notNil.					attributes						detect: [:attr | attr definition name = def name and: [node = attr node]]						ifFound: [:attr | matches ifFalse: [def detach value: self value: node value: attr]]						ifNone: [matches ifTrue: [def attach value: self value: node]]]				root: aRoot]]! !PShard removeSelector: #copySelection!"Painting-Editor"!----SNAPSHOT----{22 December 2025 . 10:07:39 pm} Squeak6.0-22148-64bit.image priorSource: 1916445!PEditorState example!PEditorState example!PEditorState example!----QUIT----{22 December 2025 . 10:09:35 pm} Squeak6.0-22148-64bit.image priorSource: 1931271!