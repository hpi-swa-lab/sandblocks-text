rue ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64781237!navigatorOnLeftEdge	^ self		valueOfFlag: #navigatorOnLeftEdge		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64781377!noviceMode	^ self		valueOfFlag: #noviceMode		ifAbsent: [ false ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64781500!okToReinitializeFlaps	^ self		valueOfFlag: #okToReinitializeFlaps		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64781644!oliveHandleForScriptedObjects	^ self		valueOfFlag: #oliveHandleForScriptedObjects		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64782772!propertySheetFromHalo	^ self		valueOfFlag: #propertySheetFromHalo		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64784277!selectiveHalos	^ self		valueOfFlag: #selectiveHalos		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64784721!showAdvancedNavigatorButtons	^ self		valueOfFlag: #showAdvancedNavigatorButtons		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64785511!showFlapsWhenPublishing	^ self		valueOfFlag: #showFlapsWhenPublishing		ifAbsent: [ false ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64786558!simpleMenus	^ self		valueOfFlag: #simpleMenus		ifAbsent: [ false ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64787854!tabAmongFields	^ self		valueOfFlag: #tabAmongFields		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64787984!tileTranslucentDrag	^ self		valueOfFlag: #tileTranslucentDrag		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64788814!typeCheckingInTileScripting	^ self		valueOfFlag: #typeCheckingInTileScripting		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64789109!uniTilesClassic	^ self		valueOfFlag: #uniTilesClassic		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64789241!universalTiles	^ self		valueOfFlag: #universalTiles		ifAbsent: [false]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64789370!unlimitedPaintArea	^ self		valueOfFlag: #unlimitedPaintArea		ifAbsent: [ false ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64789805!useVectorVocabulary	^ self		valueOfFlag: #useVectorVocabulary		ifAbsent: [ false ]! !!Preferences class methodsFor: '*Etoys-standard queries' prior: 64789946!viewersInFlaps	^ self		valueOfFlag: #viewersInFlaps		ifAbsent: [ true ]! !!Preferences class methodsFor: '*Etoys-prefs - fonts' stamp: 'tween 8/7/2007 02:00' prior: 64805588!chooseEToysFont	"present a menu with the possible fonts for the eToys"	self		chooseFontWithPrompt: 'eToys font...' translated		andSendTo: self		withSelector: #setEToysFontTo:		highlightSelector: #standardEToysFont! !!Preferences class methodsFor: '*Etoys-prefs - fonts' stamp: 'tween 8/7/2007 02:00' prior: 64806910!chooseEToysTitleFont	"present a menu with the possible fonts for the eToys"	self		chooseFontWithPrompt: 'eToys Title font...' translated		andSendTo: self		withSelector: #setEToysTitleFontTo:		highlightSelector: #standardEToysTitleFont! !!Preferences class methodsFor: '*Etoys-prefs - fonts' stamp: 'mt 12/30/2021 13:16' prior: 64871175!setEToysFontTo: aFont 	"change the font used in eToys environment"	UserInterfaceTheme setFont: #eToysFont to: aFont.! !!Preferences class methodsFor: '*Etoys-prefs - fonts' stamp: 'mt 12/30/2021 13:16' prior: 64872258!setEToysTitleFontTo: aFont 	"change the font used in eToys environment"	UserInterfaceTheme setFont: #eToysTitleFont to: aFont.! !!Preferences class methodsFor: '*Etoys-prefs - fonts' stamp: 'mt 7/25/2016 15:11' prior: 64892053!s