sformationMorph	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Morphic-Basic'!!TransformationMorph methodsFor: 'geometry' stamp: 'ct 9/13/2022 12:07' prior: 118329723!extent: newExtent	"Optimization (see super). ct: Currently also used as a backstop to avoid layout divergence for odd extents caused by rounding errors for the bounds. In the future, we might want to try to remember the precise bounds in the receiver. See: http://lists.squeakfoundation.org/pipermail/squeak-dev/2022-August/221968.html"	self extent = newExtent ifTrue: [^ self].			self renderedMorph == self		ifTrue: [super extent: newExtent]		ifFalse: [			self adjustAfter: [				| scaleFactor |				scaleFactor := (self scale * newExtent r / self fullBounds extent r) max: 0.1.				self scale: (scaleFactor detentBy: 0.1 atMultiplesOf: 1.0 snap: false)]].! !!TransformationMorph methodsFor: 'stepping' stamp: 'mdr 10/3/2000 11:28' prior: 118345393!stepTime	"Answer the stepTime of my rendered morph if posible"	| rendered |	rendered := self renderedMorph.	rendered = self ifTrue: [^super stepTime].	"Hack to avoid infinite recursion"	^rendered stepTime.	! !MorphicAlarm subclass: #StepMessage	instanceVariableNames: 'stepTime'	classVariableNames: ''	poolDictionaries: ''	category: 'Morphic-Events'!!StepMessage methodsFor: 'stepping' stamp: 'ar 10/22/2000 16:56' prior: 91188238!stepTime	"Return the step time for this message. If nil, the receiver of the message will be asked for its #stepTime."	^stepTime! !RectangleMorph subclass: #ZoomAndScrollControllerMorph	instanceVariableNames: 'mouseDownPoint mouseMovePoint panAndTiltFactor zoomFactor target hasFocus currentKeyDown upDownCodes changeKeysState programmedMoves'	classVariableNames: ''	poolDictionaries: ''	category: 'MorphicExtras-Demo'!!ZoomAndScrollControllerMorph methodsFor: 'stepping' stamp: 'RAA 12/18/2000 15:30' prior: 122045863!doProgrammedMoves	| thisMove startPoint endPoint startZoom endZoom newScale newPoint fractionLeft |	programmedMoves isEmptyOrNil ifTrue: [		^programmedMoves := nil	].	thisMove := programmedMoves first.	thisMove at: #pauseTime ifPresent: [ :ignore | ^self].	fractionLeft := self fractionLeftInMove: thisMove.	fractionLeft ifNil: [^programmedMoves := programmedMoves allButFirst].	startPoint := thisMove at: #startPoint ifAbsentPut: [self cameraPoint].	endPoint := thisMove at: #endPoint ifAbsentPut: [self cameraPoint].	startZoom := thisMove at: #startZoom ifAbsentPut: [self cameraScale].	endZoom := thisMove at: #endZoom ifAbsentPut: [self cameraScale].	newScale := endZoom - (endZoom - startZoom * fractionLeft).	newPoint := (endPoint - (endPoint - startPoint * fractionLeft)) "rounded".	target changeScaleTo: newScale.	target cameraPoint: newPoint.	fractionLeft <= 0 ifTrue: [^programmedMoves := programmedMoves allButFirst].! !!ZoomAndScrollControllerMorph methodsFor: 'stepping' stamp: 'kfr 5/17/2015 23:40' prior: 122049042!step	| delta halfDW shift |	shift := false.	(self valueOfProperty: #currentCameraVersion ifAbsent: [0]) = 							self currentCameraVersion ifFalse: [		self patchOldVersion1.		self setProperty: #currentCameraVersion toValue: self currentCameraVersion.	].	super step.	self doProgrammedMoves.	(currentKeyDown ifNil: [#()]) do: [ :each | | action | 		action := upDownCodes at: each ifAbsent: [shift := true]. 		action == #in ifTrue: [			target scaleImageBy: -10.		].		action == #out ifTrue: [			target scaleImageBy: 10.		].		action == #up ifTrue: [			target panImageBy: 0@ -20.		].		action == #down ifTrue: [			target panImageBy: 0@20.		].		action == #left ifTrue: [			target panImageBy: -20@0.		].		action == #right ifTrue: [			target panImageBy: 20@0.		].	].	mouseMovePoint ifNil: [^self].	mouseDownPoint ifNil: [^self].	target ifNil: [^self].	halfDW := self deadZoneWidth // 2.	halfDW := self deadZoneWidth // 2.	delta := mouseMovePoint - mouseDownPoint.	delta x abs <= halfDW ifTrue: [delta := 0@delta y].	delta y abs <= halfDW ifTrue: [delta := delta x@0].	shift ifTrue:[^target scaleImageBy: delta x].	target panImageBy: delta x @ delta y! !!ZoomAndScrollControllerMorph methodsFor: 'stepping' stamp: 'RAA 12/1/2000 15:28' prior: 122050465!stepTime	^10! !Object subclass: #ChessBoard	instanceVariableNames: 'whitePlayer blackPlayer activePlayer userAgent searchAgent generator hashKey hashLock'	classVariableNames: 'HashKeys HashLocks'	poolDictionaries: ''	category: 'MorphicExtras-Games-Chess'!!ChessBoard methodsFor: 'accessing' stamp: 'ar 8/8/2001 23:02' prior: 21439991!activePlayer	^activePlayer! !!ChessBoard methodsFor: 'accessing' stamp: 'ar 8/8/2001 22:41' prior: 21440087!blackPlayer	^blackPlayer! !!ChessBoard methodsFor: 'accessing' stamp: 'ar 8/10/2001 06:15' prior: 21440182!generator	^generator! !!ChessBoard methodsFor: 'accessing' stamp: 'ar 8/12/2001 21:04' prior: 21440273!searchAgent	^searchAgent! !!ChessBoard methodsFor: 'accessing' stamp: 'ar 8/12/2001 21:04' prior: 21440368!searchAgent: anAgent	searchAgent := anAgent.! !!ChessBoard methodsFor: 'accessing' stamp: 'ar 8/12/2001 22:53' prior: 21440483!statusString	^searchAgent statusString! !!ChessBoard methodsFor: 'accessing' stamp: 'ar 8/9/2001 03:49' prior: 21440591!userAgent	^userAgent! !!ChessBoard methodsFor: 'accessing' stamp: 'ar 8/24/2001 18:19' prior: 21440682!userAgent: anObject	userAgent := anObject.! !!ChessBoard methodsFor: 'accessing' stamp: 'ar 8/8/2001 22:41' prior: 21440794!whitePlayer	^whitePlayer! !!ChessBoard methodsFor: 'copying' stamp: 'aoy 2/17/2003 01:15' prior: 21440889!copyBoard: aBoard 	"Copy all volatile state from the given board"	whitePlayer copyPlayer: aBoard whitePlayer.	blackPlayer copyPlayer: aBoard blackPlayer.	activePlayer := aBoard activePlayer isWhitePlayer 				ifTrue: [whitePlayer]				ifFalse: [blackPlayer]. 	hashKey := aBoard hashKey.	hashLock := aBoard hashLock.	userAgent := nil! !!ChessBoard methodsFor: 'copying' stamp: 'ar 8/9/2001 17:35' prior: 21441296!postCopy	whitePlayer == activePlayer ifTrue:[		whitePlayer := whitePlayer copy.		blackPlayer := blackPlayer copy.		activePlayer := whitePlayer.	] ifFalse:[		whitePlayer := whitePlayer copy.		blackPlayer := blackPlayer copy.		activePlayer := blackPlayer.	].	whitePlayer opponent: blackPlayer.	blackPlayer opponent: whitePlayer.	whitePlayer board: self.	blackPlayer board: self.	self userAgent: nil.! !!ChessBoard methodsFor: 'hashing' stamp: 'ar 8/9/2001 23:45' prior: 21441775!hashKey	^hashKey! !!ChessBoard methodsFor: 'hashing' stamp: 'ar 8/9/2001 23:45' prior: 21441859!hashLock	^hashLock! !!ChessBoard methodsFor: 'hashing' stamp: 'aoy 2/17/2003 01:17' prior: 21441947!updateHash: piece at: square from: player 	| index |	index := player == whitePlayer ifTrue: [piece] ifFalse: [piece + 6].	hashKey := hashKey bitXor: ((HashKeys at: index) at: square). 	hashLock := hashLock bitXor: ((HashLocks at: index) at: square)! !!ChessBoard methodsFor: 'initialize' stamp: 'ar 8/24/2001 18:04' prior: 21442271!initialize	generator ifNil:[generator := ChessMoveGenerator new initialize].	searchAgent ifNil:[searchAgent := ChessPlayerAI new initialize].	self resetGame.! !!ChessBoard methodsFor: 'initialize' stamp: 'ar 8/9/2001 03:50' prior: 21442502!initializeNewBoard	self resetGame.	whitePlayer addWhitePieces.	blackPlayer addBlackPieces.! !!ChessBoard methodsFor: 'initialize' stamp: 'ar 8/24/2001 18:19' prior: 21442667!resetGame	hashKey := hashLock := 0.	whitePlayer := ChessPlayer new initialize.	blackPlayer := ChessPlayer new initialize.	whitePlayer opponent: blackPlayer.	whitePlayer board: self.	blackPlayer opponent: whitePlayer.	blackPlayer board: self.	activePlayer := whitePlayer.	searchAgent reset: self.	userAgent ifNotNil:[userAgent gameReset].! !!ChessBoard methodsFor: 'moving' stamp: 'spfa 6/1/2020 23:36' prior: 21443442!movePieceFrom: sourceSquare to: destSquare	| move |	searchAgent isThinking ifTrue:[^self].	move := (activePlayer findPossibleMovesAt: sourceSquare) contents		detect:[:any| any destinationSquare = destSquare						or: [(any triggerSquareIn: self) = destSquare]].	self nextMove: move.	searchAgent activePlayer: activePlayer.! !!ChessBoard methodsFor: 'moving' stamp: 'aoy 2/17/2003 01:16' prior: 21443838!nextMove: aMove 	activePlayer applyMove: aMove.	userAgent 		ifNotNil: [userAgent completedMove: aMove white: activePlayer isWhitePlayer].	activePlayer := activePlayer == whitePlayer 				ifTrue: [blackPlayer]				ifFalse: [whitePlayer].	activePlayer prepareNextMove ! !!ChessBoard methodsFor: 'moving' stamp: 'aoy 2/17/2003 01:16' prior: 21444177!nullMove	activePlayer := activePlayer == whitePlayer 				ifTrue: [blackPlayer]				ifFalse: [whitePlayer]. 	activePlayer prepareNextMove! !!ChessBoard methodsFor: 'moving' stamp: 'aoy 2/17/2003 01:17' prior: 21444384!undoMove: aMove 	activePlayer := activePlayer == whitePlayer 				ifTrue: [blackPlayer]				ifFalse: [whitePlayer]. 	activePlayer undoMove: aMove.	userAgent 		ifNotNil: [userAgent undoMove: aMove white: activePlayer isWhitePlayer]! !!ChessBoard methodsFor: 'printing' stamp: 'ar 8/24/2001 18:25' prior: 21444688!printOn: aStream	super printOn: aStream.	aStream 		nextPut: $(;		print: hashKey; space; print: hashLock;		nextPut: $).! !!ChessBoard commentStamp: '<historical>' prior: 0!This class represents the chess board itself.!ChessBoard class	instanceVariableNames: ''!!ChessBoard class methodsFor: 'class initialization' stamp: 'ar 8/9/2001 23:44' prior: 21445002!initialize	"ChessGame initialize"	self initializeHashKeys.! !!ChessBoard class methodsFor: 'class initialization' stamp: 'nice 9/1/2016 00:08' prior: 21445151!initializeHashKeys	"ChessGame initialize"	| random |	HashKeys := Array new: 12.	1 to: HashKeys size do:[:i| HashKeys at: i put: (WordArray new: 64)].	HashLocks := Array new: 12.	1 to: HashLocks size do:[:i| HashLocks at: i put: (WordArray new: 64)].	random := Random seed: 23648646.	1 to: 12 do:[:i|		1 to: 64 do:[:j|			(HashKeys at: i) at: j put: (random nextInt: 16r3FFFFFFF "SmallInteger maxVal on 32bits VM")- 1. 			(HashLocks at: i) at: j put: (random nextInt: 16r3FFFFFFF "SmallInteger maxVal on 32bits VM") - 1.		].	].! !FullVocabulary subclass: #ScreenedVocabulary	instanceVariableNames: 'methodScreeningBlock categoryScreeningBlock'	classVariableNames: ''	poolDictionaries: ''	category: 'Protocols-Kernel'!!ScreenedVocabulary methodsFor: 'enumeration' stamp: 'ct 11/19/2024 03:35'!allSelectorsInCategory: categoryName forInstance: anObject ofClass: aClass	"Answer a list of all selectors in the vocabulary which are in the given category, on behalf of the given class and object"	^ (super allSelectorsInCategory: categoryName forInstance: anObject ofClass: aClass) select:		[:aSelector | self includesSelector: aSelector]! !FileStream class	instanceVariableNames: ''!!FileStream class methodsFor: 'file reader services' stamp: 'eem 7/13/2022 12:42'!changes	^'changes' shallowCopy! !!FileStream class methodsFor: 'file reader services' stamp: 'eem 7/13/2022 12:43' prior: 29272943!sourceFileSuffixes	^ {FileStream st. FileStream sources. FileStream changes. FileStream cs. FileStream multiSt. FileStream multiCs} asSet asArray! !!FileStream class methodsFor: 'instance creation' stamp: 'cmm 7/24/2025 19:24' prior: 29277334!detectFile: aBlockOrFileStream do: anotherBlock	^aBlockOrFileStream value "Assume that FileStreams return self for #value."		ifNil: [ FileStreamException signal: 'file not detected' ]		ifNotNil: [ :file | [ anotherBlock value: file ] ensure: [ file close ] ]! !!FileStream class methodsFor: 'instance creation' stamp: 'cmm 7/24/2025 19:41' prior: 29278189!fileNamed: fileName do: aBlock	"Create or open the specified fileName and pass its FileStream to aBlock.  If fileName is unqualified, the file will be opened (if it exists) or created (if it doesn't exist) in the default FileDirectory.  If fileName is qualified, and the path to the file exists, it'll be opened (if the file exists) or created (if the file doesn't exist).  If the file can't be opened, signal an error."		^self detectFile: (self fileNamed: fileName) do: aBlock! !!FileStream class methodsFor: 'instance creation' stamp: 'cmm 4/28/2024 19:16' prior: 29279396!forceNewFileNamed: fileName do: aBlock 	"Create a file named fileName and value aBlock with a ReadWriteStream on its contents, which is closed automatically upon completion of aBlock.  If the file identified by fileName already exists, it will be replaced.  If the file can't be created for any reason, signal an error."	^ (self forceNewFileNamed: fileName)		ifNil: [ self error: 'file not created' ]		ifNotNil: [ : fileStream | self detectFile: fileStream do: aBlock ]! !!FileStream class methodsFor: 'instance creation' stamp: 'cmm 4/28/2024 19:15' prior: 29280744!newFileNamed: fileName do: aBlock 	"Create a file named fileName and value aBlock with a ReadWriteStream on its contents, which is closed automatically upon completion of aBlock.  If the file identified by fileName already exists, signal an error.  If the file can't be created for any reason, signal an error."	^ (self newFileNamed: fileName)		ifNil: [ self error: 'file not created' ]		ifNotNil: [ : fileStream | self detectFile: fileStream do: aBlock ]! !!FileStream class methodsFor: 'instance creation' stamp: 'cmm 7/24/2025 19:52' prior: 29281746!oldFileNamed: fileName do: aBlock	"Open the specified fileName and pass its FileStream to aBlock.  If fileName is unqualified it must exist in the default FileDirectory.  If the file can't be opened, signal an error."		^self detectFile: (self oldFileNamed: fileName) do: aBlock! !!FileStream class methodsFor: 'instance creation' stamp: 'cmm 7/24/2025 19:54' prior: 29283557!readOnlyFileNamed: fileName do: aBlock	"Open the specified fileName in read-only mode, and pass its FileStream to aBlock.  If fileName is unqualified it must exist in the default FileDirectory.  If the file doesn't exist, signal a FileDoesNotExistException.  If it exists but can't be opened, signal a FileStreamException."		^self detectFile: (self readOnlyFileNamed: fileName) do: aBlock! !Morph subclass: #KedamaPatchMorph	instanceVariableNames: 'form displayMax shiftAmount useLogDisplay displayForm diffusionRate scaledEvaporationRate sniffRange formChanged tmpForm autoChanged displayType changePending kedamaWorld'	classVariableNames: ''	poolDictionaries: ''	category: 'Etoys-StarSqueak'!!KedamaPatchMorph methodsFor: 'commands and slots' stamp: 'yo 10/13/2005 11:40' prior: 51004336!setPixelsPredicates: predicates xArray: xArray yArray: yArray value: value	form bits class == ByteArray ifTrue: [form unhibernate].	self primSetPixelsPredicates: predicates xArray: xArray yArray: yArray bits: form bits width: form width height: form height value: value.	self formChanged.! !!KedamaPatchMorph methodsFor: 'private' stamp: 'yo 11/16/2006 17:47' prior: 51003583!migrateInstancesWithoutChangePending	self instVarNamed: 'changePending' put: false.! !!KedamaPatchMorph methodsFor: 'drawing' stamp: 'yo 11/16/2006 12:25' prior: 51003262!drawRequest	changePending ifFalse: [self changed].	changePending := true.! !!KedamaPatchMorph methodsFor: 'initialization' stamp: 'tfel 8/9/2016 14:04' prior: 51003440!kedamaWorld: anObject	kedamaWorld := anObject.! !!KedamaPatchMorph methodsFor: 'primitives' stamp: 'yo 1/20/2006 14:00' prior: 51003765!primSetPixelsPredicates: predicates xArray: xArray yArray: yArray bits: bits width: width height: height value: value	| v |	<primitive: 'primSetPixelsAtXY' module: 'KedamaPlugin2'>"	^ KedamaPlugin2 doPrimitive: #primSetPixelsAtXY."	value isNumber ifTrue: [v := value].	1 to: xArray size do: [:i |		(predicates at: i) = 1 ifTrue: [			value isNumber ifFalse: [				v := value at: i.			].					self pixelAtX: (xArray at: i) y: (yArray at: i) put: v.		].	].! !KedamaPatchMorph class	instanceVariableNames: ''!!KedamaPatchMorph class methodsFor: 'class initialization' stamp: 'yo 11/16/2006 17:47' prior: 51010413!migrateInstancesWithoutChangePending	KedamaPatchMorph allInstancesDo: [:each |		each migrateInstancesWithoutChangePending.	].! !TestCase subclass: #YearMonthWeekTest	instanceVariableNames: 'restoredStartDay restoredTimeZone localTimeZonePreferenceToRestore'	classVariableNames: ''	poolDictionaries: ''	category: 'Chronology-Tests'!!YearMonthWeekTest methodsFor: 'running' stamp: 'dtl 6/15/2023 22:20' prior: 121857966!setUp	restoredStartDay := Week startDay.	restoredTimeZone := DateAndTime localTimeZone.	localTimeZonePreferenceToRestore := DateAndTime automaticTimezone.	Week startDay: #Sunday.	DateAndTime localTimeZone: (FixedTimeZone timeZones detect: [:tz | tz abbreviation = 'GMT']).! !ClassTestCase subclass: #LinkedListTest	instanceVariableNames: 'nextLink n list link1 link2 link3 link4 nonEmpty otherList link collectionWithNil collectionWithoutNil nonEmpty1Element collectionWithoutEqualElements elementNotIn elementIn sameAtendAndBegining collection5Elements collectResult'	classVariableNames: ''	poolDictionaries: ''	category: 'CollectionsTests-Sequenceable'!!LinkedListTest methodsFor: 'tests - copying with replacement' stamp: 'ul 8/14/2023 23:39' prior: 52099152!firstIndexesOf: aSubCollection in: collection" return an OrderedCollection with the first indexes of the occurrences of subCollection in  collection "	| tmp result currentIndex |	tmp:= collection.	result:= OrderedCollection new.	currentIndex := 1.		[tmp isEmpty ]whileFalse:		[		(tmp beginsWith: aSubCollection)			ifTrue: [ 					result add: currentIndex.				1 to: aSubCollection size do: 					[:i | 					tmp := tmp allButFirst.					currentIndex := currentIndex + 1]				]			ifFalse: [				tmp := tmp allButFirst.				currentIndex := currentIndex +1.				]		 ].		^ result.	! !!LinkedListTest methodsFor: 'tests - fixture' stamp: 'ul 8/14/2023 23:39' prior: 52103685!howMany: aSubCollection in: collection" return an integer representing how many time 'subCollection'  appears in 'collection'  "	| tmp nTime |	tmp := collection.	nTime:= 0.		[tmp isEmpty ]whileFalse:		[		(tmp beginsWith: aSubCollection)			ifTrue: [ 					nTime := nTime + 1.				1 to: aSubCollection size do: [:i | tmp := tmp allButFirst.]				]			ifFalse: [tmp := tmp allButFirst.]		 ].		^ nTime.	! !!LinkedListTest methodsFor: 'tests - subcollections access' stamp: 'ul 10/7/2023 10:18' prior: 52119155!testAllButFirst	"self debug: #testAllButFirst"	| abf col |	col := self moreThan3Elements.	abf := col allButFirst.	self deny: abf first = col first.	self assert: abf size + 1 = col size.	1 to: abf size do: [ :i |		self assert: (abf at: i) = (col at: i + 1) ]! !!LinkedListTest methodsFor: 'tests - comma and delimiter' stamp: 'ct 6/13/2023 22:38' prior: 52141083!testAsCommaStringMore	"self assert: self oneTwoThreeItemCol asCommaString = '1, 2, 3'.	self assert: self oneTwoThreeItemCol asCommaStringAnd = '1, 2, and 3'"	| result resultAnd index allElementsAsString |	result:= self nonEmpty asCommaString .	resultAnd:= self nonEmpty asCommaStringAnd . 	index := 1.	(result findBetweenSubStrs: ',' )do:		[:each |		index = 1			ifTrue: [self assert: each= ((self nonEmpty at:index)asString)]			ifFalse: [self assert: each= (' ',(self nonEmpty at:index) asString)].		index:=index+1		].		"verifying resultAnd :"	allElementsAsString:=(resultAnd findBetweenSubStrs: ',' ).	1 to: allElementsAsString size do:		[:i | 		i<(allElementsAsString size )			ifTrue: [			i = 1				ifTrue:[self assert: (allElementsAsString at:i)=((self nonEmpty at:i) asString)]				ifFalse:[self assert: (allElementsAsString at:i)=(' ',(self nonEmpty at:i) asString)]				].		i=(allElementsAsString size)			ifTrue:[ 			i = 1				ifTrue:[self assert: (allElementsAsString at:i)=( (self nonEmpty at:i ) asString ,' and ', (self nonEmpty at: ( i + 1) ) asString )]				ifFalse:[self assert: (allElementsAsString at:i)=( ' and ', (self nonEmpty at: i ) asString )]				].							].! !!LinkedListTest methodsFor: 'tests - begins ends with' stamp: 'ul 8/14/2023 23:38' prior: 52178684!testsEndsWith		self assert: (self nonEmpty endsWith: self nonEmpty allButFirst).	self assert: (self nonEmpty endsWith: self nonEmpty).	self deny: (self nonEmpty endsWith: (self nonEmpty copyWith: self nonEmpty first)).! !TestCase subclass: #HtmlReadWriterTest	instanceVariableNames: 'readWriter html text'	classVariableNames: ''	poolDictionaries: ''	category: 'CollectionsTests-Text'!!HtmlReadWriterTest methodsFor: 'running' stamp: 'ct 5/19/2023 21:38' prior: 32306892!setUp	super setUp.		self setUpReadWriter.	html := ''.	text := '' asText.! !!HtmlReadWriterTest methodsFor: 'running' stamp: 'ct 5/19/2023 21:39'!setUpReadWriter	^ readWriter := HtmlReadWriter new! !!HtmlReadWriterTest methodsFor: 'running' stamp: 'ct 5/19/2023 19:13'!testRead: pairs	pairs pairsDo: [:givenHtml :expectedText |		self testRead: givenHtml as: expectedText].! !!HtmlReadWriterTest methodsFor: 'running' stamp: 'ct 5/19/2023 19:12'!testRead: givenHtml as: expectedText	self convertHtml: givenHtml.	self assert: expectedText string equals: text string.	self assert: expectedText runs equals: text runs.! !!HtmlReadWriterTest methodsFor: 'running' stamp: 'ct 5/19/2023 19:14'!testReadAndWrite: pairs	pairs pairsDo: [:givenHtml :givenText |		self testRead: givenHtml as: givenText.		self testWrite: givenText as: givenHtml].! !!HtmlReadWriterTest methodsFor: 'running' stamp: 'ct 5/19/2023 19:13'!testWrite: givenText as: expectedHtml	self convertText: givenText.	self assert: expectedHtml equals: html.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 20:17' prior: 32307056!test01Emphasis	self testReadAndWrite: {		'<b>Hello, World!!</b>'.		'Hello, World!!' asText addAttribute: TextEmphasis bold.				'<b>Hello</b>, World!!'.				'Hello, World!!' asText addAttribute: TextEmphasis bold from: 1 to: 5.	}.		self testRead: {		'<B>Hello</b>, World!!'.				'Hello, World!!' asText addAttribute: TextEmphasis bold from: 1 to: 5.				'<b>Hello</B>, World!!'.				'Hello, World!!' asText addAttribute: TextEmphasis bold from: 1 to: 5.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 19:08' prior: 32308202!test02Mixed		self testReadAndWrite: {		'<b>Hello, </b><b><i>World!!</i></b>!!'.		'Hello, World!!!!' asText			addAttribute: TextEmphasis bold from: 1 to: 13;			addAttribute: TextEmphasis italic from: 8 to: 13.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/20/2023 15:44' prior: 32310418!test03FontTag	self testReadAndWrite: {		'<font color="#FFFF00">Hello, World!!</font>'.		'Hello, World!!' asText			addAttribute: (TextColor color: Color yellow).					'<font face="Accula" size="10.5">Hello, World!!</font>'.		'Hello, World!!' asText			addAttribute: (TextFontReference toFont: (StrikeFont familyName: 'Accula' pointSize: 10.5)).		"Note that we cannot directly use both face/size and color in the same font tag because of how #openHtmlOn: works in fonts. Works in general, but just not in this test setup."		'<font face="Accula" size="10.5"><font color="#FFFF00">Hello, World!!</font></font>'.		'Hello, World!!' asText			addAttribute: (TextFontReference toFont: (StrikeFont familyName: 'Accula' pointSize: 10.5));			addAttribute: (TextColor color: Color yellow).	}.		self testRead: {		'<fontcolor =		"re&#68;"  >Hello, World!!</font>'.		'Hello, World!!' asText			addAttribute: (TextColor color: Color red).				'<font color="re&#68;">Hello, World!!</font>'.		'Hello, World!!' asText			addAttribute: (TextColor color: Color red).				'<Font face=Accula size="10.5" color="#FFFF00">Hello, World!!</font>'.		'Hello, World!!' asText			addAttribute: (TextColor color: Color yellow);			addAttribute: (TextFontReference toFont: (StrikeFont familyName: 'Accula' pointSize: 10.5)).				'<font color="rgb(var(--r),1000,0)">Hello, World!!</span>'.		'Hello, World!!' asText.	}! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 21:27' prior: 32311528!test04LineBreaks	{		'Hello, World!!<br>'.		'Hello, World!!' asText.		'Hello, <b>World!!<br></b>'.		'Hello, World!!' asText			addAttribute: TextEmphasis bold from: 8 to: 14.				'Hello, <b>World<br>!!</b>'.		'Hello, World!!' asText			addAttribute: TextEmphasis bold from: 8 to: 14.	} pairsDo: [:givenHtml :givenText |				self testRead: givenHtml as: givenText.		self testWrite: givenText as: givenHtml.				self convertHtml: html.		self convertText: text.		self assert: givenHtml equals: html].		self testRead: {		'Hello<BR>World'.		'HelloWorld' asText	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 19:32' prior: 32312160!test05Escaping	self testReadAndWrite: {		'<b>Morph&gt;&gt;#drawOn:</b>'.		'Morph>>#drawOn:' asText addAttribute: TextEmphasis bold.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/20/2023 14:31' prior: 32313776!test08MultilineCode	self testReadAndWrite: { '<code><pre>3 + 7.3 &gt; 4.</pre></code>' .		Text string: '3 + 7.3 > 4.' runs: (RunArray runs: #(13) values: { {TextDoIt evalString: '3 + 7.3 > 4.' } } )	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 19:15' prior: 32314303!test09StruckOut	self testReadAndWrite: {		'<s>Hello, World!!</s>'.		'Hello, World!!' asText addAttribute: TextEmphasis struckOut.				'<s>Hello</s>, World!!'.				'Hello, World!!' asText addAttribute: TextEmphasis struckOut from: 1 to: 5.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 19:15' prior: 32314867!test10Underline	self testReadAndWrite: {		'<u>Hello, World!!</u>'.		'Hello, World!!' asText addAttribute: TextEmphasis underlined.				'<u>Hello</u>, World!!'.				'Hello, World!!' asText addAttribute: TextEmphasis underlined from: 1 to: 5.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 20:31' prior: 32315433!test11Alignment	self testReadAndWrite: {	"	'<center>Hello, World!!</center>'.		'Hello, World!!' asText addAttribute: TextAlignment centered."		'<div align=left>Hello, World!!</div>'.		'Hello, World!!' asText addAttribute: TextAlignment leftFlush.		'<div align=right>Hello, World!!</div>'.		'Hello, World!!' asText addAttribute: TextAlignment rightFlush.		'<div align=justify>Hello, World!!</div>'.		'Hello, World!!' asText addAttribute: TextAlignment justified.	}.		self testRead: {		'<DIV ALIGN=RIGHT>Hello, World!!</DIV>'.		'Hello, World!!' asText addAttribute: TextAlignment rightFlush.				'<div align="right">Hello, World!!</div>'.		'Hello, World!!' asText addAttribute: TextAlignment rightFlush.		'<div align = "justify">Hello, World!!</div>'.		'Hello, World!!' asText addAttribute: TextAlignment justified.				'<div align="c&#101;nter">Hello, World!!</div>'.		'Hello, World!!' asText addAttribute: TextAlignment centered.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 19:16' prior: 32316228!test12AlignmentMixed	self testReadAndWrite: {		'<center>Hello, <i>World!!</i></center>'.		'Hello, World!!' asText			addAttribute: TextAlignment centered;			addAttribute: TextEmphasis italic from: 8 to: 13.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 23:35' prior: 32316757!test13SpanTag	self testRead: {		'<span style="width: 100px;color:#FFFF00; font-style : bold; font-size: 10px">Hello, World!!</span>'.		'Hello, World!!' asText			addAttribute: (TextColor color: Color yellow);			addAttribute: TextEmphasis bold.				'<span style="width: 100px; incorrectly-empty-tag:; font-style: bold">Hello, World!!</span>'.		'Hello, World!!' asText			addAttribute: TextEmphasis bold.				'<span style="width: 100px; color:rgb(var(--r),1000,0); font-style: bold">Hello, World!!</span>'.		'Hello, World!!' asText			addAttribute: TextEmphasis bold.				'<span style="Color:R&#101;d">Hello, World!!</span>'.		'Hello, World!!' asText			addAttribute: (TextColor color: Color red).				'<span style="">Hello, World!!</span>'.		'Hello, World!!' asText.				'<span style=>Hello, World!!</span>'.		'Hello, World!!' asText.				'<span style>Hello, World!!</span>'.		'Hello, World!!' asText.				'<SPAN STYLE = "font-style: bold">Hello, World!!</SPAN>'.		'Hello, World!!' asText			addAttribute: TextEmphasis bold.	}! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 19:32' prior: 32317252!test14NumericalHtmlEntities	self testRead: {		'&#46;&#x00021;'.		'.!!' asText.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 19:32' prior: 32317530!test15NestedTagsStillEndBefore	self testRead: {		'<span><i>Hallo</i> welt</span>'.		'Hallo welt' asText			addAttribute: TextEmphasis italic from: 1 to: 5.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/22/2023 14:23' prior: 32319622!test16ImgTag	<timeout: 10>	| imgUrl imgExpression formFromUrl formFromExpression placeholderForm |	imgUrl := 'https://squeak.org/img/downloads/image.png'.	imgExpression := 'Form dotOfSize: 12@12 color: Color green'.		self ensureSecureInternetConnection.		formFromUrl := (Smalltalk classNamed: 'WebClient') ifNotNil: [:client |		Form fromBinaryStream: (client httpGet: imgUrl) content asByteArray readStream].	formFromExpression := Compiler evaluate: imgExpression.		placeholderForm := readWriter imagePlaceholder.		RealEstateAgent scaleFactor = 1.0 ifFalse: [		formFromUrl := formFromUrl scaledToSize: (formFromUrl extent * RealEstateAgent scaleFactor).		formFromExpression := formFromExpression scaledToSize: (formFromExpression extent * RealEstateAgent scaleFactor).		placeholderForm := placeholderForm scaledToSize: (placeholderForm extent * RealEstateAgent scaleFactor)].		({		[]. imgUrl. formFromUrl.		[]. 'fantasy:wonderland/alice'. placeholderForm.				[]. 'code://' , imgExpression. formFromExpression.		[]. 'code://Object'. placeholderForm.		[]. 'code://' , imgExpression , ';'. placeholderForm.				[readWriter shallDownloadResources: false]. imgUrl. placeholderForm.				[readWriter shallEvaluateResources: false]. 'code://' , imgExpression. placeholderForm.	} groupsCollect: [:prepareBlock :src :expectedForm | {		'Hello <img src="{1}"> World' format: { src }.		('Hello {1} World' format: { Character startOfHeader }) asText			addAttribute: expectedForm asTextAnchor from: 7 to: 7;			addAttribute: (TextColor color: Color transparent) from: 7 to: 7.		prepareBlock}])		, ({		"different closing tag styles"		'Hello <img src="code://{1}"></img> World' format: { imgExpression }.		('Hello {1} World' format: { Character startOfHeader }) asText			addAttribute: formFromExpression asTextAnchor from: 7 to: 7;			addAttribute: (TextColor color: Color transparent) from: 7 to: 7.				'Hello <img src="code://{1}"/> World' format: { imgExpression }.		('Hello {1} World' format: { Character startOfHeader }) asText			addAttribute: formFromExpression asTextAnchor from: 7 to: 7;			addAttribute: (TextColor color: Color transparent) from: 7 to: 7.				"case, spaces, escape sequence"		'Hello <IMG SRC = "code&#x3a;//{1}"> World' format: { imgExpression }.		('Hello {1} World' format: { Character startOfHeader }) asText			addAttribute: formFromExpression asTextAnchor from: 7 to: 7;			addAttribute: (TextColor color: Color transparent) from: 7 to: 7.				"leading and trailing images"		'<img src="code://{1}"> squeak <img src="code://{1}">' format: { imgExpression }.		('{1} squeak {1}' format: { Character startOfHeader }) asText			addAttribute: formFromExpression asTextAnchor from: 1 to: 1;			addAttribute: (TextColor color: Color transparent) from: 1 to: 1;			addAttribute: formFromExpression asTextAnchor from: 10 to: 10;			addAttribute: (TextColor color: Color transparent) from: 10 to: 10.	} pairsCollect: [:a :b | {a. b}])		collect: [:spec |		| givenHtml expectedText prepareBlock |		givenHtml := spec first.		expectedText := spec second.		prepareBlock := spec at: 3 ifAbsent: [].				self setUpReadWriter.		prepareBlock value.		self convertHtml: givenHtml.		self assert: expectedText string equals: text string.		expectedText runs with: text runs do: [:expectedAttributes :actualAttributes |			expectedAttributes with: actualAttributes do: [:expectedAttribute :actualAttribute |				self assert: (expectedAttribute = actualAttribute or: [					((expectedAttribute respondsTo: #anchoredMorph)						and: [actualAttribute respondsTo: #anchoredMorph])						and: [(expectedAttribute anchoredMorph "aForm" unhibernate; bits)							= (actualAttribute anchoredMorph "aForm" unhibernate; bits)]  ]) ]]].! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 20:29'!test18Blockquote	self testReadAndWrite: {		'<blockquote>When in doubt, try it out!!</blockquote>'.		'When in doubt, try it out!!' asText addAttribute: (TextIndent tabs: 1).				'And they said:<br><blockquote>You break it, you fix it.</blockquote><br>And I broke it, so I fixed it.'.		'And they said:You break it, you fix it.And I broke it, so I fixed it.' asText addAttribute: (TextIndent tabs: 1) from: 16 to: 40.			'<blockquote><blockquote><blockquote>Nein!!</blockquote><br>Doch!!</blockquote><br>Ohh!!</blockquote><br>lol'.			'Nein!!Doch!!Ohh!!lol' asText runs: (RunArray runs: #(5 6 5 4) values: {{TextIndent tabs: 1 . TextIndent tabs: 2 . TextIndent tabs: 3} . {TextIndent tabs: 1 . TextIndent tabs: 2} . {TextIndent tabs: 1} . #()})			"addAttribute: (TextIndent tabs: 3) from: 1 to: 5;			addAttribute: (TextIndent tabs: 2) from: 7 to: 11;			addAttribute: (TextIndent tabs: 1) from: 13 to: 16;"			yourself.	}.		self testRead: {		'<bLoCkQuOtE>When in doubt, try it out!!</BlOcKqUoTe>'.		'When in doubt, try it out!!' asText addAttribute: (TextIndent tabs: 1).	}! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/19/2023 17:19'!test19ExcludedTags	{		'A<b>B<script>C<i>D</i>E</script>F</b>G'.		'A<b>BF</b>G' asTextFromHtml.				'A<script>B<style>C</style>D</script>E'.		'AE' asText.	} pairsDo: [:expectedHtml :expectedText |				self convertHtml: expectedHtml.		self assert: expectedText string equals: text string.		self assert: expectedText runs equals: text runs]! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/20/2023 13:46'!test20Link	self testReadAndWrite: {		'<a href="https://squeak.org">hErE</a>'.		'hErE' asText addAttribute: (TextURL url: 'https://squeak.org').				'<a href="code://World explore">hErE</a>'.		'hErE' asText addAttribute: (TextURL url: 'code://World explore').	}.		self testRead: {		'<a    href   =	"https://squeak.org">hErE</a>'.				'hErE' asText addAttribute: (TextURL url: 'https://squeak.org').				'<a href=https://squeak.org>hErE</a>'.				'hErE' asText addAttribute: (TextURL url: 'https://squeak.org').				'<a href="https://www.google.com/search?q=&#34;modern, open-source Smalltalk&#34;">hErE</a>'.		'hErE' asText addAttribute: (TextURL url: 'https://www.google.com/search?q="modern, open-source Smalltalk"').				'<alt href="https://squeak.org">hi</alt>'. "also begins with <a"		'hi' asText.	}.! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/20/2023 14:55'!test21BreakLines	{		' a  b '.		'a b' asText.		' a  b ' asText.				'	a <b> b </b>'.		'a b' asText addAttribute: TextEmphasis bold from: 3 to: 3.		'	a  b ' asText addAttribute: TextEmphasis bold from: 6 to: 8.				"breakLines is preserved after <pre> tag"		' a <pre> b  </pre> c '.		'a  b  c' asText.		' a  b   c ' asText.				"linebreaks in tags are NOT ignored"		'a<span>b</span>c'.		'abc' asText addAttribute: TextEmphasis struckOut from: 2 to: 2.		'abc' asText addAttribute: TextEmphasis struckOut from: 2 to: 2.	} groupsDo: [:givenHtml :expectedBreakLines :expectedNoBreakLines |				self setUpReadWriter breakLines: true.		self testRead: givenHtml as: expectedBreakLines.		self setUpReadWriter breakLines: false.		self testRead: givenHtml as: expectedNoBreakLines].! !!HtmlReadWriterTest methodsFor: 'tests' stamp: 'ct 5/20/2023 17:19'!test22LinebreakAcceptance	self testRead: {		'<div>Hi all!!<div></div><div><br></div><div><span>Squeak.</span></div><div><span>Is.</span><br></div><div><span><b>Great.</b></span></div></div>'.		'Hi all!!Squeak.Is.Great.' asText addAttribute: TextEmphasis bold from: 22 to: 27.				'<html><head>	<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"></head><body>	<div class="WordSection1">		<p>Hi all,</p>		<p><o:p>&nbsp;</o:p></p>		<p>You are <i>so</i> right!!</p>	</div></body>'.		'Hi all, You are so right!!' asText addAttribute: TextEmphasis italic from: 19 to: 20.		'<div><p>I agree!!</p><p><br></p><p>Best,</p><p>Everyone</p></div><hr><div>signature</div>'.		'I agree!!Best,Everyonesignature' asText	}.! !CameraInterface class	instanceVariableNames: ''!!CameraInterface class methodsFor: 'camera ops' stamp: 'eem 2/13/2023 12:19' prior: 20022680!camera: cameraNum getParam: paramNum	"Answer the requested parameter value of the given camera.		param 1 is the frame count, the number of frames grabbed since the last send of getFrameForCamera:into:		param 2 is the size of the bitmap in bytes required for an image		param 3 is whether the image is being mirrored or not"	<primitive: 'primGetParam' module: 'CameraPlugin' error: ec>	self primitiveFailed! !!CameraInterface class methodsFor: 'camera ops' stamp: 'eem 2/13/2023 12:20'!camera: cameraNum setParam: paramNum to: anIntegerOrBoolean	"Set the requested parameter value of the given camera, and answer its previous value.		param 1 cannot be set; it is the frame count, the number of frames grabbed since the last send of getFrameForCamera:into:		param 2 cannot be set; it is the size of the bitmap in bytes required for an image		param 3 is whether the image is being mirrored or not"	<primitive: 'primSetParam' module: 'CameraPlugin' error: ec>	self primitiveFailed! !!CameraInterface class methodsFor: 'camera ops' stamp: 'eem 2/13/2023 12:27'!cameraGetLatestBufferIndex: cameraIndex	"If double-buffering is in effect (set via primSetCameraBuffers) answer	 which buffer contains the freshest data, either A (1) or B (2). If no buffer	 has been filled yet, answer nil.  Otherwise fail with an appropriate error code."	<primitive: 'primGetLatestBufferIndex' module: 'CameraPlugin' error: ec>	^self primitiveFailed	"CameraInterface cameraGetLatestBufferIndex: 1"! !Morph subclass: #MovieMorph	instanceVariableNames: 'playMode msecsPerFrame rotationDegrees scalePoint frameList currentFrameIndex dwellCount'	classVariableNames: ''	poolDictionaries: ''	category: 'Morphic-Basic'!!MovieMorph methodsFor: 'stepping' prior: 58704686!step	playMode = #stop ifTrue: [^ self].	dwellCount > 0 ifTrue: [		dwellCount := dwellCount - 1.		^ self].	currentFrameIndex < frameList size		ifTrue: [^ self setFrame: currentFrameIndex + 1].	playMode = #loop		ifTrue: [self setFrame: 1]		ifFalse: [playMode := #stop].! !!MovieMorph methodsFor: 'stepping' prior: 58705022!stepTime	^ msecsPerFrame! !ParseNode subclass: #LeafNode	instanceVariableNames: 'key code index'	classVariableNames: ''	poolDictionaries: ''	category: 'Compiler-ParseNodes'!!LeafNode methodsFor: 'accessing' stamp: 'yo 10/12/2005 11:29' prior: 51756353!key: anObject	key := anObject.! !!LeafNode methodsFor: 'code generation' stamp: 'eem 7/11/2024 14:23' prior: 51752431!resetFromCopy: aLeafNode	"Reset the state of the recever to match that of the argument.	 This is used to reset nodes that may have been repurposed	 while generating the compiled method for a full block."	code := aLeafNode code.	index := aLeafNode index! !TestCase subclass: #CollectionTest	instanceVariableNames: 'empty nonEmpty'	classVariableNames: ''	poolDictionaries: ''	category: 'CollectionsTests-Abstract'!!CollectionTest methodsFor: 'tests' stamp: 'ct 6/15/2023 19:05' prior: 22992627!testAsCommaStringAnd	{OrderedCollection new. Set new.} do:		[ :coll |		self assert: coll asCommaStringAnd = ''.				coll add: 1.		self assert: coll asCommaStringAnd = '1'.				coll add: 2.		self assert: coll asCommaStringAnd = '1 and 2'.				coll add: 3.		self assert: coll asCommaStringAnd = '1, 2, and 3'].! !Error subclass: #AttemptToWriteReadOnlyGlobal	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Exceptions'!!AttemptToWriteReadOnlyGlobal methodsFor: 'printing' stamp: 'ar 8/17/2001 18:02' prior: 17531568!description	"Return a textual description of the exception."	| desc mt |	desc := 'Error'.	^(mt := self messageText) == nil		ifTrue: [desc]		ifFalse: [desc, ': ', mt]! !!AttemptToWriteReadOnlyGlobal methodsFor: 'priv handling' stamp: 'ar 8/17/2001 18:02' prior: 17531970!isResumable	^true! !RotaryDialMorph subclass: #ClockDialMorph	instanceVariableNames: 'hourHandMorph'	classVariableNames: ''	poolDictionaries: ''	category: 'MorphicExtras-Widgets'!!ClockDialMorph methodsFor: 'stepping' stamp: 'tpr 4/30/2017 17:22' prior: 22561392!step	self setTime: Time now! !!ClockDialMorph methodsFor: 'stepping' stamp: 'tpr 5/3/2017 14:49' prior: 22561507!stepTime	^5000! !AlignmentMorph subclass: #BooklikeMorph	instanceVariableNames: 'pageSize newPagePrototype'	classVariableNames: 'PageFlipSoundOn'	poolDictionaries: ''	category: 'MorphicExtras-Books'!!BooklikeMorph methodsFor: 'page controls' stamp: 'tk 10/5/2007 19:12' prior: 19065198!makeDescriptionViewer	| descriptionItem font box |	font := Preferences standardMenuFont.	descriptionItem := UpdatingStringMorph new.	descriptionItem target: self; getSelector: #descriptionReport.	descriptionItem useStringFormat.	descriptionItem font: font.	box := Morph new.	box color: Color transparent.	box layoutPolicy: TableLayout new.	box vResizing: #rigid.	box hResizing: #rigid.	box color: (Color r: 0.839 g: 1.0 b: 0.806).	box borderWidth: 1.	box  borderColor: (Color r: 0.645 g: 0.774 b: 0.613).	box cellInset: 3.	box cellPositioning: #center.	box listCentering: #center.	box wrapCentering: #center.	box width: (font widthOfString: (String new: 14 withAll: $M)).	box height: font height + 4.	box addMorph: descriptionItem.	"box on: #mouseUp send: #showDescriptionMenu: to: self."	^ box! !!BooklikeMorph methodsFor: 'page controls' stamp: 'yo 8/29/2007 12:20' prior: 19066114!makePageNumberItem	| pageNumberItem |	pageNumberItem := UpdatingStringMorph new.	pageNumberItem target: self; getSelector: #pageNumberReport.	pageNumberItem useStringFormat.	pageNumberItem font: Preferences standardMenuFont.	^ pageNumberItem! !!BooklikeMorph methodsFor: '*Etoys-e-toy support' stamp: 'kfr 11/24/2011 18:23' prior: 19044202!currentPlayerDo: aBlock	| aPlayer aPage |	(aPage := self currentPage) ifNil: [^ self].	aPage allMorphsDo:[ :m|	(aPlayer := m player) ifNotNil:		[aBlock value: aPlayer]]! !AbstractHierarchicalList subclass: #ObjectExplorer	instanceVariableNames: 'root currentParent inspector monitorList expression'	classVariableNames: ''	poolDictionaries: ''	category: 'Tools-Explorer'!!ObjectExplorer methodsFor: 'accessing' stamp: 'mt 1/26/2023 14:17' prior: 59991237!label	self flag: #deprecated.	^ self labelString! !!ObjectExplorer methodsFor: 'accessing' stamp: 'mt 1/26/2023 14:16'!labelString	^ [self rootObject printStringLimitedTo: 40] ifError: ['a ' , self rootObject class]! !!ObjectExplorer methodsFor: 'accessing' stamp: 'mt 12/7/2023 14:34' prior: 34242157!labelString	^ [self rootObject asExplorerString] ifError: ['a ' , self rootObject class]! !!ObjectExplorer methodsFor: 'menus' stamp: 'ct 9/5/2025 23:00' prior: 60000497!mainTreeListMenu: aMenu	<treeListMenu>	aMenu addStayUpItemSpecial.	aMenu addTranslatedList: #(		('inspect (i)'						inspectSelection)		('explore (I)'						exploreSelection)		-		('method refs to this inst var'		referencesToSelection)		('methods storing into this inst var'	defsOfSelection)		('objects pointing to this value'		objectReferencesToSelection)		('chase pointers'					chasePointersForSelection)		('explore pointers'					explorePointersForSelection)		-		('browse full (b)'					browseFull)		('browse hierarchy (h)'				browseClassHierarchy)		('browse protocol (p)'				browseFullProtocol)		-		('references... (r)'					browseVariableReferences)		('assignments... (a)'				browseVariableAssignments)		('class refs (N)'						browseClassRefs)		-		('copy name (c)'					copyName)				('copy value'						copyValue)				('basic inspect'						inspectBasic)).	Smalltalk isMorphic ifTrue: [		aMenu addTranslatedList: #(			-			('viewer for this value (v)'		viewerForValue))].	aMenu addTranslatedList: #(		-		('monitor changes'		monitorSelection)).					monitorList isEmptyOrNil ifFalse: [		aMenu addTranslatedList: #(			('stop monitoring all'		stopMonitoring))].					^ aMenu! !!ObjectExplorer methodsFor: 'user interface' stamp: 'mt 4/5/2023 11:01' prior: 60006816!getDragItem: binding	^ binding! !!ObjectExplorer methodsFor: 'user interface' stamp: 'mt 4/5/2023 10:49'!getDragType: binding	^ #explorerField! !!ObjectExplorer methodsFor: 'toolbuilder' stamp: 'mt 1/26/2023 14:17' prior: 60018437!buildWith: builder	| windowSpec treeSpec textSpec buttonSpec buttonOffset tool |	windowSpec := builder pluggableWindowSpec new.	windowSpec		model: self;		children: OrderedCollection new;		label: #windowTitle.		treeSpec := builder pluggableTreeSpec new.	treeSpec		model: self;		nodeClass: self class nodeClass;		roots: #getList;		keyPress: #explorerKey:from:event:;		getSelected: #currentSelection;		setSelected: #currentSelection:;		setSelectedParent: #currentParent:;		menu: #genericMenu:;		dragItem: #getDragItem:;		autoDeselect: false;		columns: (ObjectExplorerWrapper showContentsInColumns			ifTrue: [{				[:listMorph | (listMorph filteredItems collect: [:item |					item preferredWidthOfColumn: 1]) max].				nil "take all the space"}]);		frame: (0@0 corner: 1@0.71).	windowSpec children add: treeSpec.	buttonOffset := (Preferences standardButtonFont widthOfString: 'inspect') * 3/2.	textSpec := builder pluggableCodePaneSpec new.	textSpec		model: self;		getText: #expression;		editText: #expression:;		menu: #codePaneMenu:shifted:;		help: 'Evaluate expressions for the current tree selection...' translated;		frame: (LayoutFrame fractions: (0@0.71 corner: 1@1) offsets: (0@0 corner: buttonOffset negated@0)).	windowSpec children add: textSpec.	buttonSpec := builder pluggableButtonSpec new		model: self;		label: 'inspect';		action: #inspectObject;		help: 'Switch to an inspector tool';		frame: (LayoutFrame fractions: (1@0.71 corner: 1@1) offsets: (buttonOffset negated@0 corner: 0 @ 0)).	windowSpec children add: buttonSpec.		tool := builder build: windowSpec.	self changed: #expandRootsRequested.	^ tool! !!ObjectExplorer methodsFor: 'toolbuilder' stamp: 'mt 4/5/2023 10:45' prior: 34244058!buildWith: builder	| windowSpec treeSpec textSpec buttonSpec buttonOffset tool |	windowSpec := builder pluggableWindowSpec new.	windowSpec		model: self;		children: OrderedCollection new;		label: #windowTitle.		treeSpec := builder pluggableTreeSpec new.	treeSpec		model: self;		nodeClass: self class nodeClass;		roots: #getList;		keyPress: #explorerKey:from:event:;		getSelected: #currentSelection;		setSelected: #currentSelection:;		setSelectedParent: #currentParent:;		menu: #genericMenu:;		dragItem: #getDragItem:;		dragType: #getDragType:;		autoDeselect: false;		columns: (ObjectExplorerWrapper showContentsInColumns			ifTrue: [{				[:listMorph | (listMorph filteredItems collect: [:item |					item preferredWidthOfColumn: 1]) max].				nil "take all the space"}]);		frame: (0@0 corner: 1@0.71).	windowSpec children add: treeSpec.	buttonOffset := (Preferences standardButtonFont widthOfString: 'inspect') * 3/2.	textSpec := builder pluggableCodePaneSpec new.	textSpec		model: self;		getText: #expression;		editText: #expression:;		menu: #codePaneMenu:shifted:;		help: 'Evaluate expressions for the current tree selection...' translated;		frame: (LayoutFrame fractions: (0@0.71 corner: 1@1) offsets: (0@0 corner: buttonOffset negated@0)).	windowSpec children add: textSpec.	buttonSpec := builder pluggableButtonSpec new		model: self;		label: 'inspect';		action: #inspectObject;		help: 'Switch to an inspector tool';		frame: (LayoutFrame fractions: (1@0.71 corner: 1@1) offsets: (buttonOffset negated@0 corner: 0 @ 0)).	windowSpec children add: buttonSpec.		tool := builder build: windowSpec.	self changed: #expandRootsRequested.	^ tool! !!ObjectExplorer methodsFor: 'toolbuilder' stamp: 'ct 9/5/2025 22:59' prior: 34245810!buildWith: builder	| windowSpec treeSpec textSpec buttonSpec buttonOffset tool |	windowSpec := builder pluggableWindowSpec new.	windowSpec		model: self;		children: OrderedCollection new;		label: #windowTitle.		treeSpec := builder pluggableTreeSpec new.	treeSpec		model: self;		nodeClass: self class nodeClass;		roots: #getList;		keyPress: #explorerKey:from:event:;		getSelected: #currentSelection;		setSelected: #currentSelection:;		setSelectedParent: #currentParent:;		menu: #genericMenu:;		dragItem: #getDragItem:;		dragType: #getDragType:;		autoDeselect: false;		columns: (ObjectExplorerWrapper showContentsInColumns			ifTrue: [{				[:listMorph | (listMorph filteredItems collect: [:item |					item preferredWidthOfColumn: 1]) max].				nil "take all the space"}]);		frame: (0@0 corner: 1@0.71).	windowSpec children add: treeSpec.	buttonOffset := (Preferences standardButtonFont widthOfString: 'inspect') * 3/2.	textSpec := builder pluggableCodePaneSpec new.	textSpec		model: self;		getText: #expression;		editText: #expression:;		menu: #codePaneMenu:shifted:;		help: 'Evaluate expressions for the current tree selection...' translated;		frame: (LayoutFrame fractions: (0@0.71 corner: 1@1) offsets: (0@0 corner: buttonOffset negated@0)).	windowSpec children add: textSpec.	buttonSpec := builder pluggableButtonSpec new		model: self;		label: 'inspect' translated;		action: #inspectObject;		help: 'Switch to an inspector tool' translated;		frame: (LayoutFrame fractions: (1@0.71 corner: 1@1) offsets: (buttonOffset negated@0 corner: 0 @ 0)).	windowSpec children add: buttonSpec.		tool := builder build: windowSpec.	self changed: #expandRootsRequested.	^ tool! !!ObjectExplorer methodsFor: 'toolbuilder' stamp: 'mt 1/20/2023 18:29' prior: 60021077!inspectObject	"Switch to an inspector tool."		| window currentBounds |	RealEstateAgent rememberExtentFor: self.	currentBounds := ToolBuilder findDefault getBoundsForWindow: self containingWindow.	"Close first because MVC fiddles around with processes."	self changed: #close. 			window := ToolSet inspect: self rootObject.		"---- In MVC, the lines after this will not be executed ---"	window model setExpression: self expression.	ToolBuilder findDefault setBoundsForWindow: window to: currentBounds.! !!ObjectExplorer methodsFor: 'toolbuilder' stamp: 'ct 9/16/2025 02:49' prior: 34249391!inspectObject	"Switch to an inspector tool."		| window currentBounds hasUnacceptedChanges |	Project current isMVC ==> [self okToChange] ifFalse: [^ self].		RealEstateAgent rememberExtentFor: self.	currentBounds := ToolBuilder findDefault getBoundsForWindow: self containingWindow.		hasUnacceptedChanges := self canDiscardEdits not.	self changed: #acceptChanges. "We copy the current state anyway. See below."		"Close first because MVC fiddles around with processes."	self changed: #close. 			window := ToolSet inspect: self rootObject.		"---- In MVC, the lines after this will not be executed ---"	window model setExpression: self expression.	hasUnacceptedChanges ifTrue: [		(window model anyTextPaneWithSelector: #expression) ifNotNil: [:textPane |			textPane hasUnacceptedEdits: true]].	ToolBuilder findDefault setBoundsForWindow: window to: currentBounds.! !!ObjectExplorer methodsFor: '*Etoys-menus - actions' stamp: 'mt 2/3/2016 20:17' prior: 60029558!viewerForValue	self object beViewed.! !!ObjectExplorer methodsFor: 'updating' stamp: 'ct 7/3/2025 01:56'!okToChange	self canDiscardEdits ifTrue: [^ true].	self changed: #wantToChange.  "Solicit cancel from view"	^ self canDiscardEdits! !!ObjectExplorer methodsFor: 'updating' stamp: 'ct 7/10/2025 00:11'!okToChange: requestor	requestor knownName = #tree ifTrue: [^ true].	^ self okToChange! !LedMorph subclass: #LedTimerMorph	instanceVariableNames: 'counting startSeconds'	classVariableNames: ''	poolDictionaries: ''	category: 'MorphicExtras-Leds'!!LedTimerMorph methodsFor: 'stepping' stamp: 'djp 10/23/1999 21:35' prior: 51788851!start	counting := true! !!LedTimerMorph methodsFor: 'stepping' stamp: 'djp 10/24/1999 01:12' prior: 51788963!step	flash		ifTrue: [super step]		ifFalse: [			counting ifTrue: [self updateTime]]! !!LedTimerMorph methodsFor: 'stepping' stamp: 'djp 10/23/1999 21:27' prior: 51789259!stepTime	^ 1000! !!LedTimerMorph methodsFor: 'stepping' stamp: 'djp 10/31/1999 21:44' prior: 51789529!stop	counting ifTrue: [self updateTime].	counting := false.! !!LedTimerMorph methodsFor: 'stepping' stamp: 'djp 10/24/1999 01:12' prior: 51789856!updateTime	self value:  Time totalSeconds - startSeconds.	self changed! !PluggableListMorph subclass: #AlternatePluggableListMorphOfMany	instanceVariableNames: 'getSelectionListSelector setSelectionListSelector'	classVariableNames: ''	poolDictionaries: ''	category: 'Morphic-Pluggable Widgets'!!AlternatePluggableListMorphOfMany methodsFor: 'event handling' stamp: 'ct 9/16/2025 01:42' prior: 17241086!mouseDown: event	| row |	event yellowButtonPressed ifTrue: [^ self yellowButtonActivity: event shiftPressed].	row := self rowAtLocation: event position.		row = 0 ifTrue: [^super mouseDown: event].	self okToChangeModel ifFalse: [^ self]. "No change if model is locked"	"Inform model of selected item and let it toggle."	self		changeModelSelection: (self modelIndexFor: row)		shifted: event shiftPressed		controlled: event controlKeyPressed."	event hand releaseMouseFocus: aMorph.	submorphs do: [ :each | each changed ]"! !!AlternatePluggableListMorphOfMany methodsFor: 'event handling' stamp: 'ct 9/16/2025 01:42' prior: 17244492!mouseMove: event 	"The mouse has moved, as characterized by the event provided.  Adjust the scrollbar, and alter the selection as appropriate"	| oldIndex oldVal row |	event position y < self top 		ifTrue: 			[scrollBar scrollUp: 1.			row := self rowAtLocation: scroller topLeft + (1 @ 1)]		ifFalse: 			[row := event position y > self bottom 				ifTrue: 					[scrollBar scrollDown: 1.					self rowAtLocation: scroller bottomLeft + (1 @ -1)]				ifFalse: [ self rowAtLocation: event position]].	row = 0 ifTrue: [^super mouseDown: event].	self okToChangeModel ifFalse: [^self]. "No change if model is locked"	"Set meaning for subsequent dragging of selection"	oldIndex := self getCurrentSelectionIndex.	oldIndex ~= 0 ifTrue: [oldVal := self listSelectionAt: oldIndex].	"Need to restore the old one, due to how model works, and set new one."	oldIndex ~= 0 ifTrue: [self listSelectionAt: oldIndex put: oldVal].	"Inform model of selected item and let it toggle."	self 		changeModelSelection: (self modelIndexFor: row)		shifted: true		controlled: true.	submorphs do: [:each | each changed]! !WordGamePanelMorph subclass: #CrosticQuotePanel	instanceVariableNames: 'cluesPanel'	classVariableNames: ''	poolDictionaries: ''	category: 'MorphicExtras-Games'!!CrosticQuotePanel methodsFor: 'geometry' stamp: 'ct 8/23/2022 20:05' prior: 24689433!extent: newExtent	| w h nAcross relLoc topLeft |	w := self firstSubmorph width - 1 px.  h := self firstSubmorph height - 1 px.	nAcross := newExtent x - (self borderWidth - 1 px * 2) - 1 px // w.	topLeft := self position + self borderWidth - 1 px.	submorphs withIndexDo:		[:m :i | 		relLoc := (i-1 \\ nAcross * w) @ (i-1 // nAcross * h).		m position: topLeft + relLoc].	super extent: ((w * nAcross + 1) @ (submorphs size - 1 // nAcross + 1 * h+1))					+ (self borderWidth - 1 px * 2).! !!CrosticQuotePanel methodsFor: 'geometry' stamp: 'ct 8/23/2022 20:05' prior: 34254623!extent: newExtent	| w h nAcross relLoc topLeft |	w := self firstSubmorph width - 1 px.  h := self firstSubmorph height - 1 px.	nAcross := newExtent x - (self borderWidth - 1 px * 2) - 1 px // w.	topLeft := self position + self borderWidth - 1 px.	submorphs withIndexDo:		[:m :i | 		relLoc := (i-1 \\ nAcross * w) @ (i-1 // nAcross * h).		m position: topLeft + relLoc].	super extent: ((w * nAcross + 1) @ (submorphs size - 1 // nAcross + 1 * h+1))					+ (self borderWidth - 1 px * 2).! !!CrosticQuotePanel methodsFor: 'defaults' stamp: 'di 5/11/2000 09:37' prior: 24689981!highlight: morph	self unhighlight.	cluesPanel unhighlight.	morph startOfWord morphsInWordDo:		[:m | m color: Color lightGreen.		(cluesPanel letterMorphs at: m indexInQuote) color: Color lightMagenta].	morph color: Color green.	(cluesPanel letterMorphs at: morph indexInQuote) color: Color magenta.! !!CrosticQuotePanel methodsFor: 'defaults' stamp: 'di 5/10/2000 09:25' prior: 24690363!keyCharacter: aLetter atIndex: indexInQuote nextFocus: nextFocus	(self letterMorphs at: indexInQuote) setLetter: aLetter.	(cluesPanel letterMorphs at: indexInQuote) setLetter: aLetter.	self highlight: nextFocus! !!CrosticQuotePanel methodsFor: 'defaults' stamp: 'di 5/10/2000 08:49' prior: 24690654!lostFocus	self unhighlight.	cluesPanel unhighlight! !!CrosticQuotePanel methodsFor: 'initialization' stamp: 'ct 8/23/2022 20:05' prior: 24690790!quote: quoteWithBlanks answers: theAnswers cluesPanel: panel	| n morph prev clueIxs |	cluesPanel := panel.	self color: Color gray.	clueIxs := Array new: quoteWithBlanks size.	theAnswers withIndexDo: [:a :i | a do: [:j | clueIxs at: j put: i]].	letterMorphs := OrderedCollection new.	prev := nil.	self addAllMorphs: (quoteWithBlanks asArray collect:		[:c |		c isLetter			ifTrue: [n := letterMorphs size + 1.					morph := WordGameLetterMorph new boxed.					CrosticPanel oldStyle						ifTrue: [morph indexInQuote: n id1: n printString.								morph id2: (($A to: $Z) at: (clueIxs at: n)) asString]						ifFalse: [morph indexInQuote: n id1: nil].					morph setLetter: Character space.					morph on: #mouseDown send: #mouseDownEvent:letterMorph: to: self.					morph on: #keyStroke send: #keyStrokeEvent:letterMorph: to: self.					letterMorphs addLast: morph]			ifFalse: [morph := WordGameLetterMorph new boxed indexInQuote: nil id1: nil.					CrosticPanel oldStyle ifTrue: [morph extent: 26 px @ 24 px  "Oops"]].		morph predecessor: prev.		prev ifNotNil: [prev successor: morph].		prev := morph]).! !!CrosticQuotePanel methodsFor: 'initialization' stamp: 'ct 8/23/2022 20:05' prior: 34256651!quote: quoteWithBlanks answers: theAnswers cluesPanel: panel	| n morph prev clueIxs |	cluesPanel := panel.	self color: Color gray.	clueIxs := Array new: quoteWithBlanks size.	theAnswers withIndexDo: [:a :i | a do: [:j | clueIxs at: j put: i]].	letterMorphs := OrderedCollection new.	prev := nil.	self addAllMorphs: (quoteWithBlanks asArray collect:		[:c |		c isLetter			ifTrue: [n := letterMorphs size + 1.					morph := WordGameLetterMorph new boxed.					CrosticPanel oldStyle						ifTrue: [morph indexInQuote: n id1: n printString.								morph id2: (($A to: $Z) at: (clueIxs at: n)) asString]						ifFalse: [morph indexInQuote: n id1: nil].					morph setLetter: Character space.					morph on: #mouseDown send: #mouseDownEvent:letterMorph: to: self.					morph on: #keyStroke send: #keyStrokeEvent:letterMorph: to: self.					letterMorphs addLast: morph]			ifFalse: [morph := WordGameLetterMorph new boxed indexInQuote: nil id1: nil.					CrosticPanel oldStyle ifTrue: [morph extent: 26 px @ 24 px  "Oops"]].		morph predecessor: prev.		prev ifNotNil: [prev successor: morph].		prev := morph]).! !ProtoObject subclass: #ObjectTracer	instanceVariableNames: 'tracedObject recursionFlag'	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Objects'!!ObjectTracer methodsFor: 'very few messages' stamp: 'ct 2/25/2024 19:06'!mustBeBoolean	"Overwritten to preserve original sender context.		This is required to support conditional jumps (ifTrue:/ifFalse:) based on traced booleans, e.g.:		(ObjectTracer on: false) ifTrue: [1] ifFalse: [2]."	^ self mustBeBooleanIn: thisContext sender! !!ObjectTracer methodsFor: 'very few messages' stamp: 'ct 6/22/2025 23:16' prior: 34259229!mustBeBoolean	"Overwritten to preserve original sender context.		This is required to support conditional jumps (ifTrue:/ifFalse:) based on traced booleans, e.g.:		(ObjectTracer on: false) ifTrue: [1] ifFalse: [2].		(ObjectViewer on: false evaluate: [] wheneverChangeIn: []) ifTrue: [1] ifFalse: [2]."	^ self mustBeBooleanIn: thisContext sender! !Error subclass: #BlockCannotReturn	instanceVariableNames: 'pc result deadHome finalContext'	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Exceptions'!!BlockCannotReturn methodsFor: 'accessing' stamp: 'jar 11/26/2023 22:26'!finalContext	^ finalContext! !!BlockCannotReturn methodsFor: 'accessing' stamp: 'jar 11/26/2023 22:26'!finalContext: context	finalContext := context! !!BlockCannotReturn methodsFor: 'accessing' stamp: 'eem 11/20/2023 16:54'!pc	^ pc!