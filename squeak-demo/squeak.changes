:= InstructionStream on: self.			 [is willSend or: [is atEnd]] whileFalse:				[prevPc := is pc.				 is pc: is followingPc].			 is willSend ifFalse:				[^false].			 selector := is nextInstruction arguments first.			 (selector == #deprecated or: [selector == #deprecated:]) ifTrue:				[^true].			 selector == #flag: ifFalse:				[^false].			is pc: prevPc.			prevBytecode := is nextInstruction.			^prevBytecode selector == #pushConstant:			 and: [prevBytecode argument == #deprecated]]].	^false! !!CompiledMethod methodsFor: 'private' stamp: 'eem 7/31/2025 14:12' prior: 23722151!penultimateLiteral: anObject	"Set the penultimate literal of the receiver, which holds either the	 receiver's selector or its properties (which will hold the selector).	 If it is an AdditionalMethodState set the state's ownership to this	 method"	| pIndex |	(pIndex := self numLiterals - 1) <= 0 ifTrue:		[self error: 'insufficient literals'].	self literalAt: pIndex put: anObject.	anObject isMethodProperties ifTrue:		[(anObject method ~~ nil		  and: [anObject method ~~ self		  and: [anObject method penultimateLiteral == anObject]]) ifTrue:			[self error: 'a method''s AdditionalMethodState should not be shared'].		 anObject setMethod: self.		 anObject pragmasDo: [:p| p setMethod: self]]! !!CompiledMethod methodsFor: 'accessing-pragmas & properties' stamp: 'eem 7/31/2025 13:30'!pragmasDo: aBlock	| selectorOrProperties |	(selectorOrProperties := self penultimateLiteral) isMethodProperties ifTrue:		[selectorOrProperties pragmasDo: aBlock]! !!CompiledMethod methodsFor: '*Traits-NanoKernel' stamp: 'eem 3/7/2025 18:14' prior: 23736502!sameTraitCodeAs: method	"Answer whether the receiver implements the same code as the 	argument, method."	method isCompiledMethod ifFalse: [^false].	self methodHome == method methodHome ifFalse: [^false].	^self = method! !!CompiledMethod methodsFor: '*Traits-NanoKernel' stamp: 'eem 10/6/2025 15:03' prior: 33882092!sameTraitCodeAs: 