changeContents: false.		"N.B. Only reset the contents if the compilation succeeds. If contents would be reset when compilation fails, both compiler error message and modifications were lost."		^ (self contents: aText notifying: aController)			ifTrue: [self contentsChanged];			yourself].		classOfMethod := self selectedClass.	category := self selectedMessageCategoryName.		"Do the actual compilation"	selector := classOfMethod		compile: aText		classified: category		notifying: aController.	selector ifNil: [^ false]. "compilation cancelled"		"Update views"	contents := aText.	newMethod := classOfMethod compiledMethodAt: selector.	newMethod isQuick ifTrue: [		self cutBackExecutionToSenderContext].	ctxt := interruptedProcess popTo: self selectedContext.	ctxt == self selectedContext		ifFalse: [self inform: 'Method saved, but current context unchanged\because of unwind error. Click OK to see error' translated withCRs]		ifTrue: [			newMethod isQuick ifFalse: [				interruptedProcess restartTopWith: newMethod.				ctxt := self stepToStatement].			contextVariablesInspector object: nil].	self resetContext: ctxt.		Project current addDeferredUIMessage: [		self changed: #contentsSelection].	^ true! !!Debugger methodsFor: 'accessing' stamp: 'ct 5/12/2025 19:19'!emptyContents	self message isEmptyOrNil ifFalse: [^ self message].		self exception ifNil: [^ String new].	^ '<b>{1}</b><br><br>{2}<br><br>{3} {4} {5}' translated asTextFromHtml format:		{self exception description.		self exception longPrintString withBlanksTrimmed.		'[Show top context]' asText			addAttribute: (PluggableTextAttribute evalBlock: [self showTopContext]);			yourself.		'[Show bug report]' asText			addAttribute: (PluggableTextAttribute evalBlock: [self showBugReport]);			yourself.		'[Copy bug report to clipboard]' asText			addAttribute: (PluggableTextAttribute evalBlock: [self copyBugReportToClipboard]);			yourself}! !!Debugger methodsFor: 'accessing' stamp: 'ct 9/5/2025 02:38' prior: 37219600!emptyContents	self message isEmptyOrNil ifFalse: [^ self message].		self exception ifNil: [^ String new].	^ '<b>{1}</b><br><br>{2}<br><br>{3} {4} {5}' translated asTextFromHtml format:		{self tryPrint: [self exception description] errorMessage: ['Error printing exception message' translated].		self tryPrint: [self exception longPrintString withBlanksTrimmed] errorMessage: ['Error printing exception details' translated].		'[Show top context]' asText			addAttribute: (PluggableTextAttribute evalBlock: [self showTopContext]);			yourself.		'[Show bug report]' asText			addAttribute: (PluggableTextAttribute evalBlock: [self showBugReport]);			yourself.		'[Copy bug report to clipboard]' asText			addAttribute: (PluggableTextAttribute evalBlock: [self copyBugReportToClipboard]);			yourself}! !!Debugger methodsFor: 'accessing' stamp: 'ct 12/20/2023 15:08'!exception	^ exception! !!Debugger methodsFor: 'accessing' stamp: 'ct 12/20/2023 15:08'!exception: anExceptionOrNil	exception := anExceptionOrNil.! !!Debugger methodsFor: 'accessing' stamp: 'ct 4/19/2025 21:42'!message	^ message! !!Debugger methodsFor: 'accessing' stamp: 'ct 5/12/2025 19:11' prior: 25312326!receiver	"Answer the receiver of the selected context, or otherwise the exception of the debugger, if any."	^ self hasContextSelected		ifTrue: [self selectedContext receiver]		ifFalse: [self exception]! !!Debugger methodsFor: 'code pane' stamp: 'ct 5/12/2025 19:07' prior: 25313160!aboutToStyle: aStyler	"This is a notification that aStyler is about to re-style its text.	Set the classOrMetaClass in aStyler, so that identifiers	will be resolved correctly.	Answer true to allow styling to proceed, or false to veto the styling"		self hasContextSelected ifFalse: [^ false].	self isModeStyleable ifFalse: [^false].	aStyler 		classOrMetaClass: self selectedClassOrMetaClass;		sourceMap: self debuggerMap.	^true! !!Debugger methodsFor: 'code pane' stamp: 'ct 5/12/2025 19:09' prior: 25314590!doItContext	"Answer the context in which a text selection can be evaluated."	^ self hasContextSelected		ifFalse: [super doItContext]		ifTrue: [self selectedContext]! !!Debugger methodsFor: 'code pane' stamp: 'eem 10/24/2024 21:40'!innermostRangeForSourceIndex: sourceRange in: ranges	^ranges		inject: (ranges detect: [:range| self range: range includes: sourceRange] ifNone: [^nil])		into: [:best :next|			((self range: next includes: sourceRange)			 and: [self range: best includes: next])				ifTrue: [next]				ifFalse: [best]]! !!Debugger methodsFor: 'code pane' stamp: 'ct 5/12/2025 20:29' prior: 25316723!pcRange	"Answer the indices in the source code for the method corresponding to 	the selected context's program counter value."	| ctxt |	(selectingPC and: [contextStackIndex ~= 0]) ifFalse:		[^1 to: 0].	(ctxt := self selectedContext) isDead ifTrue:		[^1 to: 0].	^ self showingByteCodes		ifTrue:			[self pcRangeForByteCode: ctxt]		ifFalse:			[ctxt debuggerMap				rangeForPC: ctxt pc				in: ctxt method				contextIsActiveContext: contextStackIndex = 1]! !!Debugger methodsFor: 'code pane' stamp: 'ct 5/12/2025 20:29'!pcRangeForByteCode: aContext	| lineIndex |	lineIndex := self selectedMessage lines findFirst: [:line |		line notEmpty			and: [(line attributesAt: 1) anySatisfy: [:attr | attr isCompiledCodeAttribute and: [attr compiledCode == aContext method]]]			and: [([line withBlanksTrimmed asNumber] ifError: ["metatext (e.g., <primitive>)" nil]) = aContext pc]].	^ self selectedMessage indicesCorrespondingToLine: lineIndex! !!Debugger methodsFor: 'code pane' stamp: 'eem 10/24/2024 21:38'!range: intervalA includes: intervalB	^intervalA first <= intervalB first and: [intervalA last >= intervalB last]! !!Debugger methodsFor: 'code pane' stamp: 'eem 10/18/2024 16:03'!rangesForScopes	"Answer a Dictionary from source range to closure and/or method	 for the current method and all blocks within it."	| ranges method map |	ranges := Dictionary new.	method := self selectedContext homeMethod.	map := method debuggerMap.	method embeddedBlockClosures do:		[:closure|		ranges at: (map rangeForClosure: closure) put: closure].	ranges at: (map rangeForMethod: method) put: method.	^ranges! !!Debugger methodsFor: 'code pane menu' stamp: 'eem 10/22/2024 11:00' prior: 25317174!debuggerCodePaneMenu: aMenu	<codePaneMenu>	<menuPriority: 200>	^ aMenu		add: 'run to here' target: self selector: #runToSelection: argument: self codePaneSelectionInterval;		add: 'run until...' target: self selector: #runUntil;		add: 'send until...' target: self selector: #sendUntil;		addLine;		yourself! !!Debugger methodsFor: 'code pane menu' stamp: 'ct 4/20/2025 21:15'!doSendUntil: condition	"Send until the given condition evaluates to other than false, reporting an error it if does not evaluate to true.		Unlike doStepUntil:/run until..., don't update the UI. If shift is pressed while sending, stop sending.	Using a user interrupt to break out would be more natural but Squeak currently doesn't provide a UserInterrupt exception. It should do."		self okToChange ifFalse: [^ self].	self interruptedProcessIsReady ifFalse: [^ self shouldNotStep].	self checkContextSelection.		^Cursor execute showWhile:		[| receiver visibleContext currentContext shiftNotPressed lastShiftCheck now value |		visibleContext := currentContext := self selectedContext.		receiver := visibleContext receiver.		lastShiftCheck := Time utcMicrosecondClock. "utcMicrosecondClock takes about 17ns on an Apple M1 Max MBP; Sensor shiftPressed takes 4.25us, 250 times slower. So poll shift every 250ms"		shiftNotPressed := true.		 [(visibleContext == currentContext or: [currentContext hasSender: visibleContext])		   and: [visibleContext willReturn not		   and: [shiftNotPressed		   and: [currentContext receiver ~~ receiver or: [(value := condition value) == false]]]]] whileTrue:			[interruptedProcess step: currentContext.			 currentContext := self stepToStatement.				(now := Time utcMicrosecondClock) - lastShiftCheck > 250000 "250ms" ifTrue:				[lastShiftCheck := now.				 shiftNotPressed := Sensor shiftPressed not]].			self updateProcess.		self contextStackIndex > 1			ifTrue: [self resetContext: currentContext]			ifFalse:				[currentContext == visibleContext					ifTrue: [self changed: #contentsSelection; updateInspectors]					ifFalse: [self resetContext: currentContext]].		value]! !!Debugger methodsFor: 'code pane menu' stamp: 'ct 4/20/2025 21:15' prior: 25353146!doStepUntil: condition	"Step until the given condition evaluates to other than false, reporting an error it if does not evaluate to true.	 If shift is pressed when the expression is supplied, don't update the UI. If shift is pressed while stepping, stop	 stepping. Using a user interrupt to break out would be more natural but Squeak currently doesn't provide a	 UserInterrupt exception. It should do."		self okToChange ifFalse: [^ self].	self interruptedProcessIsReady ifFalse: [^ self shouldNotStep].	self checkContextSelection.	^Cursor execute showWhile:		[| currentContext newContext value lastUpdate updateUI breakOnShift |		currentContext := newContext := self selectedContext.		lastUpdate := Time utcMicrosecondClock.		updateUI := breakOnShift := Sensor shiftPressed not.		[newContext == currentContext		 and: [currentContext willReturn not		 and: [(value := condition value) == false]]] whileTrue:			[self				handleLabelUpdatesIn: [newContext := interruptedProcess completeStep: currentContext]				whenExecuting: currentContext.			interruptedProcess ifNil: [^self shouldNotStep].			newContext == currentContext ifTrue:				[newContext := self stepToStatement.				self resetContext: newContext changeContents: false].			Time utcMicrosecondClock - lastUpdate > 250000 "250ms" ifTrue:				[updateUI ifTrue:					[self changed: #contentsSelection.					Project current world displayWorldSafely].				breakOnShift 					ifTrue:						[Sensor shiftPressed ifTrue:							[self changed: #contentsSelection.							 self updateInspectors.							 ^self]]					ifFalse:						[Sensor shiftPressed ifFalse:							[breakOnShift := true]].				 lastUpdate := Time utcMicrosecondClock]].		self updateProcess.		self contextStackIndex > 1			ifTrue: [self resetContext: newContext]			ifFalse:				[newContext == currentContext					ifTrue: [self changed: #contentsSelection; updateInspectors]					ifFalse: [self resetContext: newContext]].		value]! !!Debugger methodsFor: 'code pane menu' stamp: 'eem 10/22/2024 11:23'!promptForUntilExpression: promptString then: aBlock	"Prompt the user for an expression at which to break and then evaluate aBlock with	 a block that evaluates the expression. Remember the expression in an inst var."	| expression receiver context method value |	expression := UIManager default 					request: promptString					initialAnswer: (untilExpression ifNil: 'boolean expression' translated).	(expression isNil or: [expression isEmpty]) ifTrue:		[^self].	untilExpression := expression.	context := self selectedContext.	receiver := context receiver.	self assert: (context objectClass: receiver) == receiver class.	method := receiver class evaluatorClass new 				compiledMethodFor: untilExpression				in: context				to: receiver				notifying: nil				ifFail: [^#failedDoit].	method allLiteralsDo:		[:l|		(l isVariableBinding and: [Undeclared includesAssociation: l]) ifTrue:			[^UIManager default inform: 'the expression contains an Undeclared variable!!!!' translated]].	value := aBlock value: [receiver with: context executeMethod: method].			(value ~~ self and: [value ~~ false and: [value ~~ true]]) ifTrue:		[UIManager default			inform: ('expression {1} answered {2}!!!!' translated						format: {untilExpression contractTo: 40. value printString contractTo: 20})]! !!Debugger methodsFor: 'code pane menu' stamp: 'eem 10/24/2024 21:53' prior: 25319812!runToSelection: textSelectionInterval	| selectionInterval ranges targetRange |	selectionInterval := textSelectionInterval last < textSelectionInterval first							ifTrue: [textSelectionInterval first to: textSelectionInterval first]							ifFalse: [textSelectionInterval].	self pc first >= selectionInterval first ifTrue:		[^self].	"These are the source range for the method plus source ranges for all (non-inlined) blocks within it"	ranges := self rangesForScopes keys sorted: [:a :b| a first < b first].	targetRange := self innermostRangeForSourceIndex: selectionInterval in: ranges.	 "Step into block until the targetRange includes the current pc range.	  So nothing is done if there are no blocks since the targetRange will be that for the home method,	  or if the selection is not in some inner block, for the same reason."	 [self range: targetRange includes: self pc] whileFalse:		[self stepIntoBlock].	self doStepUntil:		[self pc first >= selectionInterval first]! !!Debugger methodsFor: 'code pane menu' stamp: 'eem 7/7/2022 17:56' prior: 25335081!runUntil	"Step until an expression evaluates to other than false, reporting an error if it doesn't evaluate to true. Remember the expression in an inst var."	| expression receiver context method value |	expression := UIManager default 					request: 'run until expression is true (shift to disable ui update; shift to break).'					initialAnswer: (untilExpression ifNil: 'boolean expression').	(expression isNil or: [expression isEmpty]) ifTrue:		[^self].	untilExpression := expression.	context := self selectedContext.	receiver := context receiver.	method := receiver class evaluatorClass new 				compiledMethodFor: untilExpression				in: context				to: receiver				notifying: nil				ifFail: [^ #failedDoit].	value := self doStepUntil: [method valueWithReceiver: receiver arguments: {context}].			(value ~~ self and: [value ~~ false and: [value ~~ true]]) ifTrue:		[UIManager default inform: 'expression ', (untilExpression contractTo: 40), ' answered ', (value printString contractTo: 20), '!!!!']! !!Debugger methodsFor: 'code pane menu' stamp: 'eem 10/22/2024 11:19' prior: 37231406!runUntil	"Step until an expression evaluates to other than false, reporting an error if it doesn't evaluate to true.	 Remember the expression in an inst var."	self		promptForUntilExpression: 'step until expression is true (shift to disable ui update; shift to break).' translated		then: [:breakMethodEvaluatorBlock| self doStepUntil: breakMethodEvaluatorBlock]! !!Debugger methodsFor: 'code pane menu' stamp: 'eem 10/22/2024 11:19'!sendUntil	"Send until an expression evaluates to other than false, reporting an error if it doesn't evaluate to true.	 Remember the expression in an inst var."	self		promptForUntilExpression: 'send until expression is true (press shift to break).' translated		then: [:breakMethodEvaluatorBlock| self doSendUntil: breakMethodEvaluatorBlock]! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 19:07' prior: 25337736!browseMessages	"Present a menu of all messages sent by the currently selected message.	Open a message set browser of all implementors of the message chosen.	Do nothing if no message is chosen."	self hasContextSelected ifFalse: [^ self].	self withSelectorAndMessagesIn: self selectedContext method		evaluate: [:selector| self systemNavigation browseAllImplementorsOf: selector]! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 19:07' prior: 25338989!browseSendersOfMessages	"Present a menu of the currently selected message, as well as all	messages sent by it.  Open a message set browser of all senders	of the message chosen."	self hasContextSelected ifFalse: [^ self].	self withSelectorAndMessagesIn: self selectedContext method		evaluate: [:selector| self systemNavigation browseAllCallsOn: selector]! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 4/19/2025 22:17'!bugReport	^ String new: 1500 streamContents: [:stream |		self interruptedContext errorReportOn: stream]! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 4/19/2025 22:18' prior: 25347530!copyBugReportToClipboard	Clipboard clipboardText: self bugReport.! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 4/20/2025 22:03' prior: 25350278!doStep	"Send the selected message in the accessed method, and regain control 	after the invoked method returns."		| currentContext newContext |	self okToChange ifFalse: [^ self].	self interruptedProcessIsReady ifFalse: [^ self shouldNotStep].	self checkContextSelection.	currentContext := self selectedContext.	newContext := self handleLabelUpdatesIn: [interruptedProcess completeStep: currentContext]						whenExecuting: currentContext.	interruptedProcess ifNil: [^ self shouldNotStep].	(newContext == currentContext or: [self contextIsSimulationStepGuard: newContext]) ifTrue:		[newContext := self stepToStatement].	self updateProcess.	self contextStackIndex > 1		ifTrue: [self resetContext: newContext]		ifFalse:			[newContext == currentContext				ifTrue: [self changed: #contentsSelection.						self updateInspectors]				ifFalse: [self resetContext: newContext]].! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 19:14' prior: 25355210!down	"move down the context stack to the previous (enclosing) context"	self toggleContextStackIndex: self contextStackIndex + 1! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 19:14' prior: 25355800!fullStack	"Change from displaying the minimal stack to a full one."	contextStack last sender isNil		ifTrue:			["Already expanded"			self changed: #flash]		ifFalse:			[| oldContextStackIndex |			oldContextStackIndex := self contextStackIndex.			self fullyExpandStack.			oldContextStackIndex = self contextStackIndex				ifFalse:					[self toggleContextStackIndex: oldContextStackIndex]]! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 3/3/2024 00:06' prior: 25356264!handleLabelUpdatesIn: aBlock whenExecuting: aContext	"Send the selected message in the accessed method, and regain control 	after the invoked method returns."	| originalProcess |	originalProcess := Processor activeProcess.		^aBlock		on: Notification		do: [:ex|			(ex tag isArray			 and: [ex tag size = 2			 and: [(ex tag first == aContext or: [ex tag first hasSender: aContext])]])				ifTrue:					[self labelString: ex tag second description.					 ex resume]				ifFalse:					[ex pass]]				on: SimulationSideEffectWarning		do: [:ex |			ex isControlPrimitive ifTrue: [ex unsuppress].			ex resume:				"Avoid infinite recursion in Process>>effectiveProcess when debugging this warning, because the warning while the simulator was evaluating on behalf of the interrupted process."				(originalProcess					evaluate: [ex defaultAction]					onBehalfOf: nil)]! !!Debugger methodsFor: 'context stack menu' stamp: 'mt 1/23/2023 14:49' prior: 25363715!mainContextStackMenu: aMenu	"Set up the menu appropriately for the context-stack-list, unshifted"	<contextStackMenuShifted: false>	Preferences restartAlsoProceeds		ifTrue: [			aMenu				addTranslatedList: #(						('proceed top (p)' 				proceed) 					('proceed here (r)'				restart))]		ifFalse: [			aMenu				addTranslatedList: #(						('proceed (p)' 				proceed) 					('restart (r)' 				restart))].	^ aMenu		addTranslatedList: #(				-			('step into (e)' 					stepInto) 			('step over (t)' 					stepOver) 			('step through (T)'	 			stepIntoBlock) 			-			('show full stack (f)' 		showFullStack) 			('show where (w)' 			showWhere)			-			('tally it'					tally)			('peel to first like this' 		peelToFirst)  			('return entered value' 		returnValue) );		add: (self isBreakOnEntry ifTrue: ['<on>'] ifFalse: ['<off>']) , 'break on entry' translated			action: #toggleBreakOnEntry;		addTranslatedList: #(			-			('senders of    (n)' 			browseSendersOfMessages) 			('implementors of    (m)' 	browseMessages) 			('inheritance (i)' 			methodHierarchy) 			('versions (v)' 				browseVersions) 			- 			('references    (r)' 			browseVariableReferences) 			('assignments    (a)' 		browseVariableAssignments) 			- 			('class refs (N)' 				browseClassRefs) 			('browse full (b)' 			browseMethodFull) 			('file out ' 			 		fileOutMessage) 			('remove method (x) ' 		removeMessage) 			- 			('copy bug report to clipboard'	copyBugReportToClipboard));		yourself! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 4/20/2025 21:26' prior: 37237329!mainContextStackMenu: aMenu	"Set up the menu appropriately for the context-stack-list, unshifted"	<contextStackMenuShifted: false>	Preferences restartAlsoProceeds		ifTrue: [			aMenu				addTranslatedList: #(						('proceed top (p)' 				proceed) 					('proceed here (r)'				restart))]		ifFalse: [			aMenu				addTranslatedList: #(						('proceed (p)' 				proceed) 					('restart (r)' 				restart))].	aMenu		addTranslatedList: #(				-			('step into (e)' 					stepInto) 			('step over (t)' 					stepOver) 			('step through (T)'	 			stepIntoBlock)).	self showingByteCodes ifTrue:		[aMenu addTranslatedList: #(			('simulate bytecode step'		simulateStep))].	aMenu		addTranslatedList: #(			-			('show full stack (f)' 		showFullStack) 			('show where (w)' 			showWhere)			-			('tally it'					tally)			('peel to first like this' 		peelToFirst)  			('return entered value' 		returnValue) );		add: (self isBreakOnEntry ifTrue: ['<on>'] ifFalse: ['<off>']) , 'break on entry' translated			action: #toggleBreakOnEntry.		self selectedContext ifNotNil:		[:ctxt|		ctxt isClosureContext ifTrue:			[aMenu addTranslatedList: #(('select home'	selectHomeContext))]].	aMenu		addTranslatedList: #(			-			('senders of    (n)' 			browseSendersOfMessages) 			('implementors of    (m)' 	browseMessages) 			('inheritance (i)' 			methodHierarchy) 			('versions (v)' 				browseVersions) 			- 			('references    (r)' 			browseVariableReferences) 			('assignments    (a)' 		browseVariableAssignments) 			- 			('class refs (N)' 				browseClassRefs) 			('browse full (b)' 			browseMethodFull) 			('file out ' 			 		fileOutMessage) 			('remove method (x) ' 		removeMessage) 			- 			('copy bug report to clipboard'	copyBugReportToClipboard)).	^aMenu! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 19:10' prior: 25365254!peelToFirst	"Peel the stack back to the second occurance of the currently selected message.  Very useful for an infinite recursion.  Gets back to the second call so you can see one complete recursion cycle, and how it was called at the beginning.  Also frees a lot of space!!"	| ctxt |	self hasContextSelected ifFalse: [^ Beeper beep].	"self okToChange ifFalse: [^ self]."	ctxt := interruptedProcess popTo: self selectedContext findSecondToOldestSimilarSender.	self resetContext: ctxt.! !!Debugger methodsFor: 'context stack menu' stamp: 'mt 1/18/2023 13:57' prior: 25366117!proceed	"Proceed from the interrupted state of the currently selected context. The argument is the topView of the receiver. That view is closed. The active process usually suspends (or terminates) after this call."	| processToResume canResume |	Smalltalk okayToProceedEvenIfSpaceIsLow ifFalse: [^ self].		self okToChange ifFalse: [^ self].	self checkContextSelection.		processToResume := interruptedProcess.	canResume := self interruptedProcessShouldResume.		interruptedProcess := nil. "Before delete, so release doesn't terminate it"	self close.		Smalltalk installLowSpaceWatcher. "restart low space handler"		canResume		ifTrue: [self resumeProcess: processToResume]		ifFalse: [self notify: 'This process should not resume.\Debugger will close now.' translated withCRs].! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 19:11' prior: 25368793!removeMessage		| oldContext method cleanIndex  |	self okToChange ifFalse: [^ false].	self hasContextSelected ifFalse: [^ false].		oldContext := self selectedContext.	method := oldContext method.	cleanIndex := self findCleanHomeBelow: method.	contextStack at: cleanIndex ifAbsent: [		self inform: 'Sender of method not found on stack, can''t remove message'.		^ false].	self interruptedProcessIsReady ifFalse: [^ self shouldNotStep].	(self confirm: 'I will have to revert to the sender of this message.  Is that OK?')		ifFalse: [^ false].		super removeMessage ifFalse: [^ false].	self		contextStackIndex: cleanIndex oldContextWas: oldContext;		tryRestartFrom: self selectedContext.		^ true! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 19:13' prior: 25373069!returnValue	"Force a return of a given value to the previous context!!"	| previous selectedContext receiver expression value |	self hasContextSelected ifFalse: [^Beeper beep].	selectedContext := self selectedContext.	receiver := selectedContext receiver.	expression := Project uiManager request: 'Enter expression for return value:' translated.	value := receiver class evaluatorClass new		evaluate: expression		in: selectedContext		to: receiver.	previous := selectedContext sender.	self resetContext: previous.	interruptedProcess popTo: previous value: value! !!Debugger methodsFor: 'context stack menu' stamp: 'eem 9/7/2024 14:40'!selectHomeContext	| homeIndex |	homeIndex := contextStack identityIndexOf: self selectedContext home.	homeIndex > 0 ifTrue:		[self contextStackIndex: homeIndex oldContextWas: self selectedContext] ! !!Debugger methodsFor: 'context stack menu' stamp: 'jar 1/31/2023 17:58' prior: 25374299!send	"Send the selected message in the accessed method, and take control in 	the method invoked to allow further step or send."	| newContext currentContext |	self okToChange ifFalse: [^ self].	self interruptedProcessIsReady ifFalse: [^ self shouldNotStep].	self checkContextSelection.	currentContext := self selectedContext.	self handleLabelUpdatesIn:			[interruptedProcess step: currentContext]		whenExecuting: currentContext.	interruptedProcess ifNil: [^ self shouldNotStep].	newContext := interruptedProcess stepToSendOrReturn.	self updateProcess.	self contextStackIndex > 1		ifTrue: [self resetContext: newContext]		ifFalse:			[newContext == currentContext				ifTrue: [self changed: #contentsSelection.						self updateInspectors]				ifFalse: [self resetContext: newContext]]! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 4/20/2025 22:39' prior: 37243981!send	"Send the selected message in the accessed method, and take control in 	the method invoked to allow further step or send."	| newContext currentContext |	self okToChange ifFalse: [^ self].	self interruptedProcessIsReady ifFalse: [^ self shouldNotStep].	self checkContextSelection.	currentContext := self selectedContext.	self handleLabelUpdatesIn:			[interruptedProcess step: currentContext]		whenExecuting: currentContext.	interruptedProcess ifNil: [^ self shouldNotStep].	newContext := self stepToStatement.	self updateProcess.	self contextStackIndex > 1		ifTrue: [self resetContext: newContext]		ifFalse:			[newContext == currentContext				ifTrue: [self changed: #contentsSelection.						self updateInspectors]				ifFalse: [self resetContext: newContext]]! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 4/19/2025 22:18'!showBugReport	^ self bugReport editWithLabel: 'Bug report' translated! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 21:28'!simulateStep	| sender |	self okToChange ifFalse: [^ self].	self interruptedProcessIsReady ifFalse: [^ self shouldNotStep].	self checkContextSelection.	sender := self interruptedProcess suspendedContext.	self interruptedProcess		install: [sender step] asContext;		runUntil: [:ctxt | ctxt selector = #step and: [ctxt receiver == sender]].	self interruptedProcess suspendedContext 		privSender: sender;		insertSender:			[| newSender |			 newSender := thisContext pop.			 self flag: #simulateStepGuard. "marker!!"			 self flag: #knownBug. "To step forward to the next statement, you MUST press Into to step into and out of #jump, otherwise the process will terminate. Sorry for the inconvenience!! See: https://lists.squeakfoundation.org/archives/list/squeak-dev@lists.squeakfoundation.org/message/PAFVBIICFMSZWQF4GWRIM7BAWZKMD46F/"			 newSender jump] asContext.	self interruptedProcess		runUntil: [:ctxt | ctxt selector = #interpretNextInstructionFor:in:];		runUntil: [:ctxt | ctxt selector ~= #method and: [(ctxt selector beginsWith: #interpret) not]].	self resetContext: self stepToStatement.	contents := nil. self showByteCodes: false.! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 4/20/2025 21:13' prior: 25378581!stepIntoBlock	"Send messages until you return to the present method context.	 Used to step into a block in the method."	| currentContext newContext |	self okToChange ifFalse: [^ self].	self interruptedProcessIsReady ifFalse: [^ self shouldNotStep].	self checkContextSelection.	currentContext := self selectedContext.	self handleLabelUpdatesIn:			[interruptedProcess stepToHome: currentContext]		whenExecuting: self selectedContext.	interruptedProcess ifNil: [^ self shouldNotStep].	newContext := self stepToStatement.	self updateProcess.	self contextStackIndex > 1		ifTrue: [self resetContext: newContext]		ifFalse:			[newContext == currentContext				ifTrue: [self changed: #contentsSelection.						self updateInspectors]				ifFalse: [self resetContext: newContext]].! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 21:32'!stepToStatement	| context |	context := self showingByteCodes		ifTrue: [interruptedProcess suspendedContext]		ifFalse: [interruptedProcess stepToSendOrReturn].		(self contextIsSimulationStepGuard: context) ifTrue:		[context := (context tempAt: 1) ifNil: [context at: 2].		 [interruptedProcess suspendedContext == context] whileFalse: [interruptedProcess step].		 self showByteCodes: true.		 ^ self stepToStatement].		^ context! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 12/30/2023 20:17' prior: 25379954!tryRestartFrom: context	"Try to restart from the initial state of the context.	Return whether an unwind error occurred."	| actualContext unwindError |	actualContext := interruptedProcess popTo: context.	unwindError := actualContext ~= context.	unwindError ifFalse: [		actualContext := interruptedProcess restartTop; stepToSendOrReturn].	self resetContext: actualContext.	^ unwindError! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 3/3/2024 20:06' prior: 37248529!tryRestartFrom: context	"Try to restart from the initial state of the context.	Return whether an unwind error occurred."	| currentContext unwindError |	currentContext := self selectedContext.	currentContext := self		handleLabelUpdatesIn: [interruptedProcess popTo: context]		whenExecuting: currentContext.	unwindError := currentContext ~= context.	unwindError ifFalse: [		currentContext := self			handleLabelUpdatesIn: [interruptedProcess restartTop; stepToSendOrReturn]			whenExecuting: currentContext].	self resetContext: currentContext.	^ unwindError! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 4/20/2025 21:13' prior: 37249015!tryRestartFrom: context	"Try to restart from the initial state of the context.	Return whether an unwind error occurred."	| currentContext unwindError |	currentContext := self selectedContext.	currentContext := self		handleLabelUpdatesIn: [interruptedProcess popTo: context]		whenExecuting: currentContext.	unwindError := currentContext ~= context.	unwindError ifFalse: [		currentContext := self			handleLabelUpdatesIn:				[interruptedProcess restartTop.				 self stepToStatement]			whenExecuting: currentContext].	self resetContext: currentContext.	^ unwindError! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 19:15' prior: 25380408!up	"move up the context stack to the next (enclosed) context"	self contextStackIndex > 1 ifTrue:		[self toggleContextStackIndex: self contextStackIndex - 1].! !!Debugger methodsFor: 'context stack menu' stamp: 'ct 5/12/2025 19:15' prior: 25380891!where	"Select the expression whose evaluation was interrupted."	selectingPC := true.	self contextStackIndex: self contextStackIndex oldContextWas: self selectedContext.! !!Debugger methodsFor: 'toolbuilder' stamp: 'ct 4/20/2025 21:29' prior: 25405535!buildCodePaneWith: builder		| textSpec top controlButtonPane browseButtons annoSpec |	top := builder pluggablePanelSpec new.	top children: OrderedCollection new.		controlButtonPane := self buildControlButtonPaneWith: builder.	controlButtonPane frame: self controlButtonsFrame.	top children add: controlButtonPane.		self wantsOptionalButtons ifTrue: [		browseButtons := self buildOptionalButtonsWith: builder.		browseButtons frame: self optionalButtonsFrame.		top children add: browseButtons].	textSpec := builder pluggableCodePaneSpec new.	textSpec 		model: self;		getText: #contents; 		setText: #contents:notifying:; 		selection: #contentsSelection; 		menu: #codePaneMenu:shifted:;		frame: self textFrame.	top children add: textSpec.	self wantsAnnotationPane ifTrue: [		annoSpec := self buildAnnotationPaneWith: builder.		annoSpec frame: self annotationFrame.		top children add: annoSpec].	.	^ top! !!Debugger methodsFor: 'toolbuilder' stamp: 'ct 4/20/2025 21:30'!buildControlButtonPaneWith: builder	^ builder pluggablePanelSpec new		model: self;		children: #buildControlButtons;		layout: #horizontal;		yourself! !!Debugger methodsFor: 'toolbuilder' stamp: 'ct 4/20/2025 21:28'!buildControlButtons	^ self buildControlButtonsWith: ToolBuilder default! !!Debugger methodsFor: 'toolbuilder' stamp: 'ct 4/20/2025 21:30' prior: 25407189!buildControlButtonsWith: builder	^ self customButtonSpecs		