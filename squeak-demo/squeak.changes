itDo: aBlock	self queryState ensureReplacement: aClass for: self embed: aCollection initDo: aBlock! !!PNode methodsFor: 'query actions'!ensureReplacement: aClass initDo: aBlock	self queryState ensureReplacement: aClass for: self embed: [:m | {}] initDo: aBlock! !!PNode methodsFor: 'as yet unclassified'!field	^ field! !!PNode methodsFor: 'as yet unclassified'!field: aString	field := aString! !!PNode methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:55'!firstChildrenInRange: aRange do: aBlock	(aRange containsRange: self range)		ifTrue: [aBlock value: self]		ifFalse: [self baseChildren do: [:c | c firstChildrenInRange: aRange do: aBlock]]! !!PNode methodsFor: 'as yet unclassified'!fixedNumberOfChildren	^ false! !!PNode methodsFor: 'as yet unclassified'!generatedSourceString	^ String streamContents: [:s | self writeSourceOn: s indent: 0 forCompare: false]! !!PNode methodsFor: 'grammar'!grammarRule	^ (self language grammarRule: self type) ifNil: [self resolveAlias: self type in: self owner grammarRule]! !!PNode methodsFor: 'hierarchy'!hasAnyParent: aBlock	| p |	self isRootBlock ifTrue: [^ false].		p := self parent.	p ifNil: [		self assert: self type = 'ERROR'.		^ false].		p = aBlock ifTrue: [^ true].		^ p hasAnyParent: aBlock! !!PNode methodsFor: 'hierarchy'!hasParent: aCollectionOrSymbol	| matches |	self isRootBlock ifTrue: [^ false].		matches := aCollectionOrSymbol isSymbol		ifTrue: [{aCollectionOrSymbol}]		ifFalse: [aCollectionOrSymbol].	^ matches includes: self parent type! !!PNode methodsFor: 'as yet unclassified'!highlight	^ highlight ifNil: [self updateAllHighlights]! !!PNode methodsFor: 'as yet unclassified'!highlight: aString	highlight := aString! !!PNode methodsFor: 'as yet unclassified'!indentFor: aBlock current: aNumber	^ (self language indentMatch: aBlock)		ifTrue: [aNumber + 1]		ifFalse: [aNumber]! !!PNode methodsFor: 'as yet unclassified'!infoForEditDo: aClosure	| oldCursor