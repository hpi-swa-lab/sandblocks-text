ockingBar := (self currentWorld mainDockingBars ifEmpty: [^ self]) first.	menu := (dockingBar submorphs select: #isMenuItemMorph) detect: menuBlock ifNone: [^ self].	dockingBar selectItem: menu event: self currentEvent.	menu subMenu setProperty: #matchString toValue: filterString.	menu subMenu displayFiltered: self currentEvent.	^ nil "do not answer a Behavior here, which would trigger another browser when sending this message from a TextURL"! !TestCase subclass: #FinalizationRegistryTest	instanceVariableNames: 'finalizationRegistry finalizerThatSignals finalizerFired finalizerThatRaisesError'	classVariableNames: ''	poolDictionaries: ''	category: 'Tests-Finalization'!!FinalizationRegistryTest methodsFor: 'helpers' stamp: 'eem 2/20/2025 14:53'!closeAllDebuggersSuchThat: aBlock	Project current world submorphs do:		[:morph|		(morph isSystemWindow		and: [(morph model isKindOf: Debugger)		and: [aBlock value: morph]]) ifTrue:			[morph delete]]! !!FinalizationRegistryTest methodsFor: 'helpers' stamp: 'JMM 11/29/2024 15:00:32'!triggerFinalization	| x | 		x := (Interval from: 1 to: 100000) asOrderedCollection.	x := nil.	Smalltalk garbageCollect.	Smalltalk garbageCollectMost.	Smalltalk garbageCollect.! !!FinalizationRegistryTest methodsFor: 'running' stamp: 'eem 12/18/2024 20:44:35'!setUp	super setUp.	finalizationRegistry := FinalizationRegistry new.	finalizerFired := false.	finalizerThatSignals := ObjectFinalizer new receiver: [		finalizerFired := true ] selector: #value.	finalizerThatRaisesError := ObjectFinalizer new receiver: [ 		Error signal ] selector: #value.! !!FinalizationRegistryTest methodsFor: 'tests' stamp: 'JMM 11/28/2024 11:20:54'!testAddGC	| x |		x := Object new.	finalizationRegistry add: x.	self assert: (finalizationRegistry size = 1).	self assert: (finalizationRegistry isEmpty not).	x := nil.	self triggerFinalization.	self assert: (finalizationRegistry size = 0).	self assert: (finalizationRegistry isEmpty).! !!FinalizationRegistryTest methodsFor: 'tests' stamp: 'JMM 11/29/2024 08:28:48'!testDo	| x |		x := Object new.	finalizationRegistry add: x.	self assert: finalizationRegistry size = 1.	finalizationRegistry keysDo: [:v | self assert: v = x]! !!FinalizationRegistryTest methodsFor: 'tests' stamp: 'JMM 12/6/2024 10:39:00'!testEKeyDictionary		| d x |	d := EphemeronIdentityDictionary new.	x := Object new.	d at: x put: 5.	x := nil.	self triggerFinalization.	self assert: d isEmpty! !!FinalizationRegistryTest methodsFor: 'tests' stamp: 'eem 2/20/2025 14:45'!testFinalizationWithError	| reference |	finalizationRegistry		add: Object new		executor: finalizerThatRaisesError.	finalizationRegistry		add: (reference := Object new)		executor: finalizerThatSignals.	self triggerFinalization.	self deny: finalizerFired.	reference := nil.	self triggerFinalization.	self assert: finalizerFired.	Project current addDeferredUIMessage:		[self closeAllDebuggersSuchThat:			[:dbgWindow| '*Ephemeron Mourning*' match: dbgWindow label]]! !!FinalizationRegistryTest methodsFor: 'tests' stamp: 'JMM 11/29/2024 08:34:57'!testLegacy 	| x |		x := Object new.	finalizationRegistry add: x.	x := nil.	finalizationRegistry finalizeValues! !!FinalizationRegistryTest methodsFor: 'tests' stamp: 'JMM 12/6/2024 14:47:26'!testRemove	| x |		x := Object new.	finalizationRegistry add: x.	self assert: finalizationRegistry size = 1.	finalizationRegistry removeKey: x ifAbsent: [self assert: false].	finalizationRegistry removeKey: x ifAbsent: [^self assert: true].	self assert: false.! !!FinalizationRegistryTest methodsFor: 'tests' stamp: 'JMM 11/29/2024 08:52:39'!testRemoveAll	| x y |		x := Object new.	finalizationRegistry add: x.	y := Object new.	finalizationRegistry add: y.	self assert: finalizationRegistry size = 2.	finalizationRegistry removeAll.	self assert: finalizationRegistry size = 0.! !!FinalizationRegistryTest methodsFor: 'tests' stamp: 'JMM 11/29/2024 08:49:29'!testkey	| x |		x := Object new.	finalizationRegistry add: x.	self assert: finalizationRegistry size = 1.	self assert: (finalizationRegistry keys size = 1).	finalizationRegistry keys do: [:k | self assert: k = x].	! !EToyProjectDetailsMorph subclass: #EToyProjectQueryMorph	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Etoys-Experimental'!!EToyProjectQueryMorph methodsFor: 'Squeakland-query' stamp: 'sw 9/25/2009 15:36' prior: 27007112!carryOutQuery: details onProjectServer: aProjectServer	"The user submitted a query; the parameter holds the details dictionary.  Carry out the query."	| criteria clean |	criteria := OrderedCollection new.	details keysAndValuesDo:		[ :k :v |			(clean := v withBlanksTrimmed convertToEncoding: SuperSwikiServer defaultEncodingName) isEmpty						ifFalse: [criteria add: k,': *',clean,'*']].	aProjectServer queryProjectsAndShow: criteria! !GZipReadStream class	instanceVariableNames: ''!!GZipReadStream class methodsFor: 'fileIn/Out' stamp: 'ct 9/8/2022 19:30' prior: 30985524!fileReaderServicesForFile: fullName suffix: suffix 	| services |	(suffix = 'gz') | (suffix = '*')		ifFalse: [^ #()].	services := OrderedCollection new.	(suffix = '*') | (fullName asLowercase endsWith: '.cs.gz') | (fullName asLowercase endsWith: '.mcs.gz')		ifTrue: [services add: self serviceFileIn.			(Smalltalk includesKey: #ChangeSet)				ifTrue: [services add: self serviceFileIntoNewChangeSet]].	services addAll: self services.	^ services! !Quadrangle class	instanceVariableNames: ''!!Quadrangle class methodsFor: '*Etoys-instance creation' stamp: 'sw 5/4/2001 17:12' prior: 66563581!exampleInViewer	"Create a sample Quadrangle and open a Viewer on it"	(self region: (100@100 extent: 100@50) borderWidth: (1 + (6 atRandom)) borderColor: Color black insideColor: (Color perform: #(green red blue yellow) atRandom)) beViewed"Quadrangle exampleInViewer"! !TestCase subclass: #RxMatcherTest	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Regex-Tests-Core'!!RxMatcherTest methodsFor: 'utilties' stamp: 'MarcusDenker 4/29/2013 17:13' prior: 84716719!compileRegex: aString	"Compile the regex and answer the matcher, or answer nil if compilation fails."	| syntaxTree |	syntaxTree := RxParser safelyParse: aString.	^ syntaxTree isNil ifFalse: [ self matcherClass for: syntaxTree ]! !!RxMatcherTest methodsFor: 'utilties' stamp: 'ct 10/20/2021 20:24' prior: 84717031!runMatcher: aMatcher with: aString expect: aBoolean withSubexpressions: anArray	| copy got |	copy := aMatcher		copy: aString		translatingMatchesUsing: [ :each | each ].	self 		assert: copy = aString		description: 'Copying: expected ' , aString printString , ', but got ' , copy printString.	got := aMatcher search: aString.	self		assert: got = aBoolean 		description: 'Searching: expected ' , aBoolean printString , ', but got ' , got printString.	(anArray isNil or: [ aMatcher supportsSubexpressions not ])		ifTrue: [ ^ self ].	1 to: anArray size by: 2 do: [ :index |		| sub subExpect subGot |		sub := anArray at: index.		subExpect := anArray at: index + 1.		subGot := (subExpect isNil or: [subExpect isString])			ifTrue: [aMatcher subexpression: sub]			ifFalse: [aMatcher subexpressions: sub].		self			assert: subExpect = subGot			description: 'Subexpression ' , sub printString , ': expected ' , subExpect printString , ', but got ' , subGot printString ]! !!RxMatcherTest methodsFor: 'utilties' stamp: 'ul 8/23/2015 15:06' prior: 84719019!runRegex: anArray	"Run a clause anArray against a set of tests. Each clause is an array with a regex source string followed by sequence of 3-tuples. Each three-element group is one test to try against the regex, and includes: 1) test string; 2) expected result; 3) expected subexpression as an array of (index, substring), or nil."	| source matcher |	source := anArray first.	matcher := self compileRegex: source.	matcher isNil		ifTrue: [			(anArray at: 2) isNil				ifFalse: [ self signalFailure: 'Compilation failed, should have succeeded: ' , source printString ] ]		ifFalse: [			(anArray at: 2) isNil				ifTrue: [ self signalFailure: 'Compilation succeeded, should have failed: ' , source printString ]				ifFalse: [					anArray allButFirst groupsDo: [ :input :shouldMatch :expectedOutput |						self 							runMatcher: matcher							with: input							expect: shouldMatch							withSubexpressions: expectedOutput ] ] ]! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84720037!henryReadme	self error: 'The tests in this category are based on the ones in Henry Spencer''s regexp.c package.'! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84720227!testHenry001	self runRegex: #('abc'		'abc' true (1 'abc')		'xbc' false nil		'axc' false nil		'abx' false nil		'xabcy' true (1 'abc')		'ababc' true (1 'abc'))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84720468!testHenry002	self runRegex: #('ab*c'		'abc' true (1 'abc'))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84720606!testHenry003	self runRegex: #('ab*bc'		'abc' true (1 'abc')		'abbc' true (1 'abbc')		'abbbbc' true (1 'abbbbc'))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84720799!testHenry004	self runRegex: #('ab+bc'			'abbc' true (1 'abbc')		'abc' false nil		'abq' false nil		'abbbbc' true (1 'abbbbc'))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84721006!testHenry005	self runRegex: #('ab?bc'		'abbc' true (1 'abbc')		'abc' true (1 'abc')		'abbbbc' false nil		'abc' true (1 'abc'))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84721214!testHenry006	self runRegex: #('^abc$'		'abc' true (1 'abc')		'abcc' false nil		'aabc' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84721391!testHenry007	self runRegex: #('^abc'		'abcc' true (1 'abc'))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84721530!testHenry008	self runRegex: #('abc$'		'aabc' true (1 'abc'))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84721669!testHenry009	self runRegex: #('^'		'abc' true nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84721798!testHenry010	self runRegex: #('$'		'abc' true nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84721927!testHenry011	self runRegex: #('a.c'		'abc' true (1 'abc')		'axc' true (1 'axc'))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84722087!testHenry012	"Need to get creative to include the null character..."	self runRegex: #('a.*c'			'axyzc' true (1 'axyzc')		'axy zc' true (1 'axy zc') "testing that a dot matches a space"		), (Array with: 'axy', (String with: 0 asCharacter), 'zc'), #(false nil "testing that a dot does not match a null"		'axyzd' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84722490!testHenry013	self runRegex: #('.a.*'		'1234abc' true (1 '4abc')		'abcd' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84722652!testHenry014	self runRegex: #('a\w+c'		' abbbbc ' true (1 'abbbbc')		'abb bc' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84722820!testHenry015	self runRegex: #('\w+'		'  	foobar	quux' true (1 'foobar')		' 	~!!@#$%^&*()-+=\|/?.>,<' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84723011!testHenry016	self runRegex: #('a\W+c'		'a   c' true (1 'a   c')		'a bc' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84723173!testHenry017	self runRegex: #('\W+'		'foo!!@#$bar' true (1 '!!@#$')		'foobar' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84723341!testHenry018	self runRegex: #('a\s*c'		'a   c' true (1 'a   c')		'a bc' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84723503!testHenry019	self runRegex: #('\s+'		'abc3457 sd' true (1 ' ')		'1234$^*^&asdfb' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84723674!testHenry020	self runRegex: #('a\S*c'		'aqwertyc' true (1 'aqwertyc')		'ab c' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84723842!testHenry021	self runRegex: #('\S+'		'     	asdf		' true (1 'asdf')		' 				' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84724010!testHenry022	self runRegex: #('a\d+c'		'a0123456789c' true (1 'a0123456789c')		'a12b34c' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84724189!testHenry023	self runRegex: #('\d+'		'foo@#$%123ASD #$$%^&' true (1 '123')		'foo!!@#$asdfl;' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84724372!testHenry024	self runRegex: #('a\D+c'		'aqwertyc' true (1 'aqwertyc')		'aqw6ertc' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84724544!testHenry025	self runRegex: #('\D+'		'1234 abc 456' true (1 ' abc ')		'1234567890' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84724717!testHenry026	self runRegex: #('(f|o)+\b'		'foo' true (1 'foo')		' foo ' true (1 'foo'))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'lr 1/15/2010 19:46' prior: 84724884!testHenry027	self runRegex: #('\ba\w+' "a word beginning with an A