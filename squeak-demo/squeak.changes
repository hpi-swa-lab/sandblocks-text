efinition := aDefinition! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:49'!editor	^ editor! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:49'!editor: anEditor	editor := anEditor! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 17:51'!initialize	super initialize.		self		hResizing: #shrinkWrap;		vResizing: #shrinkWrap;		color: Color transparent;		changeTableLayout! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 10:47'!localIndex: aNumber in: aShard	| index |	index := aNumber.	aShard replacements do: [:replacement |		(self ~= replacement and: [replacement range first <= index]) ifTrue: [" subtract the replaced range but add 1 for the startOfHeader character "		index := index - replacement range size + 1]].	index := index - aShard range first.	^ index! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:26'!localRangeIn: aShard do: aBlock	aBlock		value: (self localIndex: self range first in: aShard) + 1		value: (self localIndex: self range last in: aShard)! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:30'!node	^ node! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:30'!node: aNode	node := aNode! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:01'!range	^ self editor adjustRange: node range! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:06'!sourceString	^ self node sourceString! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 14:26'!beforeUninstall	delete valueWithEnoughArguments: {node. self}! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 14:25'!init: aBlock update: anotherBlock	self init: aBlock update: anotherBlock delete: []! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 14:25'!init: aBlock update: anotherBlock delete: aThirdBlock	init := aBlock.	update := anotherBlock.	delete := aThirdBlock! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:41'!initialize	super initialize.		didInit := false! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:42'!node: aNode	super node: aNode.		didInit ifFalse: [		init valueWithEnoughArguments: {aNode. self}.		didInit := true].	update valueWithEnoughArguments: {aNode. self}! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 10:27'!adjustGlobalIndex: aNumber	| index |	index := aNumber.	self replacements do: [:replacement |		replacement range first < index ifTrue: [			" subtract the replaced range but add 1 for the startOfHeader character "			index := index - replacement range size + 1]].	index := index - self range first.	^ index! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 10:59'!adjustLocalIndex: aNumber	| index |	index := aNumber + self range first.	self replacements do: [:replacement |		replacement range first < index ifTrue: [			" add the replaced range but subtract 1 for the startOfHeader character "			index := index + replacement range size - 1]].	^ index! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/20/2024 08:17'!allVisibleNodesDo: aBlock root: aRoot	| replaced |	replaced := Array streamContents: [:s | self replacements do: [:r | r definition model = aRoot language ifTrue: [s nextPut: r node]]].		self nodes first language = aRoot language		ifTrue: [self nodes do: [:root | root allVisibleNodesDo: aBlock hidden: replaced]]		ifFalse: [aRoot firstChildrenInRange: self range do: [:root | root allVisibleNodesDo: aBlock hidden: replaced]]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:37'!applyChanges: aCollection editScript: aScript	self updateReplacementsFor: aScript! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:45'!applyRejectedChanges: aCollection	self updateText! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 16:17'!basicApplyChanges: aCollection editScript: aScript	self halt.	(aCollection reject: [:change | change sourceShard = self]) do: [:change |		view handleEdit: [			view				selectInvisiblyFrom: (self adjustGlobalIndex: change from) + 1					to: (self adjustGlobalIndex: change to);				replaceSelectionWith: (change insert ifNil: [''])]]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 08:10'!editor	^ editor! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:06'!editor: anEditor	anEditor shards add: self.	editor := anEditor.		anEditor ensureModels: self requiredModels! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:06'!extensions: aBlock	extensions := aBlock.		editor ifNotNil: [editor ensureModels: self requiredModels]! !!PShard methodsFor: 'utils' stamp: 'tobe 4/13/2024 08:29'!findChange: aString b: anotherString preferredPos: preferredPos preferredSide: preferredSide	| diff |	diff := self findDiff: aString b: anotherString preferredPos: preferredPos preferredSide: preferredSide.	diff ifNil: [^ nil].		^ ((diff at: #from) = (diff at: #toB)		ifTrue: [			{				#delete -> (aString copyFrom: (diff at: #from) to: (diff at: #toA) - 1).				#from -> (diff at: #from).				#to -> (diff at: #toA)}]		ifFalse: [			{				#insert -> (anotherString copyFrom: (diff at: #from) to: (diff at: #toB) - 1).				#from -> (diff at: #from).				#to -> (diff at: #toA)}]) as: Dictionary! !!PShard methodsFor: 'utils' stamp: 'tobe 4/13/2024 08:29'!findDiff: aString b: anotherString preferredPos: myPreferredPos preferredSide: preferredSide	| minLen from toA toB adjust move preferredPos |	"copied from codemirror: detect the change between to strings at the cursor position.	`preferredSide` should be 'end' if backspace was pressed"	preferredPos := myPreferredPos.	minLen := aString size min: anotherString size.	from := 1.	[from <= minLen and: [(aString at: from) = (anotherString at: from)]] whileTrue: [from := from + 1].	(from = minLen and: [aString size = anotherString size]) ifTrue: [^ nil].	toA := aString size + 1.	toB := anotherString size + 1.	[(toA > 1 and: [toB > 1]) and: [(aString at: toA - 1) = (anotherString at: toB - 1)]] whileTrue: [		toA := toA - 1.		toB := toB - 1].		preferredSide = #end ifTrue: [		adjust := from - (toA min: toB) max: 0.		preferredPos := preferredPos - (toA + adjust - from)].		(toA < from and: [aString size < anotherString size])		ifTrue: [			move := (preferredPos <= from and: [preferredPos >= toA])				ifTrue: [from - preferredPos]				ifFalse: [0].			from := from - move.			toB := from + (toB - toA).			toA := from]		ifFalse: [			toB < from ifTrue: [				move := (preferredPos <= from and: [preferredPos >= toB])					ifTrue: [from - preferredPos]					ifFalse: [0].				from := from - move.				toA := from + (toA - toB).				toB := from]].	^ {#from -> from. #toA -> toA. #toB -> toB} as: Dictionary! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 17:40'!initialize	super initialize.		replacements := SortedCollection sortBlock: [:a :b | a range first < b range first].	attributes := OrderedCollection new.	extensions := [{}].		self		addMorph: (view := PluggableTextMorphPlus new			setSelection: (0 to: 0);			model: self;			editTextSelector: #onChange:;			setText: '';			hResizing: #shrinkWrap;			vResizing: #shrinkWrap;			yourself);		changeTableLayout;		color: Color transparent;		hResizing: #shrinkWrap;		vResizing: #shrinkWrap! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/15/2024 14:14'!installReplacement: aReplacementDefinition for: aNode	| replacement |	" if we contain another replacement, uninstall that replacement first "	self replacements copy do: [:r | (r node hasAnyParent: aNode) ifTrue: [self uninstallReplacement: r]].		replacement := aReplacementDefinition buildReplacement		definition: aReplacementDefinition;		editor: self editor;		node: aNode.		replacements add: replacement! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/15/2024 14:08'!isShowing: aNode	(self nodes anySatisfy: [:node | aNode hasAnyParent: node]) ifFalse: [^ false].		self replacements do: [:r | (aNode hasAnyParent: r node) ifTrue: [^ false]].		^ true! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/15/2024 16:56'!isShowingIndex: aNumber	(self range includes: aNumber) ifFalse: [^ false].		self replacements do: [:r | (r range containsIndex: aNumber) ifTrue: [^ false]].		^ true! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 08:10'!nodes	^ nodes! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 20:51'!nodes: aCollection	nodes := aCollection.		lastActualSourceString ifNil: [		self editor models keysAndValuesDo: [:model :root |			self				updateReplacementsFor: (PEditScript new					initPos: (Array streamContents: [:s | root firstChildrenInRange: self range do: [:node | s nextPutAll: node initOperations]])					neg: {})				root: root].		self updateText]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:01'!onChange: aNewString	| change |	change := self		findChange: lastActualSourceString		b: aNewString string		preferredPos: self editor selectionRange first		preferredSide: nil.		((change includesKey: #delete) and: [(change at: #delete) = Character startOfHeader asString])		ifTrue: [ | replacement |			replacement := self replacementForStartIndex: (self adjustLocalIndex: (change at: #from) - 1).			self editor applyChanges: {				(PChange range: (replacement range last - 1 to: replacement range last) insert: '')					sourceShard: self;					sideAffinity: ((change at: #from) = 1 ifTrue: [1] ifFalse: [-1])}]		ifFalse: [			self editor applyChanges: {				(PChange					range: ((self adjustLocalIndex: (change at: #from) - 1) to: (self adjustLocalIndex: (change at: #to) - 1))					insert: (change at: #insert ifAbsent: ['']) string)					sourceShard: self;					sideAffinity: ((self isShowingIndex: (change at: #from) - 1)						ifTrue: [-1]						ifFalse: [1])}]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:51'!range	^ self editor adjustRange: (PRange indexStart: self nodes first range first end: self nodes last range last)! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:15'!replacementForStartIndex: aNumber	^ self replacements detect: [:r | r range first = aNumber]! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/13/2024 10:23'!replacements	^ replacements! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:07'!requiredModels	^ (extensions value gather: [:ext | (ext markerDefinitions collect: #model), (ext replacementDefinitions collect: #model)]) asSet! !!PShard methodsFor: 'marker api' stamp: 'tobe 4/17/2024 11:49'!styleAdd: anAttribute for: aNode definition: aDefinition	^ attributes add: (PMarker new		definition: aDefinition;		node: aNode;		attribute: anAttribute)! !!PShard methodsFor: 'marker api' stamp: 'tobe 4/17/2024 11:49'!styleRemove: aMarker	attributes remove: aMarker! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/20/2024 08:14'!uninstallReplacement: aReplacement	aReplacement beforeUninstall.		replacements remove: aReplacement! !!PShard methodsFor: 'replacements' stamp: 'tobe 12/8/2025 20:15'!updateReplacementsFor: anEditScript root: aRoot	anEditScript removeDo: [:op |		self replacements detect: [:r | op node = r node] ifFound: [:r | self uninstallReplacement: r].		attributes do: [:attr | op node = attr node ifTrue: [attr definition detach value: self value: op node value: attr]]].		extensions value do: [:ext |		(ext replacementDefinitions select: [:def | def model = aRoot language]) do: [:def |			self				allVisibleNodesDo: [:node | | matches |					matches := (PQuery script: def query with: node) notNil.					self replacements						detect: [:r | r definition name = def name and: [node = r node]]						ifFound: [:r | matches ifFalse: [self uninstallReplacement: r]]						ifNone: [matches ifTrue: [self installReplacement: def for: node]]]				root: aRoot]].		extensions value do: [:ext |		(ext markerDefinitions select: [:def | def model = aRoot language]) do: [:def |			self				allVisibleNodesDo: [:node | | matches |					matches := (PQuery script: def query with: node) notNil.					attributes						detect: [:attr | attr definition name = def name and: [node = attr node]]						ifFound: [:attr | matches ifFalse: [def detach value: self value: node value: attr]]						ifNone: [matches ifTrue: [def attach value: self value: node]]]				root: aRoot]]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:55'!updateText	| out myRange |	out := (self nodes inject: '' into: [:text :node | text, node sourceString]) asText.		self editor pendingChanges withIndexDo: [:change :index |		myRange := PRange			indexStart: (self editor				adjustIndex: self nodes first range first				forChangeList: self editor pendingChanges				upTo: index - 1				sideAffinity: 1)			end: (self editor				adjustIndex: self nodes last range last				forChangeList: self editor pendingChanges				upTo: index - 1				sideAffinity: -1).				" TODO: show subrange if intersects "		(myRange includesChange: change) ifTrue: [			self				updateText: out				replaceFrom: change from - myRange first + 1				to: change to - myRange first				with: change insert]].		myRange := PRange		indexStart: (self editor			adjustIndex: self nodes first range first			forChangeList: self editor pendingChanges			sideAffinity: 1)		end: (self editor			adjustIndex: self nodes last range last			forChangeList: self editor pendingChanges			sideAffinity: -1).	attributes do: [:marker |		out			addAttribute: marker attribute			from: marker node range first - myRange first + 1			to: marker node range last - myRange first].		replacements do: [:r |		r localRangeIn: self do: [:from :to |			out				replaceFrom: from				to: to				with: (Text string: Character startOfHeader asString attribute: r asTextAnchor)]].		view setText: out.	lastActualSourceString := out string! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 09:44'!updateText: aText replaceFrom: aNumber to: anotherNumber with: aStringOrNil	aNumber <= aText size		ifTrue: [aText replaceFrom: aNumber to: anotherNumber with: (aStringOrNil ifNil: [''])]		ifFalse: [			self assert: (aNumber = (aText size + 1) and: [anotherNumber = (aText size)]).			aText append: (aStringOrNil ifNil: [''])]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:03'!view	^ view! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:22'!testApplyChange	| e |	e := PEditorState new.		e sourceString: 'abc'.		e applyChanges: {PChange range: (1 to: 1) insert: '1'}.	self assert: 'a1bc' equals: e rootShard view text string.		e applyChanges: {PChange range: (1 to: 1) insert: '2'}.	self assert: 'a21bc' equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:40'!testApplyChangeInReplacement	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123'.	self assert: Character startOfHeader asString equals: e rootShard view text string.		e applyChanges: {PChange range: (1 to: 1) insert: '4'}.	self assert: Character startOfHeader asString equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:40'!testApplyChangeInReplacementRemovesIt	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123'.	e applyChanges: {PChange range: (0 to: 0) insert: 'a'}.	self assert: 'a123' equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:23'!testApplyRejectedChange	| e |	e := PEditorState new.	e registerValidation: [:root :change :diff | false] for: PBaseParser.	e sourceString: '123'.		e applyChanges: {PChange range: (0 to: 0) insert: 'a'}.	self assert: 'a123' equals: e rootShard view text string.	self assert: '123' equals: e sourceString.		e applyPendingChanges.	self assert: 'a123' equals: e rootShard view text string.	self assert: 'a123' equals: e sourceString! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:40'!testBackspaceIntoReplacementCharacter	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		deletionInteraction: #character;		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '12'.		e rootShard onChange: ''.	self assert: Character startOfHeader asString equals: e rootShard view text string.	self assert: '1' equals: e sourceString.		e rootShard onChange: ''.	self assert: '' equals: e rootShard view text string.	self assert: '' equals: e sourceString! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testEmbeddedShard	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		query: {[:x | x type = #number]. [:x | x parent type = #array]};		model: PSmalltalkParser;		init: [:node :replacement | | s |				s := replacement setProperty: #s toValue: replacement createShard.				replacement addMorphBack: s]			update: [:node :replacement | (replacement valueOfProperty: #s) nodes: {node}]).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.		self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testEnterChangeAtStart	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123'.		e rootShard onChange: 'a', Character startOfHeader asString.	self assert: 'a123' equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 9/26/2024 13:23'!testFindChange	| change |	change := PShard new findChange: 'ab' b: 'acb' preferredPos: 1 preferredSide: nil.	self assert: ({#from -> 2. #to -> 2. #insert -> 'c'} as: Dictionary) equals: change! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 9/26/2024 13:23'!testFindChangeAtEnd	| change |	change := PShard new findChange: 'ab' b: 'abc' preferredPos: 1 preferredSide: nil.	self assert: ({#from -> 3. #to -> 3. #insert -> 'c'} as: Dictionary) equals: change! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 9/26/2024 13:23'!testFindChangeDelete	| change |	change := PShard new findChange: 'acb' b: 'ab' preferredPos: 1 preferredSide: nil.	self assert: ({#from -> 2. #to -> 3. #delete -> 'c'} as: Dictionary) equals: change! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 9/26/2024 13:23'!testFindChangeDeleteAtEnd	| change |	change := PShard new findChange: 'abc' b: 'ab' preferredPos: 1 preferredSide: nil.	self assert: ({#from -> 3. #to -> 4. #delete -> 'c'} as: Dictionary) equals: change! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testMarker	| e testExt attr |	attr := TextColor red.	testExt := PExtension new registerMarker: (PMarkerDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]};		style: attr).		e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: 'a+12'.		self assert: {attr} equals: (e rootShard view text attributesAt: 3).	self assert: {attr} equals: (e rootShard view text attributesAt: 4)! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testMultipleReplacements	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123+456'.	self		assert: Character startOfHeader asString, '+', Character startOfHeader asString		equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testOverlappingReplacements	| e testExt |	testExt := PExtension new		registerReplacement: (PReplacementDefinition new			name: 'test';			model: PSmalltalkParser;			query: {[:x | x type = #number]});		registerReplacement: (PReplacementDefinition new			name: 'test2';			model: PSmalltalkParser;			query: {[:x | x type = #array]}).		e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.		self assert: 1 equals: e rootShard replacements size.	self assert: Character startOfHeader asString equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:24'!testRejectChange	| e |	e := PEditorState new.	e registerValidation: [:root :change :diff | false] for: PBaseParser.	e sourceString: '123'.		e applyChanges: {PChange range: (0 to: 0) insert: 'a'}.	self assert: 'a123' equals: e rootShard view text string.	self assert: '123' equals: e sourceString! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRejectChangeAndEdit	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]. [:x | x parent type = #array]};		init: [:node :replacement | | s2 s1 |				s1 := replacement setProperty: #s1 toValue: replacement createShard.				s2 := replacement setProperty: #s2 toValue: replacement createShard.				replacement addMorphBack: s1.				replacement addMorphBack: s2]			update: [:node :replacement |				(replacement valueOfProperty: #s1) nodes: {node}.				(replacement valueOfProperty: #s2) nodes: {node}]).		e := PEditorState new.	e registerValidation: [:node :changes :script | false] for: PBaseParser.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.		self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.		e applyChanges: {(PChange range: (3 to: 3) insert: '3') sideAffinity: -1}.	self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.		self assert: 1 equals: e rootShard replacements size.	self assert: 3 equals: e shards size.	self		assert: {'123'. '123'}		equals: ((e shards reject: [:s | s = e rootShard]) collect: [:s | s view text string] as: Array)! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRejectResetsIndizes	| e |	e := PEditorState new.	e models at: PSmalltalkParser put: nil.	e registerValidation: [:node :changes :script | false] for: PBaseParser.	e sourceString: '12'.		e applyChanges: {PChange range: (2 to: 2) insert: '3'}.	self		assert: (PRange indexStart: 0 end: 2)		equals: (e models at: PSmalltalkParser) baseChildren first baseChildren first range! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRejectedChangeAffinity	| e testExt nestedShard |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]. [:x | x parent type = #array]};		init: [:node :replacement | replacement addMorphBack: (replacement setProperty: #s1 toValue: replacement createShard)]			update: [:node :replacement | (replacement valueOfProperty: #s1) nodes: {node}]).		e := PEditorState new.	e registerValidation: [:node :changes :script | false] for: PBaseParser.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.	nestedShard := e shards detect: [:s | s ~= e rootShard].		self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.		nestedShard onChange: '123'.	self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.	self assert: '123' equals: nestedShard view text string.		e rootShard onChange: '[', Character startOfHeader, '4]'.	self assert: '[', Character startOfHeader, '4]' equals: e rootShard view text string.	self assert: '123' equals: nestedShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRejectedChangesIndex	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]. [:x | x parent type = #array]};		init: [:node :replacement | | s2 s1 |				s1 := replacement setProperty: #s1 toValue: replacement createShard.				s2 := replacement setProperty: #s2 toValue: replacement createShard.				replacement addMorphBack: s1.				replacement addMorphBack: s2]			update: [:node :replacement |				(replacement valueOfProperty: #s1) nodes: {node}.				(replacement valueOfProperty: #s2) nodes: {node}]).		e := PEditorState new.	e registerValidation: [:node :changes :script | false] for: PBaseParser.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.		self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.		e applyChanges: {PChange range: (1 to: 1) insert: '3'}.	self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.	self		assert: {'312'. '312'}		equals: ((e shards reject: [:s | s = e rootShard]) collect: [:s | s view text string] as: Array).		e applyChanges: {(PChange range: (4 to: 4) insert: '4') sideAffinity: -1}.	self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.	self		assert: {'3124'. '3124'}		equals: ((e shards reject: [:s | s = e rootShard]) collect: [:s | s view text string] as: Array)! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRemoveIndent	| removeIndentExt testExt e |	removeIndentExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'indent';		model: PWhitespaceParser;		query: {[:x | x type = #tab and: [x childBefore type = #newline]]};		init: [:node :replacement | replacement extent: 0 @ 0] update: [:node :replacement | ]).	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #program]};		init: [:node :replacement | replacement addMorphBack: (replacement createShard extensions: [{removeIndentExt}])]			update: [:node :replacement | replacement firstSubmorph nodes: {node queryFirst: '(method_definition) @'}]).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: 'class A {	constructor() {		console.log("b");	}}'! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:27'!testRevertRejectedChange	| e |	e := PEditorState new.	e registerValidation: [:root :change :diff | false] for: PBaseParser.	e sourceString: '123'.		e applyChanges: {PChange range: (0 to: 0) insert: 'a'}.	self assert: 'a123' equals: e rootShard view text string.	self assert: '123' equals: e sourceString.		e revertPendingChanges.	self assert: '123' equals: e rootShard view text string.	self assert: '123' equals: e sourceString! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testToggleReplacement	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123'.		e rootShard onChange: 'a', Character startOfHeader asString.	self assert: 'a123' equals: e rootShard view text string.		e rootShard onChange: '123'.	self assert: Character startOfHeader asString equals: e rootShard view text string.		e rootShard onChange: 'a', Character startOfHeader asString.	self assert: 'a123' equals: e rootShard view text string! !!PBaseParser class methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:21'!parse: aString old: aNode	| doc |	doc := PNode new		type: 'document';		language: self;		range: (PRange indexStart: 0 end: aString size);		privateSource: aString.	^ doc! !!PBaseParser class methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:11'!rootRuleName	^ 'document'! !!PChange class methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:53'!range: aRange insert: aString	^ self new		from: aRange first;		to: aRange last;		insert: aString! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 09:40'!applyTo: aString	^ (aString copyFrom: 1 to: self from), (self insert ifNil: ['']), (aString copyFrom: self to + 1 to: aString size)! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!from	^ from! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!from: aNumber	from := aNumber! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!insert	^ insert! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!insert: aString	insert := aString! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 08:28'!sideAffinity	^ sideAffinity! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 08:28'!sideAffinity: aNumber	sideAffinity := aNumber! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 09:55'!sourceShard	^ sourceShard! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 09:55'!sourceShard: aShard	sourceShard := aShard! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!to	^ to! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!to: aNumber	to := aNumber! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 20:43'!initialize	super initialize.		replacementDefinitions := OrderedCollection new.	markerDefinitions := OrderedCollection new! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:45'!markerDefinitions	^ markerDefinitions! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 09:37'!registerMarker: aMarker	markerDefinitions add: aMarker! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:11'!registerReplacement: aReplacement	replacementDefinitions add: aReplacement! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:11'!replacementDefinitions	^ replacementDefinitions! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:48'!attribute	^ attribute! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:52'!attribute: aTextAttribute	attribute := aTextAttribute! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:47'!definition	^ definition! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:47'!definition: aDefinition	definition := aDefinition! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:47'!node	^ node! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:47'!node: aNode	node := aNode! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:46'!attach	^ attach! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 09:49'!attach: aBlock	attach := aBlock! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:46'!detach	^ detach! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 09:50'!detach: aBlock	detach := aBlock! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:33'!model	^ model! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:34'!model: aClass	model := aClass! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 09:40'!name	^ name! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 09:40'!name: aString	name := aString! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 09:39'!query	^ query! !!PMarkerDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 09:39'!query: aQuery	query := aQuery! !!PMarkerDefinition methodsFor: 'utils' stamp: 'tobe 4/17/2024 11:49'!style: anAttribute	self		attach: [:shard :node | shard styleAdd: anAttribute for: node definition: self];		detach: [:shard :node :data | shard styleRemove: data]! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:25'!buildReplacement	^ (buildReplacement ifNil: [[PReplacement new]]) value! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:22'!buildReplacement: aBlock	buildReplacement := aBlock! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:08'!deletionInteraction	^ deletionInteraction! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:08'!deletionInteraction: aSymbol	deletionInteraction := aSymbol! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:40'!init: aBlock update: anotherBlock	self buildReplacement: [PReplacementPluggable new init: aBlock update: anotherBlock]! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:09'!initialize	super initialize.		selectionInteraction := #skip.	deletionInteraction := #character! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:34'!model	^ model! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:03'!model: aModel	model := aModel! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:10'!name	^ name! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:10'!name: aString	name := aString! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:10'!query	^ query! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:10'!query: aQuery	query := aQuery! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:08'!selectionInteraction: aSymbol	selectionInteraction := aSymbol! !!PReplacementDefinition methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:08'!selectionInteractive	^ selectionInteraction! !!PWhitespaceParser class methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:23'!parse: aString old: aNode	| doc stream |	doc := PNode new		type: 'document';		language: self;		range: (PRange indexStart: 0 end: aString size);		privateSource: aString.		stream := aString readStream.	[stream atEnd] whileFalse: [ | c node type |		c := stream next.		node := PText new contents: ''.		type := #text.		c			caseOf: {				[Character tab] -> [					node contents: c asString.					type := #tab].				[Character cr] -> [					node contents: c asString.					type := #newline]}			otherwise: [[({Character tab. Character cr} includes: stream peek) or: [stream atEnd]] whileFalse: [node contents: node contents, stream next]].		node range: (PRange indexStart: stream position - node contents size end: stream position).		doc appendBaseChild: (PNode new			type: type;			language: self;			range: node range;			appendBaseChild: node)].		^ doc! !!PWhitespaceParser class methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:11'!rootRuleName	^ 'document'! !"Painting-Editor"!PEditorState example!----QUIT----{8 December 2025 . 8:47:49 pm} Squeak6.0-22148-64bit.image priorSource: 1284044!----STARTUP----{9 December 2025 . 7:44:27 am} as /home/tom/Downloads/Squeak6.0-22148-64bit-202312181441-Linux-x64/shared/Squeak6.0-22148-64bit.image!ParseNode subclass: #BracketNode	instanceVariableNames: 'expr'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Diff'!!BracketNode commentStamp: '<historical>' prior: 0!I represent an expression of the form ^expr.!Parser subclass: #FullRangeParser	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Diff'!!BracketNode methodsFor: 'visiting' stamp: 'ct 12/8/2025 21:15'!accept: aVisitor	^aVisitor visitBracketNode: self! !!BracketNode methodsFor: 'closure analysis' stamp: 'eem 7/24/2009 09:44'!analyseTempsWithin: scopeBlock "<BlockNode>" rootNode: rootNode "<MethodNode>" assignmentPools: assignmentPools "<Dictionary>"	"Note we could do this:		scopeBlock ~~ rootNode block ifTrue:			[scopeBlock noteNonLocalReturn].	 and pass up the flag in <BlockNode>>>analyseTempsWithin:rootNode:	 which may be fast but will also give less information the debugger.	 For now we consider clean blocks a premature optimization."	self flag: 'consider clean blocks'.	expr analyseTempsWithin: scopeBlock rootNode: rootNode assignmentPools: assignmentPools! !!BracketNode methodsFor: 'code generation'!code	^expr code! !!BracketNode methodsFor: 'printing' stamp: 'yo 8/2/2004 17:21'!expr	^ expr.! !!BracketNode methodsFor: 'initialize-release'!expr: e	expr := e! !!BracketNode methodsFor: 'initialize-release'!expr: e encoder: encoder sourceRange: range	expr := e.	encoder noteSourceRange: range forNode: self! !!BracketNode methodsFor: 'testing'!isSpecialConstant	^expr isSpecialConstant! !!BracketNode methodsFor: 'testing'!isVariableReference	^expr isVariableReference! !!BracketNode methodsFor: 'printing' stamp: 'ct 12/8/2025 21:16'!printOn: aStream indent: level	aStream nextPut: $(.	expr printOn: aStream indent: level.	expr printCommentOn: aStream indent: level.	aStream nextPut: $).! !!BracketNode methodsFor: 'printing' stamp: 'ct 12/8/2025 21:17'!printWithClosureAnalysisOn: aStream indent: level	aStream nextPut: $(.	expr printWithClosureAnalysisOn: aStream indent: level.	expr printCommentOn: aStream indent: level.	aStream nextPut: $).! !!SequenceableCollection methodsFor: '*Painting-Diff'!overlappingPairsLoopedDo: aBlock	"Emit overlapping pairs of my elements into aBlock"	1 to: self size - 1 do: [:i | aBlock value: (self at: i) value: (self at: i + 1)].	self size >= 2 ifTrue: [aBlock value: self last value: self first]! !!SequenceableCollection methodsFor: '*Painting-Diff'!withOrNil: aCollection do: aBlock	1		to: (self size max: aCollection size)		do: [:index | aBlock value: (self at: index ifAbsent: [nil]) value: (aCollection at: index ifAbsent: [nil])]! !!PSmalltalkParser methodsFor: 'structure' stamp: 'tobe 12/8/2025 21:12' prior: 35289699!createPNode: aParseNode type: aSymbol	^ PNode new		range: (encoder rawSourceRanges			at: aParseNode			ifPresent: [:range | PRange indexStart: range start - 1 end: range stop]			ifAbsent: [PRange null]);		language: self class;		type: aSymbol;		yourself! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 21:20'!visitBracketNode: aBracketNode	| node |	node := self createPNode: aBracketNode type: #bracket.	node baseAndMorphAdd: (aBracketNode expr accept: self).	^ node! !!ParseNodeVisitor methodsFor: '*Painting-Diff-visiting' stamp: 'ct 12/8/2025 21:15'!visitBracketNode: aReturnNode	aReturnNode expr accept: self! !!FullRangeParser methodsFor: 'expression types' stamp: 'ct 12/8/2025 21:03'!assignment: varNode	^ (super assignment: varNode)		ifTrue:			[encoder noteSourceRange: ((encoder sourceRangeFor: varNode) start to: self endOfLastToken) forNode: parseNode];		yourself! !!FullRangeParser methodsFor: 'expression types' stamp: 'ct 12/8/2025 21:01'!braceExpression	| start |	start := self startOfNextToken.	super braceExpression.	encoder noteSourceRange: (start to: self endOfLastToken) forNode: parseNode.! !!FullRangeParser methodsFor: 'expression types' stamp: 'ct 12/8/2025 21:00'!cascade	| start |	start := self startOfNextToken.	super cascade.	encoder noteSourceRange: (start to: self endOfLastToken) forNode: parseNode.! !!FullRangeParser methodsFor: 'expression types' stamp: 'ct 12/8/2025 20:44'!messagePart: level repeat: repeat	| start receiver selector args precedence words keywordStart |	[receiver := parseNode.	(hereType == #keyword and: [level >= 3])		ifTrue: 			[start := self startOfNextToken.			selector := WriteStream on: (String new: 32).			args := OrderedCollection new.			words := OrderedCollection new.			[hereType == #keyword]				whileTrue: 					[keywordStart := self startOfNextToken + requestorOffset.					selector nextPutAll: self advance.					words addLast: (keywordStart to: self endOfLastToken + requestorOffset).					self primaryExpression ifFalse: [^self expected: 'Argument'].					self messagePart: 2 repeat: true.					args addLast: parseNode].			selector := (Symbol lookup: selector contents)				ifNil: [ self correctSelector: selector contents							wordIntervals: words							exprInterval: (start to: self endOfLastToken)							ifAbort: [ ^ self fail ] ].			precedence := 3]		ifFalse: [			(level >= 2 and: [hereType == #verticalBar]) ifTrue: [self transformAVerticalBarIntoABinarySelector].			(hereType == #binary and: [level >= 2])				ifTrue: 					[start := self st