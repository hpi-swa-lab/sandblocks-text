lect context''s field' translated;		frame: (0.7@0.8 corner: 1@1).	windowSpec children add: textSpec.	^builder build: windowSpec! !!Debugger methodsFor: 'toolbuilder' stamp: 'ct 4/19/2025 22:48' prior: 37252942!buildFullWith: builder label: label	| windowSpec listSpec textSpec |	windowSpec := builder pluggableWindowSpec new		model: self;		label: label;		children: OrderedCollection new.	listSpec := builder pluggableListSpec new.	listSpec 		model: self;		list: #contextStackList; 		getIndex: #contextStackIndex; 		setIndex: #toggleContextStackIndex:; 		menu: #contextStackMenu:shifted:; 		icon: #messageIconAt:;		helpItem: #messageHelpAt:;		keyPress: #contextStackKey:from:;		frame: (0@0 corner: 1@0.22).	windowSpec children add: listSpec.	textSpec := self buildCodePaneWith: builder.	textSpec frame: (0@0.22corner: 1@0.8).	windowSpec children add: textSpec.	listSpec := self receiverInspector buildFieldListWith: builder.	listSpec 		frame: (0@0.8 corner: 0.2@1);		help: [self receiverInspectorHelp].	windowSpec children add: listSpec.	textSpec := self receiverInspector buildValuePaneWith: builder.	textSpec 		help: [self receiverInspectorValueHelp];		frame: (0.2@0.8 corner: 0.5@1).	windowSpec children add: textSpec.	listSpec := self contextVariablesInspector buildFieldListWith: builder.	listSpec 		frame: (0.5@0.8 corner: 0.7@1);		help: [self contextVariablesInspectorHelp].	windowSpec children add: listSpec.	textSpec := self contextVariablesInspector buildValuePaneWith: builder.	textSpec 		help: [self contextVariablesInspectorPaneHelp];		frame: (0.7@0.8 corner: 1@1).	windowSpec children add: textSpec.	^builder build: windowSpec! !!Debugger methodsFor: 'toolbuilder' stamp: 'ct 3/24/2021 18:00' prior: 25442155!buildWith: aBuilder	^self buildFullWith: aBuilder label: 'Debugger'! !!Debugger methodsFor: 'toolbuilder' stamp: 'ct 3/24/2021 18:06'!buildWithLabel: title contents: contentsStringOrNil fullView: full 	| builder |