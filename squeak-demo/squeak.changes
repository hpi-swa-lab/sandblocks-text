ceFill.! !!BorderedSubpaneDividerMorph methodsFor: 'layout' stamp: 'ar 8/15/2001 23:24' prior: 37974306!horizontal	self hResizing: #spaceFill.! !!BorderedSubpaneDividerMorph methodsFor: 'layout' stamp: 'ar 8/15/2001 23:24' prior: 19162689!vertical	self vResizing: #spaceFill.! !!BorderedSubpaneDividerMorph methodsFor: 'layout' stamp: 'ar 8/15/2001 23:24' prior: 37974586!vertical	self vResizing: #spaceFill.! !!BorderedSubpaneDividerMorph methodsFor: 'accessing' stamp: 'ar 8/15/2001 23:24' prior: 19162947!resizingEdge	^resizingEdge! !!BorderedSubpaneDividerMorph methodsFor: 'accessing' stamp: 'ar 8/15/2001 23:24' prior: 37974865!resizingEdge	^resizingEdge! !!BorderedSubpaneDividerMorph methodsFor: 'accessing' stamp: 'ar 8/15/2001 23:24' prior: 19163377!resizingEdge: edgeSymbol	(#(top bottom) includes: edgeSymbol) ifFalse:		[ self error: 'resizingEdge must be #top or #bottom' ].	resizingEdge := edgeSymbol.	self on: #mouseEnter send: #firstEnter: to: self.! !!BorderedSubpaneDividerMorph methodsFor: 'accessing' stamp: 'ar 8/15/2001 23:24' prior: 37975129!resizingEdge: edgeSymbol	(#(top bottom) includes: edgeSymbol) ifFalse:		[ self error: 'resizingEdge must be #top or #bottom' ].	resizingEdge := edgeSymbol.	self on: #mouseEnter send: #firstEnter: to: self.! !BorderedSubpaneDividerMorph class	instanceVariableNames: ''!!BorderedSubpaneDividerMorph class methodsFor: 'instance creation' stamp: 'ar 8/15/2001 23:24' prior: 19163985!forBottomEdge	^self new horizontal resizingEdge: #bottom! !!BorderedSubpaneDividerMorph class methodsFor: 'instance creation' stamp: 'ar 8/15/2001 23:24' prior: 37975835!forBottomEdge	^self new horizontal resizingEdge: #bottom! !!BorderedSubpaneDividerMorph class methodsFor: 'instance creation' stamp: 'ar 8/15/2001 23:25' prior: 19164311!forTopEdge	^self new horizontal resizingEdge: #top! !!BorderedSubpaneDividerMorph class methodsFor: 'instance creation' stamp: 'ar 8/15/2001 23:25' prior