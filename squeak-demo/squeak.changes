t: keyForState		put: stateToSave]		on: Error		do: [:ex|]! !!Debugger methodsFor: 'context stack - message list' stamp: 'ct 9/3/2020 14:39' prior: 25381449!findCleanHomeBelow: method	| dirtyIndex |	dirtyIndex := contextStack size + 1.	contextStack reverse detect: [:context |		dirtyIndex := dirtyIndex - 1.		context home method = method homeMethod].	^ dirtyIndex + 1! !!Debugger methodsFor: 'context stack - message list' stamp: 'ct 5/12/2025 19:15' prior: 25489078!messageListIndex	"Answer the index of the currently selected context."	^ self contextStackIndex! !!Debugger methodsFor: 'context stack - message list' stamp: 'ct 4/20/2025 23:36'!selectedBytecodes	^ Text new: 1000 streamContents: [:stream |		self selectedContext homeMethod longPrint: DebuggerInstructionPrinter on: stream indent: 0]! !!Debugger methodsFor: 'context stack - message list' stamp: 'ct 4/20/2025 21:07' prior: 25490157!selectedMessage	"Answer the source code of the currently selected context."	^ contents := self showingByteCodes		ifTrue:			[self selectedBytecodes]		ifFalse:			[| aContext |			aContext := self selectedContext.			aContext debuggerMap sourceText asText makeSelectorBoldIn: aContext home receiver class]! !!Debugger methodsFor: 'context stack - message list' stamp: 'ct 5/12/2025 19:17'!showException	self hasContextSelected ifTrue: [self toggleContextStackIndex: 0].! !!Debugger methodsFor: 'context stack - message list' stamp: 'ct 5/12/2025 19:18'!showTopContext	self contextStackIndex = 1 ifFalse: [self toggleContextStackIndex: 1].! !!Debugger methodsFor: 'context stack - message list' stamp: 'ct 5/12/2025 19:15' prior: 25491613!toggleContextStackIndex: anInteger 	"If anInteger is the same as the index of the selected context, deselect it. 	Otherwise, the context whose index is anInteger becomes the selected 	context."	self		contextStackIndex: 			(self contextStackIndex = anInteger				ifTrue: [0]				ifFalse: [anInteger])		oldContextW