sis)				ifFalse: [^self expected: 'right parenthesis'].			parseNode := BracketNode new				expr: parseNode				encoder: encoder				sourceRange: (start to: self endOfLastToken).			^true].	(hereType == #string or: [hereType == #number or: [hereType == #literal or: [hereType == #character]]])		ifTrue: 			[start := self startOfNextToken.			parseNode := encoder encodeLiteral: self advance.			encoder noteSourceRange: (start to: self endOfLastToken) forNode: parseNode.			^true].	(here == #- and: [tokenType == #number and: [1 + hereEnd = mark]])		ifTrue: 			[self advance.			parseNode := encoder encodeLiteral: self advance negated.			^true].	^false! !!BracketNode methodsFor: 'visiting' stamp: 'ct 12/8/2025 21:15'!accept: aVisitor	^aVisitor visitBracketNode: self! !!BracketNode methodsFor: 'closure analysis' stamp: 'eem 7/24/2009 09:44'!analyseTempsWithin: scopeBlock "<BlockNode>" rootNode: rootNode "<MethodNode>" assignmentPools: assignmentPools "<Dictionary>"	"Note we could do this:		scopeBlock ~~ rootNode block ifTrue:			[scopeBlock noteNonLocalReturn].	 and pass up the flag in <BlockNode>>>analyseTempsWithin:rootNode:	 which may be fast but will also give less information the debugger.	 For now we consider clean blocks a premature optimization."	self flag: 'consider clean blocks'.	expr analyseTempsWithin: scopeBlock rootNode: rootNode assignmentPools: assignmentPools! !!BracketNode methodsFor: 'code generation'!code	^expr code! !!BracketNode methodsFor: 'printing' stamp: 'yo 8/2/2004 17:21'!expr	^ expr.! !!BracketNode methodsFor: 'initialize-release'!expr: e	expr := e! !!BracketNode methodsFor: 'initialize-release'!expr: e encoder: encoder sourceRange: range	expr := e.	encoder noteSourceRange: range forNode: self! !!BracketNode methodsFor: 'testing'!isSpecialConstant	^expr isSpecialConstant! !!BracketNode methodsFor: 'testing'!isVariableReference	^expr isVariableReference! !!BracketNode methodsFor: 'printing' stamp: 'ct 12/8/2025 21:16'!printOn: aStream indent: level	aStream nextPut: $(.	expr printOn: aStream indent: level.	expr printCommentOn: aStream indent: level.	aStream nextPut: $).! !!BracketNode methodsFor: 'printing' stamp: 'ct 12/8/2025 21:17'!printWithClosureAnalysisOn: aStream indent: level	aStream nextPut: $(.	expr printWithClosureAnalysisOn: aStream indent: level.	expr printCommentOn: aStream indent: level.	aStream nextPut: $).! !!ParseNodeEnumerator methodsFor: '*Painting-Diff-visiting' stamp: 'ct 12/8/2025 21:16'!visitBracketNode: aBracketNode	(theSelectBlock isNil or: [theSelectBlock value: aBracketNode]) ifFalse:		[^nil].	theBlock value: aBracketNode.	^super visitReturnNode: aBracketNode! !!PSmalltalkParser class methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 18:19'!parse: aString old: aNode	^ [PNode parseSt: aString] on: SyntaxErrorNotification do: [		PNode new			type: #method;			language: self;			range: (PRange indexStart: 0 end: aString size);			privateSource: aString]! !!PSmalltalkParser class methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 19:59'!rootRuleName	^ #method! !!PSmalltalkParser methodsFor: 'structure' stamp: 'tobe 12/8/2025 19:27'!addChild: aPNode	currentNode ifNotNil: [currentNode baseAndMorphAdd: aPNode]! !!PSmalltalkParser methodsFor: 'structure' stamp: 'tobe 12/8/2025 21:42'!createPNode: aParseNode type: aSymbol	^ PNode new		range: (encoder rawSourceRanges			at: aParseNode			ifPresent: [:range | PRange indexStart: range start - 1 end: range stop]			ifAbsent: [PRange null]);		language: self class;		type: aSymbol;		yourself! !!PSmalltalkParser methodsFor: 'structure' stamp: 'tobe 12/8/2025 22:08'!createPText: aString node: aNode	^ PText new		range: (encoder rawSourceRanges			at: aNode			ifPresent: [:range | PRange indexStart: range start - 1 end: range stop]			ifAbsent: [PRange null]);		language: self;		contents: aString;		yourself! !!PSmalltalkParser methodsFor: 'initialize-release' stamp: 'tobe 12/8/2025 19:40'!encoder: anEncoder	encoder := anEncoder! !!PSmalltalkParser methodsFor: 'initialize-release' stamp: 'tobe 12/8/2025 19:22'!initialize	super initialize! !!PSmalltalkParser methodsFor: 'structure' stamp: 'tobe 12/8/2025 19:28'!popNode	| popped |	popped := stack removeLast.	currentNode := stack ifEmpty: [nil] ifNotEmpty: [stack last].	^ popped! !!PSmalltalkParser methodsFor: 'structure' stamp: 'tobe 12/8/2025 19:28'!pushNode: aPNode	stack addLast: aPNode.	currentNode := aPNode! !!PSmalltalkParser methodsFor: 'initialize-release' stamp: 'tobe 12/8/2025 20:00'!source: aString	source := aString! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 19:28'!visitAssignmentNode: anAssignmentNode	| node |	node := self createPNode: anAssignmentNode type: #assignment.	node baseAndMorphAdd: (anAssignmentNode variable accept: self).	node baseAndMorphAdd: (anAssignmentNode value accept: self).		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 19:28'!visitBlockNode: aBlockNode	| node |	node := self createPNode: aBlockNode type: #block.		aBlockNode statements do: [:statement | node baseAndMorphAdd: (statement accept: self)].		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 19:28'!visitBraceNode: aBraceNode	| node |	node := self createPNode: aBraceNode type: #brace.		aBraceNode elements do: [:element | node baseAndMorphAdd: (element accept: self)].		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 21:20'!visitBracketNode: aBracketNode	| node |	node := self createPNode: aBracketNode type: #bracket.	node baseAndMorphAdd: (aBracketNode expr accept: self).	^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 19:28'!visitCascadeNode: aCascadeNode	| node |	node := self createPNode: aCascadeNode type: #cascade.		aCascadeNode receiver ifNotNil: [:receiver | node baseAndMorphAdd: (receiver accept: self)].	aCascadeNode messages do: [:message | node baseAndMorphAdd: (message accept: self)].		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:08'!visitCommentNode: aCommentNode	| text |	text := self createPText: aCommentNode comment node: aCommentNode.	self addChild: text.	^ text! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:08'!visitFieldNode: aFieldNode	| text |	text := self createPText: aFieldNode key asString node: aFieldNode.	self addChild: text.	^ text! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 19:28'!visitFutureNode: aFutureNode	| node |	node := self createPNode: aFutureNode type: #future.	aFutureNode receiver ifNotNil: [:receiver | node baseAndMorphAdd: (receiver accept: self)].		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:08'!visitInstanceVariableNode: anInstanceVariableNode	| text |	text := self createPText: anInstanceVariableNode name asString node: anInstanceVariableNode.	self addChild: text.	^ text! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:08'!visitLiteralNode: aLiteralNode	| text |	text := self createPText: aLiteralNode key asString node: aLiteralNode.	self addChild: text.	^ text! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:09'!visitLiteralVariableNode: aLiteralVariableNode	| text |	text := self createPText: aLiteralVariableNode name asString node: aLiteralVariableNode.	self addChild: text.	^ text! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'ct 12/9/2025 02:04'!visitMessageNode: aMessageNode	| node |	node := self createPNode: aMessageNode type: #message.		aMessageNode receiver ifNotNil: [:receiver | node baseAndMorphAdd: (receiver accept: self)].	aMessageNode selector ifNotNil: [:selector | node baseAndMorphAdd: (self createPText: selector asString node: selector)].	(aMessageNode arguments copyWithout: nil "??") do: [:argument | node baseAndMorphAdd: (argument accept: self)].		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:09'!visitMessageNodeInCascade: aMessageNode	| node |	node := self createPNode: aMessageNode type: #messageInCascade.		aMessageNode selector ifNotNil: [:selector | node baseAndMorphAdd: (self createPText: selector asString node: aMessageNode)].	aMessageNode arguments do: [:argument | node baseAndMorphAdd: (argument accept: self)].		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:09'!visitMethodNode: aMethodNode	| node |	node := self createPNode: aMethodNode type: #method.	node privateSource: source.		node baseAndMorphAdd: (self createPText: aMethodNode selector asString node: aMethodNode).	node baseAndMorphAdd: (aMethodNode block accept: self).		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 19:29'!visitNewArrayNode: aNewArrayNode	| node |	node := self createPNode: aNewArrayNode type: #newArray.		aNewArrayNode elements do: [:element | node baseAndMorphAdd: (element accept: self)].		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 19:29'!visitRemoteTempVectorNode: aRemoteTempVectorNode	| node |	node := self createPNode: aRemoteTempVectorNode type: #remoteTempVector.		aRemoteTempVectorNode remoteTemps do: [:temp | node baseAndMorphAdd: (temp accept: self)].		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 19:29'!visitReturnNode: aReturnNode	| node |	node := self createPNode: aReturnNode type: #return.		node baseAndMorphAdd: (aReturnNode expr accept: self).		^ node! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:09'!visitSelectorNode: aSelectorNode	| text |	text := self createPText: aSelectorNode key asString node: aSelectorNode.	self addChild: text.	^ text! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:09'!visitTempVariableNode: aTempVariableNode	| text |	text := self createPText: aTempVariableNode name asString node: aTempVariableNode.	self addChild: text.	^ text! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:09'!visitUndeclaredVariableNode: anUndeclaredVariableNode	| text |	text := self createPText: anUndeclaredVariableNode name asString node: anUndeclaredVariableNode.	self addChild: text.	^ text! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'tobe 12/8/2025 22:09'!visitVariableNode: aVariableNode	| text |	text := self createPText: aVariableNode name asString node: aVariableNode.	self addChild: text.	^ text! !!PSmalltalkParser methodsFor: 'visiting' stamp: 'ct 12/9/2025 02:04'!visitVariableUsageNode: aVariableUsageNode	^ self visitVariableNode: aVariableUsageNode variableNode! !!ParseNodeVisitor methodsFor: '*Painting-Diff-visiting' stamp: 'ct 12/8/2025 21:15'!visitBracketNode: aReturnNode	aReturnNode expr accept: self! !"Painting-Diff"!SystemOrganization addCategory: #'Painting-Editor'!Morph subclass: #PEditorState	instanceVariableNames: 'sourceString rootShard shards validationBlocks pendingChanges pendingChangesRevert models'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!Morph subclass: #PReplacement	instanceVariableNames: 'definition node editor'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!PReplacement subclass: #PReplacementPluggable	instanceVariableNames: 'init update didInit delete'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!Morph subclass: #PShard	instanceVariableNames: 'nodes view editor extensions replacements lastActualSourceString attributes'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!TestCase subclass: #PEditorTest	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!Object subclass: #PBaseParser	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!Object subclass: #PChange	instanceVariableNames: 'from to insert sourceShard sideAffinity'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!Object subclass: #PExtension	instanceVariableNames: 'replacementDefinitions markerDefinitions'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!Object subclass: #PMarker	instanceVariableNames: 'node definition attribute'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!Object subclass: #PMarkerDefinition	instanceVariableNames: 'query name attach detach model'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!Object subclass: #PReplacementDefinition	instanceVariableNames: 'name query selectionInteraction deletionInteraction replacementClass buildReplacement model validate'	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!Object subclass: #PWhitespaceParser	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Painting-Editor'!!PEditorState class methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 18:19'!example	| e testExt container |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #message and: [x baseChildren second contents = '{sbWatchWithId:}']]};		validate: [:replacement | (replacement valueOfProperty: #node) isInTree];		init: [:node :replacement |				replacement color: (Color r: 0.25 g: 0.25 b: 0.25).				replacement layoutInset: 1 px.				replacement					addMorphBack: (replacement createShard extensions: {testExt});					addMorphBack: (TextMorph new						color: (Color r: 1 g: 1 b: 1);						lock;						hResizing: #shrinkWrap)]			update: [:node :replacement | | watchId updateWatch |				replacement setProperty: #node toValue: node.				replacement firstSubmorph nodes: {node baseChildren first}.				watchId := node baseChildren third contents asInteger.				updateWatch := [					replacement submorphs second contents: (PTracer current ifNil: ['(not watching)'] ifNotNil: [:tracer |						tracer							valueForId: watchId							ifPresent: [:value | value asArray printString]							ifAbsent: ['(not yet watched)']])].				updateWatch value.				PTracer current ifNotNil: [:tracer |					tracer when: #traced send: #value to: updateWatch.					replacement setProperty: #watchId toValue: watchId.					(replacement valueOfProperty: #watchTracerReceivers ifAbsentPut: [Dictionary new])						at: watchId						put: updateWatch]]			delete: [:node :replacement | | watchId |				watchId := replacement valueOfProperty: #watchId.				(replacement valueOfProperty: #watchTracerReceivers) removeKey: watchId]).		e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: 'test	3 + ((2 + 8) sbWatchWithId: 1664525).	1 to: 3 do: [:i | 12313432 + i].	'.		container := Morph new		addMorphBack: e rootShard;		layoutPolicy: TableLayout new;		color: (Color r: 1 g: 1 b: 1);		layoutInset: 4;		hResizing: #shrinkWrap;		vResizing: #shrinkWrap;		openInWindow.		e		when: #isPending		evaluate: [:is | container color: (is ifTrue: [Color r: 1 g: 0.6 b: 0.0] ifFalse: [Color r: 1 g: 1 b: 1])]! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 08:30'!adjustIndex: aNumber forChangeList: aCollection sideAffinity: anotherNumber	^ self		adjustIndex: aNumber		forChangeList: aCollection		upTo: aCollection size		sideAffinity: anotherNumber! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 08:32'!adjustIndex: aNumber forChangeList: aCollection upTo: anotherNumber sideAffinity: aThirdNumber	| index |	index := aNumber.	aCollection		from: 1		to: anotherNumber		do: [:change | (((change sideAffinity = aThirdNumber or: [aThirdNumber = 0]) and: [index >= change from]) or: [change sideAffinity ~= aThirdNumber and: [index > change from]]) ifTrue: [index := index + ((change insert ifNil: ['']) size - ((index clampLow: change from high: change to) - change from))]].	^ index! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 08:31'!adjustRange: aRange	^ PRange		indexStart: (self adjustIndex: aRange first forChangeList: self pendingChanges sideAffinity: 1)		end: (self adjustIndex: aRange last forChangeList: self pendingChanges sideAffinity: -1)! !!PEditorState methodsFor: 'changes' stamp: 'tobe 4/15/2024 14:35'!applyChanges: aCollection	self applyChanges: aCollection force: false! !!PEditorState methodsFor: 'changes' stamp: 'tobe 12/22/2025 17:08'!applyChanges: aCollection force: aBoolean	| newSourceString pair oldSourceString editScripts oldModels |	newSourceString := (aCollection, pendingChanges) reversed		inject: sourceString		into: [:new :change | change applyTo: new].	oldSourceString := sourceString.	oldModels := models copy.		editScripts := oldModels collect: [:oldRoot | | newRoot |		newRoot := [oldRoot language parse: newSourceString old: oldRoot]			on: SyntaxErrorNotification			do: [^ false].				pair := PTrueDiff new compare: oldRoot to: newRoot.		pair first privateSource: newSourceString.		models at: oldRoot language put: pair first.		pair second].		aBoolean ifFalse: [		(self checkValidation: editScripts changes: aCollection) ifFalse: [			models := oldModels.			editScripts do: [:script | script undo].			models do: [:root | root privateSource: oldSourceString].			pendingChanges addAll: aCollection.			pendingChangesRevert addAll: (aCollection collect: [:change |				PChange					range: (change from to: change from + change insert size)					insert: (self sourceString copyFrom: change from + 1 to: change to)]).			self shards do: [:shard | shard applyRejectedChanges: aCollection].			self isPending: true.			^ false]].		self isPending: false.	pendingChanges := OrderedCollection new.	self basicSourceString: newSourceString.		self shards do: [:shard |		editScripts keysAndValuesDo: [:model :editScript | shard updateReplacementsFor: editScript root: (models at: model)].		shard updateText].		self evaluateCode.		^ true! !!PEditorState methodsFor: 'changes' stamp: 'tobe 4/15/2024 14:45'!applyPendingChanges	self applyChanges: {} force: true! !!PEditorState methodsFor: 'accessing' stamp: 'tobe 4/12/2024 10:51'!basicSourceString: aString	sourceString := aString! !!PEditorState methodsFor: 'changes' stamp: 'tobe 12/22/2025 13:50'!checkValidation: editScripts changes: aCollection	validationBlocks do: [:b | (b value value: (models at: b key) value: aCollection value: (editScripts at: b key)) ifFalse: [^ false]].	shards do: [:shard | shard replacements do: [:r | r definition validate ifNotNil: [(r definition validate value: r) ifFalse: [^ false]]]].	^ true! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:08'!ensureModels: aCollection	aCollection do: [:model | models at: model ifAbsentPut: [sourceString ifNotNil: [model parse: sourceString old: nil]]]! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'ct 12/9/2025 02:15'!evaluateCode	| method |	PTracer current ifNotNil: #reset.	method := ([Compiler new compile: self sourceString in: nil class environment: self environment notifying: nil ifFail: [^ false]]		on: SyntaxErrorNotification do: [^ false])			generate.	method numArgs = 0 ifFalse: [^ false].		[method valueWithReceiver: nil arguments: #()]		on: Error , Warning , Halt do: [^ false].		^ true! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:11'!initialize	super initialize.		shards := Set new.	rootShard := PShard new editor: self.	validationBlocks := OrderedCollection new.	pendingChanges := OrderedCollection new.	pendingChangesRevert := OrderedCollection new.	models := Dictionary new		at: PBaseParser put: nil;		yourself! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 18:06'!isPending: aBoolean	self triggerEvent: #isPending with: aBoolean! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 06:56'!models	^ models! !!PEditorState methodsFor: 'changes' stamp: 'tobe 4/15/2024 15:48'!pendingChanges	^ pendingChanges! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:22'!range	^ PRange indexStart: 0 end: self sourceString size! !!PEditorState methodsFor: 'changes' stamp: 'tobe 4/19/2024 18:45'!registerValidation: aBlock for: aModel	| pair |	pair := aModel -> aBlock.	validationBlocks add: pair.	^ [validationBlocks remove: pair]! !!PEditorState methodsFor: 'changes' stamp: 'tobe 4/19/2024 20:45'!revertPendingChanges	pendingChanges := OrderedCollection new.	self shards do: [:shard | shard updateText]! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 07:56'!rootShard		^ rootShard! !!PEditorState methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 08:12'!selectionRange	^ 0 to: 0! !!PEditorState methodsFor: 'accessing' stamp: 'tobe 4/13/2024 07:52'!shards	^ shards! !!PEditorState methodsFor: 'accessing' stamp: 'tobe 4/12/2024 10:47'!sourceString	^ sourceString! !!PEditorState methodsFor: 'accessing' stamp: 'tobe 9/26/2024 13:24'!sourceString: aString	self basicSourceString: aString.		models := models keys		collect: [:model | model -> (model parse: aString old: nil)]		as: Dictionary.	rootShard nodes: {models at: PBaseParser}.		! !!PReplacement class methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:21'!build	^ self new! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 14:25'!beforeUninstall	! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:50'!createShard	self assert: self editor notNil.	^ PShard new editor: self editor! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:23'!definition	^ definition! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:17'!definition: aDefinition	definition := aDefinition! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:49'!editor	^ editor! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:49'!editor: anEditor	editor := anEditor! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 17:51'!initialize	super initialize.		self		hResizing: #shrinkWrap;		vResizing: #shrinkWrap;		color: Color transparent;		changeTableLayout! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 10:47'!localIndex: aNumber in: aShard	| index |	index := aNumber.	aShard replacements do: [:replacement |		(self ~= replacement and: [replacement range first <= index]) ifTrue: [" subtract the replaced range but add 1 for the startOfHeader character "		index := index - replacement range size + 1]].	index := index - aShard range first.	^ index! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:26'!localRangeIn: aShard do: aBlock	aBlock		value: (self localIndex: self range first in: aShard) + 1		value: (self localIndex: self range last in: aShard)! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:30'!node	^ node! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:30'!node: aNode	node := aNode! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:01'!range	^ self editor adjustRange: node range! !!PReplacement methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:06'!sourceString	^ self node sourceString! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 14:26'!beforeUninstall	delete valueWithEnoughArguments: {node. self}! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 14:25'!init: aBlock update: anotherBlock	self init: aBlock update: anotherBlock delete: []! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 14:25'!init: aBlock update: anotherBlock delete: aThirdBlock	init := aBlock.	update := anotherBlock.	delete := aThirdBlock! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:41'!initialize	super initialize.		didInit := false! !!PReplacementPluggable methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 13:42'!node: aNode	super node: aNode.		didInit ifFalse: [		init valueWithEnoughArguments: {aNode. self}.		didInit := true].	update valueWithEnoughArguments: {aNode. self}! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 10:27'!adjustGlobalIndex: aNumber	| index |	index := aNumber.	self replacements do: [:replacement |		replacement range first < index ifTrue: [			" subtract the replaced range but add 1 for the startOfHeader character "			index := index - replacement range size + 1]].	index := index - self range first.	^ index! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 10:59'!adjustLocalIndex: aNumber	| index |	index := aNumber + self range first.	self replacements do: [:replacement |		replacement range first < index ifTrue: [			" add the replaced range but subtract 1 for the startOfHeader character "			index := index + replacement range size - 1]].	^ index! !!PShard methodsFor: 'as yet unclassified' stamp: 'ct 12/21/2025 23:09'!allSelectedSourceString	^ Text streamContents: [:stream | 		(self view text attributesAt: self view selectionInterval start - 1 + 0)			detect: [:ea | ea anchoredMorph isKindOf: PReplacementPluggable]			ifFound: [:ea | | childShard |				childShard := ea anchoredMorph firstSubmorph.				stream nextPutAll: childShard allSelectedSourceString].				stream nextPutAll:			(self editor sourceString				copyFrom: (self adjustLocalIndex: self view selectionInterval start)				to: (self adjustLocalIndex: self view selectionInterval stop)).				(self view text attributesAt: self view selectionInterval stop + 1 + 0)			detect: [:ea | ea anchoredMorph isKindOf: PReplacementPluggable]			ifFound: [:ea | | childShard |				childShard := ea anchoredMorph firstSubmorph.				stream nextPutAll: childShard allSelectedSourceString]].! !!PShard methodsFor: 'as yet unclassified' stamp: 'ct 12/20/2025 23:11'!allSelectedText	^ Text streamContents: [:stream | | myText |		(self view text attributesAt: self view selectionInterval start - 1 + 0)			detect: [:ea | ea anchoredMorph isKindOf: PReplacementPluggable]			ifFound: [:ea | | childShard |				childShard := ea anchoredMorph firstSubmorph.				stream nextPutAll: childShard allSelectedText].				myText := self view text			copyFrom: self view selectionInterval start			to: self view selectionInterval stop.		myText runs withStartStopAndValueDo: [:start :stop :attrs |			attrs				detect: [:ea | ea anchoredMorph isKindOf: PReplacementPluggable]				ifFound: [:ea | | childShard |					childShard := ea anchoredMorph firstSubmorph.					stream nextPutAll: childShard allSelectedText]				ifNone: [					stream nextPutAll: (myText copyFrom: start to: stop)]].				(self view text attributesAt: self view selectionInterval stop + 1 + 0)			detect: [:ea | ea anchoredMorph isKindOf: PReplacementPluggable]			ifFound: [:ea | | childShard |				childShard := ea anchoredMorph firstSubmorph.				stream nextPutAll: childShard allSelectedText]].! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/20/2024 08:17'!allVisibleNodesDo: aBlock root: aRoot	| replaced |	replaced := Array streamContents: [:s | self replacements do: [:r | r definition model = aRoot language ifTrue: [s nextPut: r node]]].		self nodes first language = aRoot language		ifTrue: [self nodes do: [:root | root allVisibleNodesDo: aBlock hidden: replaced]]		ifFalse: [aRoot firstChildrenInRange: self range do: [:root | root allVisibleNodesDo: aBlock hidden: replaced]]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:37'!applyChanges: aCollection editScript: aScript	self updateReplacementsFor: aScript! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:45'!applyRejectedChanges: aCollection	self updateText! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 16:55'!basicApplyChanges: aCollection editScript: aScript	(aCollection reject: [:change | change sourceShard = self]) do: [:change |		view handleEdit: [			view				selectInvisiblyFrom: (self adjustGlobalIndex: change from) + 1 to: (self adjustGlobalIndex: change to);				replaceSelectionWith: (change insert ifNil: [''])]]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 17:05'!copySelection: doCut	| string |	string := self allSelectedSourceString.	doCut ifFalse: [		string := string asString			copyWithRegex: '(?<=sbWatchWithId\:\s*)\d+\b'			matchesTranslatedUsing: [:match | match asNumber hashMultiply asString]].	Clipboard clipboardText: string.	doCut ifTrue: [		view replaceSelectionWith: view textMorph editor nullText.		view textEdited: view text]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 08:10'!editor	^ editor! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:06'!editor: anEditor	anEditor shards add: self.	editor := anEditor.		anEditor ensureModels: self requiredModels! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:06'!extensions: aBlock	extensions := aBlock.		editor ifNotNil: [editor ensureModels: self requiredModels]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 16:53'!filterEvent: anEvent for: aMorph	(anEvent isMouse and: [anEvent isMouseMove and: [anEvent isDraggingEvent]]) ifTrue: [		anEvent wasHandled ifFalse: [ "capturing"			anEvent hand releaseMouseFocus.			^ anEvent]].		anEvent wasHandled ifTrue: [ "bubbling"		| containingReplacement containingTextMorph |		((anEvent isKeystroke and: [anEvent shiftPressed]) or: [anEvent isMouse and: [anEvent isDraggingEvent]]) ifFalse: [^ anEvent].		self replacements do: [:ea | | childTextMorph |			childTextMorph := ea firstSubmorph view.			(((self adjustLocalIndex: aMorph selectionInterval start) to: ((self adjustLocalIndex: aMorph selectionInterval stop))) includesAllOf: ((ea firstSubmorph range first + 1) to: (ea firstSubmorph range last))) ifTrue: [				childTextMorph selectFrom: 1 to: childTextMorph text size].			anEvent isDraggingEvent ifTrue: [				(((self adjustLocalIndex: aMorph selectionInterval start) - 1 to: ((self adjustLocalIndex: aMorph selectionInterval stop) + 1)) includesAnyOf: ((ea firstSubmorph range first + 1) to: (ea firstSubmorph range last))) ifFalse: [					childTextMorph selectFrom: childTextMorph selectionInterval start to: childTextMorph selectionInterval start - 1]]].		((containingReplacement := self owner) isKindOf: PReplacementPluggable) ifFalse: [^ anEvent].		containingTextMorph := containingReplacement owner.		^ anEvent].		anEvent isKeystroke ifFalse: [^ anEvent].	aMorph hasKeyboardFocus ifFalse: [^ anEvent].		(anEvent commandKeyPressed and: [#($c $x) includes: anEvent keyCharacter]) ifTrue: [		| containingReplacement |		((containingReplacement := self owner) isKindOf: PReplacementPluggable) ifTrue: [			| containingTextMorph containingShard |			containingTextMorph := containingReplacement owner.			containingShard := containingTextMorph owner owner owner.			^ containingShard filterEvent: anEvent for: aMorph].		self copySelection: anEvent keyCharacter = $x.		^ anEvent wasHandled: true].		"capturing"	(anEvent keyCharacter = Character arrowLeft and: [aMorph selectionInterval start <= 2]) ifTrue: [ | containingReplacement containingTextMorph containingShard index |		((containingReplacement := self owner) isKindOf: PReplacementPluggable) ifFalse: [^ anEvent].		containingTextMorph := containingReplacement owner.		containingShard := containingTextMorph owner owner owner.		anEvent hand newKeyboardFocus: containingTextMorph.		index := (containingShard adjustGlobalIndex: containingReplacement range first) - (1 - aMorph selectionInterval start).		aMorph selectFrom: 1 to: (anEvent shiftPressed ifFalse: [0] ifTrue: [aMorph selectionInterval stop]).		containingTextMorph selectFrom: ((anEvent shiftPressed and: [containingTextMorph selectionInterval notEmpty]) ifFalse: [index] ifTrue: [containingTextMorph selectionInterval stop + 1]) to: index - 1.		^ anEvent wasHandled: true].	(anEvent keyCharacter = Character arrowRight and: [aMorph selectionInterval stop >= (aMorph text size - 1)]) ifTrue: [ | containingReplacement containingTextMorph index |		((containingReplacement := self owner) isKindOf: PReplacementPluggable) ifFalse: [^ anEvent].		containingTextMorph := containingReplacement owner.		anEvent hand newKeyboardFocus: containingTextMorph.		index := containingReplacement range first + 2.		aMorph selectFrom: (anEvent shiftPressed ifFalse: [aMorph text size] ifTrue: [aMorph selectionInterval start]) to: (anEvent shiftPressed ifFalse: [aMorph text size - 1] ifTrue: [aMorph text size]).		containingTextMorph selectFrom: ((anEvent shiftPressed and: [containingTextMorph selectionInterval notEmpty]) ifFalse: [index] ifTrue: [containingTextMorph selectionInterval start]) to: index - 1.		^ anEvent wasHandled: true].	anEvent keyCharacter = Character arrowLeft ifTrue: [		1 to: 0 by: -1 do: [:i |			| index |			index := aMorph selectionInterval start - 1 - i.			(aMorph text attributesAt: index)				detect: [:ea | ea anchoredMorph isKindOf: PReplacementPluggable]				ifFound: [:ea | | childShard |					childShard := ea anchoredMorph firstSubmorph.					anEvent hand newKeyboardFocus: childShard view.					aMorph selectFrom: (anEvent shiftPressed ifFalse: [index] ifTrue: [aMorph selectionInterval stop + 1]) to: (anEvent shiftPressed ifFalse: [index - 1] ifTrue: [index]).					childShard view selectFrom: childShard view text size - (1 - i) + 1 to: childShard view text size - (1 - i).					^ anEvent wasHandled: true]]].	anEvent keyCharacter = Character arrowRight ifTrue: [		1 to: 0 by: -1 do: [:i |			| index |			index := aMorph selectionInterval stop + 1 + i.			(aMorph text attributesAt: index)				detect: [:ea | ea anchoredMorph isKindOf: PReplacementPluggable]				ifFound: [:ea | | childShard |					childShard := ea anchoredMorph firstSubmorph.					anEvent hand newKeyboardFocus: childShard view.					aMorph selectFrom: (anEvent shiftPressed ifFalse: [index] ifTrue: [aMorph selectionInterval start]) to: (anEvent shiftPressed ifFalse: [index - 1] ifTrue: [index - 1]).					childShard view selectFrom: (1 - i) + 1 to: 1 - i.					^ anEvent wasHandled: true]]].		^ anEvent! !!PShard methodsFor: 'utils' stamp: 'tobe 12/8/2025 21:52'!findChange: aString b: anotherString preferredPos: preferredPos preferredSide: preferredSide	| diff |	diff := self findDiff: aString b: anotherString preferredPos: preferredPos preferredSide: preferredSide.	diff ifNil: [^ nil].		^ ((diff at: #from) = (diff at: #toB)		ifTrue: [			{				#delete -> (aString copyFrom: (diff at: #from) to: (diff at: #toA) - 1).				#from -> (diff at: #from).				#to -> (diff at: #toA)}]		ifFalse: [			{				#insert -> (anotherString					copyFrom: (diff at: #from)					to: (diff at: #toB) - 1).				#from -> (diff at: #from).				#to -> (diff at: #toA)}]) as: Dictionary! !!PShard methodsFor: 'utils' stamp: 'tobe 4/13/2024 08:29'!findDiff: aString b: anotherString preferredPos: myPreferredPos preferredSide: preferredSide	| minLen from toA toB adjust move preferredPos |	"copied from codemirror: detect the change between to strings at the cursor position.	`preferredSide` should be 'end' if backspace was pressed"	preferredPos := myPreferredPos.	minLen := aString size min: anotherString size.	from := 1.	[from <= minLen and: [(aString at: from) = (anotherString at: from)]] whileTrue: [from := from + 1].	(from = minLen and: [aString size = anotherString size]) ifTrue: [^ nil].	toA := aString size + 1.	toB := anotherString size + 1.	[(toA > 1 and: [toB > 1]) and: [(aString at: toA - 1) = (anotherString at: toB - 1)]] whileTrue: [		toA := toA - 1.		toB := toB - 1].		preferredSide = #end ifTrue: [		adjust := from - (toA min: toB) max: 0.		preferredPos := preferredPos - (toA + adjust - from)].		(toA < from and: [aString size < anotherString size])		ifTrue: [			move := (preferredPos <= from and: [preferredPos >= toA])				ifTrue: [from - preferredPos]				ifFalse: [0].			from := from - move.			toB := from + (toB - toA).			toA := from]		ifFalse: [			toB < from ifTrue: [				move := (preferredPos <= from and: [preferredPos >= toB])					ifTrue: [from - preferredPos]					ifFalse: [0].				from := from - move.				toA := from + (toA - toB).				toB := from]].	^ {#from -> from. #toA -> toA. #toB -> toB} as: Dictionary! !!PShard methodsFor: 'as yet unclassified' stamp: 'ct 12/21/2025 23:15'!initialize	super initialize.		replacements := SortedCollection sortBlock: [:a :b | a range first < b range first].	attributes := OrderedCollection new.	extensions := [{}].		view := PluggableTextMorphPlus new		setSelection: (0 to: 0);		model: self;		editTextSelector: #onChange:;		setText: '';		hResizing: #shrinkWrap;		vResizing: #shrinkWrap;		yourself.	view addKeyboardCaptureFilter: self.	view addKeyboardBubbleFilter: self.	view addMouseCaptureFilter: self.	view addMouseBubbleFilter: self.	self		addMorph: view;		changeTableLayout;		color: Color transparent;		hResizing: #shrinkWrap;		vResizing: #shrinkWrap! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/15/2024 14:14'!installReplacement: aReplacementDefinition for: aNode	| replacement |	" if we contain another replacement, uninstall that replacement first "	self replacements copy do: [:r | (r node hasAnyParent: aNode) ifTrue: [self uninstallReplacement: r]].		replacement := aReplacementDefinition buildReplacement		definition: aReplacementDefinition;		editor: self editor;		node: aNode.		replacements add: replacement! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/15/2024 14:08'!isShowing: aNode	(self nodes anySatisfy: [:node | aNode hasAnyParent: node]) ifFalse: [^ false].		self replacements do: [:r | (aNode hasAnyParent: r node) ifTrue: [^ false]].		^ true! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/15/2024 16:56'!isShowingIndex: aNumber	(self range includes: aNumber) ifFalse: [^ false].		self replacements do: [:r | (r range containsIndex: aNumber) ifTrue: [^ false]].		^ true! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 08:10'!nodes	^ nodes! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 20:51'!nodes: aCollection	nodes := aCollection.		lastActualSourceString ifNil: [		self editor models keysAndValuesDo: [:model :root |			self				updateReplacementsFor: (PEditScript new					initPos: (Array streamContents: [:s | root firstChildrenInRange: self range do: [:node | s nextPutAll: node initOperations]])					neg: {})				root: root].		self updateText]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 18:15'!onChange: aNewString	| change |	change := self		findChange: lastActualSourceString		b: aNewString string		preferredPos: self editor selectionRange first		preferredSide: nil.		((change includesKey: #delete) and: [(change at: #delete) = Character startOfHeader asString])		ifTrue: [ | replacement |			replacement := self replacementForStartIndex: (self adjustLocalIndex: (change at: #from) - 1).			self editor applyChanges: {				(PChange range: (replacement range last - 1 to: replacement range last) insert: '')					sourceShard: self;					sideAffinity: ((change at: #from) = 1 ifTrue: [1] ifFalse: [-1])}]		ifFalse: [ | string |			string := (change at: #insert ifAbsent: ['']) string.			self assert: [(string includes: Character startOfHeader) not].			self editor applyChanges: {				(PChange					range: ((self adjustLocalIndex: (change at: #from) - 1) to: (self adjustLocalIndex: (change at: #to) - 1))					insert: string)					sourceShard: self;					sideAffinity: ((self isShowingIndex: (change at: #from) - 1) ifTrue: [-1] ifFalse: [1])}]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 07:51'!range	^ self editor adjustRange: (PRange indexStart: self nodes first range first end: self nodes last range last)! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/15/2024 11:15'!replacementForStartIndex: aNumber	^ self replacements detect: [:r | r range first = aNumber]! !!PShard methodsFor: 'replacements' stamp: 'tobe 4/13/2024 10:23'!replacements	^ replacements! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 21:07'!requiredModels	^ (extensions value gather: [:ext | (ext markerDefinitions collect: #model), (ext replacementDefinitions collect: #model)]) asSet! !!PShard methodsFor: 'marker api' stamp: 'tobe 4/17/2024 11:49'!styleAdd: anAttribute for: aNode definition: aDefinition	^ attributes add: (PMarker new		definition: aDefinition;		node: aNode;		attribute: anAttribute)! !!PShard methodsFor: 'marker api' stamp: 'tobe 4/17/2024 11:49'!styleRemove: aMarker	attributes remove: aMarker! !!PShard methodsFor: 'replacements' stamp: 'tobe 12/22/2025 13:24'!uninstallReplacement: aReplacement	aReplacement beforeUninstall.		replacements remove: aReplacement.		aReplacement delete! !!PShard methodsFor: 'replacements' stamp: 'tobe 12/22/2025 13:39'!updateReplacementsFor: anEditScript root: aRoot	anEditScript removeDo: [:op |		self replacements detect: [:r | op node = r node] ifFound: [:r |			self uninstallReplacement: r].		attributes do: [:attr | op node = attr node ifTrue: [attr definition detach value: self value: op node value: attr]]].		extensions value do: [:ext |		(ext replacementDefinitions select: [:def | def model = aRoot language]) do: [:def |			self				allVisibleNodesDo: [:node | | matches |					matches := (PQuery script: def query with: node) notNil.					self replacements						detect: [:r | r definition name = def name and: [node = r node]]						ifFound: [:r | matches ifFalse: [self uninstallReplacement: r]]						ifNone: [matches ifTrue: [self installReplacement: def for: node]]]				root: aRoot]].		extensions value do: [:ext |		(ext markerDefinitions select: [:def | def model = aRoot language]) do: [:def |			self				allVisibleNodesDo: [:node | | matches |					matches := (PQuery script: def query with: node) notNil.					attributes						detect: [:attr | attr definition name = def name and: [node = attr node]]						ifFound: [:attr | matches ifFalse: [def detach value: self value: node value: attr]]						ifNone: [matches ifTrue: [def attach value: self value: node]]]				root: aRoot]]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 12/22/2025 09:44'!updateText	| out myRange |	(nodes allSatisfy: [:node | node isInTree]) ifFalse: [^ self].	out := (self nodes inject: '' into: [:text :node | text, node sourceString]) asText.		self editor pendingChanges withIndexDo: [:change :index |		myRange := PRange			indexStart: (self editor				adjustIndex: self nodes first range first				forChangeList: self editor pendingChanges				upTo: index - 1				sideAffinity: 1)			end: (self editor				adjustIndex: self nodes last range last				forChangeList: self editor pendingChanges				upTo: index - 1				sideAffinity: -1).				" TODO: show subrange if intersects "		(myRange includesChange: change) ifTrue: [			self				updateText: out				replaceFrom: change from - myRange first + 1				to: change to - myRange first				with: change insert]].		myRange := PRange		indexStart: (self editor			adjustIndex: self nodes first range first			forChangeList: self editor pendingChanges			sideAffinity: 1)		end: (self editor			adjustIndex: self nodes last range last			forChangeList: self editor pendingChanges			sideAffinity: -1).	attributes do: [:marker |		out			addAttribute: marker attribute			from: marker node range first - myRange first + 1			to: marker node range last - myRange first].		replacements do: [:r |		r localRangeIn: self do: [:from :to |			out				replaceFrom: from				to: to				with: (Text string: Character startOfHeader asString attribute: r asTextAnchor)]].		view setText: out.	lastActualSourceString := out string! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 09:44'!updateText: aText replaceFrom: aNumber to: anotherNumber with: aStringOrNil	aNumber <= aText size		ifTrue: [aText replaceFrom: aNumber to: anotherNumber with: (aStringOrNil ifNil: [''])]		ifFalse: [			self assert: (aNumber = (aText size + 1) and: [anotherNumber = (aText size)]).			aText append: (aStringOrNil ifNil: [''])]! !!PShard methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:03'!view	^ view! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:22'!testApplyChange	| e |	e := PEditorState new.		e sourceString: 'abc'.		e applyChanges: {PChange range: (1 to: 1) insert: '1'}.	self assert: 'a1bc' equals: e rootShard view text string.		e applyChanges: {PChange range: (1 to: 1) insert: '2'}.	self assert: 'a21bc' equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:40'!testApplyChangeInReplacement	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123'.	self assert: Character startOfHeader asString equals: e rootShard view text string.		e applyChanges: {PChange range: (1 to: 1) insert: '4'}.	self assert: Character startOfHeader asString equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:40'!testApplyChangeInReplacementRemovesIt	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123'.	e applyChanges: {PChange range: (0 to: 0) insert: 'a'}.	self assert: 'a123' equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:23'!testApplyRejectedChange	| e |	e := PEditorState new.	e registerValidation: [:root :change :diff | false] for: PBaseParser.	e sourceString: '123'.		e applyChanges: {PChange range: (0 to: 0) insert: 'a'}.	self assert: 'a123' equals: e rootShard view text string.	self assert: '123' equals: e sourceString.		e applyPendingChanges.	self assert: 'a123' equals: e rootShard view text string.	self assert: 'a123' equals: e sourceString! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:40'!testBackspaceIntoReplacementCharacter	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		deletionInteraction: #character;		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '12'.		e rootShard onChange: ''.	self assert: Character startOfHeader asString equals: e rootShard view text string.	self assert: '1' equals: e sourceString.		e rootShard onChange: ''.	self assert: '' equals: e rootShard view text string.	self assert: '' equals: e sourceString! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testEmbeddedShard	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		query: {[:x | x type = #number]. [:x | x parent type = #array]};		model: PSmalltalkParser;		init: [:node :replacement | | s |				s := replacement setProperty: #s toValue: replacement createShard.				replacement addMorphBack: s]			update: [:node :replacement | (replacement valueOfProperty: #s) nodes: {node}]).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.		self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testEnterChangeAtStart	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123'.		e rootShard onChange: 'a', Character startOfHeader asString.	self assert: 'a123' equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 9/26/2024 13:23'!testFindChange	| change |	change := PShard new findChange: 'ab' b: 'acb' preferredPos: 1 preferredSide: nil.	self assert: ({#from -> 2. #to -> 2. #insert -> 'c'} as: Dictionary) equals: change! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 9/26/2024 13:23'!testFindChangeAtEnd	| change |	change := PShard new findChange: 'ab' b: 'abc' preferredPos: 1 preferredSide: nil.	self assert: ({#from -> 3. #to -> 3. #insert -> 'c'} as: Dictionary) equals: change! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 9/26/2024 13:23'!testFindChangeDelete	| change |	change := PShard new findChange: 'acb' b: 'ab' preferredPos: 1 preferredSide: nil.	self assert: ({#from -> 2. #to -> 3. #delete -> 'c'} as: Dictionary) equals: change! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 9/26/2024 13:23'!testFindChangeDeleteAtEnd	| change |	change := PShard new findChange: 'abc' b: 'ab' preferredPos: 1 preferredSide: nil.	self assert: ({#from -> 3. #to -> 4. #delete -> 'c'} as: Dictionary) equals: change! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testMarker	| e testExt attr |	attr := TextColor red.	testExt := PExtension new registerMarker: (PMarkerDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]};		style: attr).		e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: 'a+12'.		self assert: {attr} equals: (e rootShard view text attributesAt: 3).	self assert: {attr} equals: (e rootShard view text attributesAt: 4)! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testMultipleReplacements	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123+456'.	self		assert: Character startOfHeader asString, '+', Character startOfHeader asString		equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testOverlappingReplacements	| e testExt |	testExt := PExtension new		registerReplacement: (PReplacementDefinition new			name: 'test';			model: PSmalltalkParser;			query: {[:x | x type = #number]});		registerReplacement: (PReplacementDefinition new			name: 'test2';			model: PSmalltalkParser;			query: {[:x | x type = #array]}).		e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.		self assert: 1 equals: e rootShard replacements size.	self assert: Character startOfHeader asString equals: e rootShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:24'!testRejectChange	| e |	e := PEditorState new.	e registerValidation: [:root :change :diff | false] for: PBaseParser.	e sourceString: '123'.		e applyChanges: {PChange range: (0 to: 0) insert: 'a'}.	self assert: 'a123' equals: e rootShard view text string.	self assert: '123' equals: e sourceString! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRejectChangeAndEdit	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]. [:x | x parent type = #array]};		init: [:node :replacement | | s2 s1 |				s1 := replacement setProperty: #s1 toValue: replacement createShard.				s2 := replacement setProperty: #s2 toValue: replacement createShard.				replacement addMorphBack: s1.				replacement addMorphBack: s2]			update: [:node :replacement |				(replacement valueOfProperty: #s1) nodes: {node}.				(replacement valueOfProperty: #s2) nodes: {node}]).		e := PEditorState new.	e registerValidation: [:node :changes :script | false] for: PBaseParser.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.		self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.		e applyChanges: {(PChange range: (3 to: 3) insert: '3') sideAffinity: -1}.	self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.		self assert: 1 equals: e rootShard replacements size.	self assert: 3 equals: e shards size.	self		assert: {'123'. '123'}		equals: ((e shards reject: [:s | s = e rootShard]) collect: [:s | s view text string] as: Array)! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRejectResetsIndizes	| e |	e := PEditorState new.	e models at: PSmalltalkParser put: nil.	e registerValidation: [:node :changes :script | false] for: PBaseParser.	e sourceString: '12'.		e applyChanges: {PChange range: (2 to: 2) insert: '3'}.	self		assert: (PRange indexStart: 0 end: 2)		equals: (e models at: PSmalltalkParser) baseChildren first baseChildren first range! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRejectedChangeAffinity	| e testExt nestedShard |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]. [:x | x parent type = #array]};		init: [:node :replacement | replacement addMorphBack: (replacement setProperty: #s1 toValue: replacement createShard)]			update: [:node :replacement | (replacement valueOfProperty: #s1) nodes: {node}]).		e := PEditorState new.	e registerValidation: [:node :changes :script | false] for: PBaseParser.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.	nestedShard := e shards detect: [:s | s ~= e rootShard].		self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.		nestedShard onChange: '123'.	self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.	self assert: '123' equals: nestedShard view text string.		e rootShard onChange: '[', Character startOfHeader, '4]'.	self assert: '[', Character startOfHeader, '4]' equals: e rootShard view text string.	self assert: '123' equals: nestedShard view text string! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRejectedChangesIndex	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]. [:x | x parent type = #array]};		init: [:node :replacement | | s2 s1 |				s1 := replacement setProperty: #s1 toValue: replacement createShard.				s2 := replacement setProperty: #s2 toValue: replacement createShard.				replacement addMorphBack: s1.				replacement addMorphBack: s2]			update: [:node :replacement |				(replacement valueOfProperty: #s1) nodes: {node}.				(replacement valueOfProperty: #s2) nodes: {node}]).		e := PEditorState new.	e registerValidation: [:node :changes :script | false] for: PBaseParser.	e rootShard extensions: [{testExt}].	e sourceString: '[12]'.		self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.		e applyChanges: {PChange range: (1 to: 1) insert: '3'}.	self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.	self		assert: {'312'. '312'}		equals: ((e shards reject: [:s | s = e rootShard]) collect: [:s | s view text string] as: Array).		e applyChanges: {(PChange range: (4 to: 4) insert: '4') sideAffinity: -1}.	self assert: '[', Character startOfHeader, ']' equals: e rootShard view text string.	self		assert: {'3124'. '3124'}		equals: ((e shards reject: [:s | s = e rootShard]) collect: [:s | s view text string] as: Array)! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testRemoveIndent	| removeIndentExt testExt e |	removeIndentExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'indent';		model: PWhitespaceParser;		query: {[:x | x type = #tab and: [x childBefore type = #newline]]};		init: [:node :replacement | replacement extent: 0 @ 0] update: [:node :replacement | ]).	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #program]};		init: [:node :replacement | replacement addMorphBack: (replacement createShard extensions: [{removeIndentExt}])]			update: [:node :replacement | replacement firstSubmorph nodes: {node queryFirst: '(method_definition) @'}]).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: 'class A {	constructor() {		console.log("b");	}}'! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:27'!testRevertRejectedChange	| e |	e := PEditorState new.	e registerValidation: [:root :change :diff | false] for: PBaseParser.	e sourceString: '123'.		e applyChanges: {PChange range: (0 to: 0) insert: 'a'}.	self assert: 'a123' equals: e rootShard view text string.	self assert: '123' equals: e sourceString.		e revertPendingChanges.	self assert: '123' equals: e rootShard view text string.	self assert: '123' equals: e sourceString! !!PEditorTest methodsFor: 'as yet unclassified' stamp: 'tobe 12/8/2025 20:41'!testToggleReplacement	| e testExt |	testExt := PExtension new registerReplacement: (PReplacementDefinition new		name: 'test';		model: PSmalltalkParser;		query: {[:x | x type = #number]}).	e := PEditorState new.	e rootShard extensions: [{testExt}].	e sourceString: '123'.		e rootShard onChange: 'a', Character startOfHeader asString.	self assert: 'a123' equals: e rootShard view text string.		e rootShard onChange: '123'.	self assert: Character startOfHeader asString equals: e rootShard view text string.		e rootShard onChange: 'a', Character startOfHeader asString.	self assert: 'a123' equals: e rootShard view text string! !!PBaseParser class methodsFor: 'as yet unclassified' stamp: 'tobe 4/20/2024 08:21'!parse: aString old: aNode	| doc |	doc := PNode new		type: 'document';		language: self;		range: (PRange indexStart: 0 end: aString size);		privateSource: aString.	^ doc! !!PBaseParser class methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 18:11'!rootRuleName	^ 'document'! !!PChange class methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:53'!range: aRange insert: aString	^ self new		from: aRange first;		to: aRange last;		insert: aString! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 09:40'!applyTo: aString	^ (aString copyFrom: 1 to: self from), (self insert ifNil: ['']), (aString copyFrom: self to + 1 to: aString size)! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!from	^ from! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!from: aNumber	from := aNumber! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!insert	^ insert! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!insert: aString	insert := aString! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 08:28'!sideAffinity	^ sideAffinity! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/16/2024 08:28'!sideAffinity: aNumber	sideAffinity := aNumber! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 09:55'!sourceShard	^ sourceShard! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 09:55'!sourceShard: aShard	sourceShard := aShard! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!to	^ to! !!PChange methodsFor: 'as yet unclassified' stamp: 'tobe 4/12/2024 10:46'!to: aNumber	to := aNumber! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/19/2024 20:43'!initialize	super initialize.		replacementDefinitions := OrderedCollection new.	markerDefinitions := OrderedCollection new! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:45'!markerDefinitions	^ markerDefinitions! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 09:37'!registerMarker: aMarker	markerDefinitions add: aMarker! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:11'!registerReplacement: aReplacement	replacementDefinitions add: aReplacement! !!PExtension methodsFor: 'as yet unclassified' stamp: 'tobe 4/13/2024 10:11'!replacementDefinitions	^ replacementDefinitions! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:48'!attribute	^ attribute! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:52'!attribute: aTextAttribute	attribute := aTextAttribute! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:47'!definition	^ definition! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:47'!definition: aDefinition	definition := aDefinition! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe 4/17/2024 11:47'!node	^ node! !!PMarker methodsFor: 'as yet unclassified' stamp: 'tobe