Value:"	scroller hasSubmorphs ifFalse: [^ self].	scroller offset: scroller offset x @ (self leftoverScrollRange y * scrollValue)! !!TwoWayScrollPane methodsFor: 'scroll bar events' stamp: 'RAA 8/13/1999 15:55' prior: 36248189!yScrollBarValue: scrollValue	"although there appear to be no senders, see Slider>>setValue:"	scroller hasSubmorphs ifFalse: [^ self].	scroller offset: scroller offset x @ (self leftoverScrollRange y * scrollValue)! !!TwoWayScrollPane methodsFor: 'scroll bar events' stamp: 'RAA 6/12/2000 09:01' prior: 118684791!yellowButtonActivity: shiftKeyState	| menu |	(menu := self getMenu: shiftKeyState) ifNotNil:		[menu setInvokingView: self.		menu popUpEvent: self activeHand lastEvent in: self world]! !!TwoWayScrollPane methodsFor: 'scroll bar events' stamp: 'RAA 6/12/2000 09:01' prior: 36248828!yellowButtonActivity: shiftKeyState	| menu |	(menu := self getMenu: shiftKeyState) ifNotNil:		[menu setInvokingView: self.		menu popUpEvent: self activeHand lastEvent in: self world]! !!TwoWayScrollPane commentStamp: '<historical>' prior: 0!TwoWayScrollPane is now obsolete.  You should be able to use ScrollPane to do both vertical and horizontal scrolling.As an example, see Morph>>inATwoWayScrollPane and change the first line to create a ScrollPane instead of a TwoWayScrollPane.  It will still work.(EllipseMorph new extent: 200@150) inATwoWayScrollPane openInWorldNote that user preferences for ScrollPane may be geared toward text scrolling, so that the horizontal scrollbar may be hidden when not needed, while the vertical scrollbar is always shown.  Use ScrollPane>>alwaysShowHScrollbar: or its variants to adjust this if you want the vertical & horizontal scrollbars to be shown consistently.!TwoWayScrollPane class	instanceVariableNames: ''!!TwoWayScrollPane class methodsFor: '*Etoys-new-morph participation' stamp: 'di 2/21/98 11:02' prior: 118685653!includeInNewMorphMenu	"OK to instantiate"	^ true! !Object subclass: #TextContainer	instanceVariableNames: 'textMorph shadowForm vertProfile minWidth rectangleCache fillsOwner avoidsOcclusions'	classVariableNames: 'OuterMargin'	poolDictionaries: ''	category: 'Morphic-Text Support'!!TextContainer methodsFor: 'private' stamp: 'mt 8/29/2023 14:54' prior: 99028395!bounds	| bounds theText |	self fillsOwner ifFalse: [^ textMorph textBounds].	textMorph owner ifNil: [^ textMorph textBounds].	theText := textMorph.	bounds := theText owner innerBounds.	bounds := bounds insetBy: (textMorph valueOfProperty: #margins ifAbsent: [1@1]).	theText owner submorphsBehind: theText do:		[:m | bounds swallow: m fullBounds].	^ bounds! !Morph subclass: #PluggableTabButtonMorph	instanceVariableNames: 'active model textSelector arcLengths subMorph'	classVariableNames: ''	poolDictionaries: ''	category: 'Etoys-Morphic-Pluggable Widgets'!!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:25' prior: 63564761!active	active ifNil: [ active := false ].	^ active! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:25' prior: 36251242!active	active ifNil: [ active := false ].	^ active! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:26' prior: 63565042!active: aBoolean	active := aBoolean.	self changed.! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:26' prior: 36251540!active: aBoolean	active := aBoolean.	self changed.! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 2/2/2004 14:05' prior: 63565174!innerExtent: aPoint	"Set the extent based on the primary visible part of the tab.  In other words add twice the cornerRadius to this extent"	self extent: (aPoint x + (self cornerRadius * 2)) @ (aPoint y)! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 2/2/2004 14:05' prior: 36251837!innerExtent: aPoint	"Set the extent based on the primary visible part of the tab.  In other words add twice the cornerRadius to this extent"	self extent: (aPoint x + (self cornerRadius * 2)) @ (aPoint y)! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:39' prior: 63565460!model	^ model! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:39' prior: 36252440!model	^ model! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:39' prior: 63565686!model: anObject	model := anObject! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:39' prior: 36252664!model: anObject	model := anObject! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 2/2/2004 14:07' prior: 63565800!outerGap	"The horizontal distance of the outer left and right edges of the tab excluding the inner visible part"	^ self cornerRadius * 2! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 2/2/2004 14:07' prior: 36252925!outerGap	"The horizontal distance of the outer left and right edges of the tab excluding the inner visible part"	^ self cornerRadius * 2! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:39' prior: 63566019!textSelector	^ textSelector! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:39' prior: 36253394!textSelector	^ textSelector! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:39' prior: 63566271!textSelector: aSymbol	textSelector := aSymbol! !!PluggableTabButtonMorph methodsFor: 'access' stamp: 'KLC 1/22/2004 14:39' prior: 36253646!textSelector: aSymbol	textSelector := aSymbol! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 14:36' prior: 63573386!arcLengths	arcLengths ifNil: [ self calculateArcLengths ].	^ arcLengths! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 14:36' prior: 36253942!arcLengths	arcLengths ifNil: [ self calculateArcLengths ].	^ arcLengths! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 14:37' prior: 63573719!arcLengths: anArrayOfIntegers	arcLengths := anArrayOfIntegers! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 14:37' prior: 36254302!arcLengths: anArrayOfIntegers	arcLengths := anArrayOfIntegers! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 11:30' prior: 63573873!cornerRadius	^ 5! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 11:30' prior: 36254642!cornerRadius	^ 5! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 16:40' prior: 63573982!subMorph	subMorph ifNil: [ self update: self textSelector ].	^ subMorph! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 16:40' prior: 36254892!subMorph	subMorph ifNil: [ self update: self textSelector ].	^ subMorph! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 16:40' prior: 63574289!subMorph: aMorph	subMorph := aMorph! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 16:40' prior: 36255252!subMorph: aMorph	subMorph := aMorph! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 11:30' prior: 63574417!topInactiveGap	^ 5! !!PluggableTabButtonMorph methodsFor: 'private - access' stamp: 'KLC 1/23/2004 11:30' prior: 36255540!topInactiveGap	^ 5! !!PluggableTabButtonMorph methodsFor: 'precalculations' stamp: 'KLC 1/23/2004 14:46' prior: 63571860!calculateArcLengths	| array radius |	radius := self cornerRadius.	array := Array new: radius.		1 to: radius do: [ :i | | x |		x := i - 0.5.		array at: i		 	put: (radius - ((2 * x * radius) - (x * x)) sqrt) asInteger].			self arcLengths: array! !!PluggableTabButtonMorph methodsFor: 'precalculations' stamp: 'KLC 1/23/2004 14:46' prior: 36255791!calculateArcLengths	| array radius |	radius := self cornerRadius.	array := Array new: radius.		1 to: radius do: [ :i | | x |		x := i - 0.5.		array at: i		 	put: (radius - ((2 * x * radius) - (x * x)) sqrt) asInteger].			self arcLengths: array! !!PluggableTabButtonMorph methodsFor: 'drawing' stamp: 'KLC 1/23/2004 15:49' prior: 63566519!drawOn: aCanvas	self drawTabOn: aCanvas.	self drawSubMorphOn: aCanvas! !!PluggableTabButtonMorph methodsFor: 'drawing' stamp: 'KLC 1/23/2004 15:49' prior: 36256499!drawOn: aCanvas	self drawTabOn: aCanvas.	self drawSubMorphOn: aCanvas! !!PluggableTabButtonMorph methodsFor: 'drawing' stamp: 'KLC 9/17/2004 11:24' prior: 63567493!drawSubMorphOn: aCanvas	| morphBounds |	morphBounds := self bounds insetBy: (self cornerRadius + 3) @ (self topInactiveGap // 2 + 2).	morphBounds := morphBounds translateBy: 0@(self topInactiveGap // 2 + 1).	self active ifTrue: [		morphBounds := morphBounds translateBy: 0@((self topInactiveGap // 2 + 1) negated)].	self subMorph bounds height < (morphBounds height)		ifTrue: [			morphBounds := morphBounds				insetBy: 0@((morphBounds height - self subMorph bounds height) // 2)].	self subMorph bounds width < (morphBounds width)		ifTrue: [			morphBounds := morphBounds				insetBy: ((morphBounds width - self subMorph bounds width) // 2)@0].	self subMorph bounds: morphBounds.				aCanvas drawMorph: self subMorph! !!PluggableTabButtonMorph methodsFor: 'drawing' stamp: 'KLC 9/17/2004 11:24' prior: 36256837!drawSubMorphOn: aCanvas	| morphBounds |	morphBounds := self bounds insetBy: (self cornerRadius + 3) @ (self topInactiveGap // 2 + 2).	morphBounds := morphBounds translateBy: 0@(self topInactiveGap // 2 + 1).	self active ifTrue: [		morphBounds := morphBounds translateBy: 0@((self topInactiveGap // 2 + 1) negated)].	self subMorph bounds height < (morphBounds height)		ifTrue: [			morphBounds := morphBounds				insetBy: 0@((morphBounds height - self subMorph bounds height) // 2)].	self subMorph bounds width < (morphBounds width)		ifTrue: [			morphBounds := morphBounds				insetBy: ((morphBounds width - self subMorph bounds width) // 2)@0].	self subMorph bounds: morphBounds.				aCanvas drawMorph: self subMorph! !!PluggableTabButtonMorph methodsFor: 'drawing' stamp: 'KLC 2/2/2004 15:07' prior: 63569842!drawTabOn: aCanvas	| top myColor cornerRadius myArcLengths myBounds |	cornerRadius := self cornerRadius.	myBounds := self bounds.	self active		ifTrue: [ top := myBounds top.			myColor := self color ]		ifFalse: [ top := myBounds top + self topInactiveGap.			myColor := self color whiter whiter ].	aCanvas fillRectangle:		((myBounds left + cornerRadius)				@ (top + cornerRadius)			corner: (myBounds right - cornerRadius)						@ self bottom)		color: myColor.	aCanvas fillRectangle:		((myBounds left + (cornerRadius * 2)) @ top			corner: (myBounds right - (cornerRadius * 2))				@ (top + cornerRadius))		color: myColor.	aCanvas fillOval:		((myBounds left + self cornerRadius) @ top			corner: (myBounds left + (self cornerRadius * 3))				@ (top + (self cornerRadius * 2)))		color: myColor.	aCanvas fillOval:		((myBounds right - (self cornerRadius * 3)) @ top			corner: (myBounds right - self cornerRadius)				@ (top + (self cornerRadius * 2)))		color: myColor.	myArcLengths := self arcLengths.	1 to: myArcLengths size do: [ :i | | length |		length := myArcLengths at: i.		aCanvas line: (myBounds left + cornerRadius - i) @ (myBounds bottom - 1 )			to: (myBounds left + cornerRadius - i) @ (myBounds bottom - length - 1)			color: myColor.		aCanvas line: (myBounds right - cornerRadius + i - 1) @ (myBounds bottom - 1)			to: (myBounds right - cornerRadius + i - 1) @ (myBounds bottom - length - 1)			color: myColor]	! !!PluggableTabButtonMorph methodsFor: 'drawing' stamp: 'KLC 2/2/2004 15:07' prior: 36258488!drawTabOn: aCanvas	| top myColor cornerRadius myArcLengths myBounds |	cornerRadius := self cornerRadius.	myBounds := self bounds.	self active		ifTrue: [ top := myBounds top.			myColor := self color ]		ifFalse: [ top := myBounds top + self topInactiveGap.			myColor := self color whiter whiter ].	aCanvas fillRectangle:		((myBounds left + cornerRadius)				@ (top + cornerRadius)			corner: (myBounds right - cornerRadius)						@ self bottom)		color: myColor.	aCanvas fillRectangle:		((myBounds left + (cornerRadius * 2)) @ top			corner: (myBounds right - (cornerRadius * 2))				@ (top + cornerRadius))		color: myColor.	aCanvas fillOval:		((myBounds left + self cornerRadius) @ top			corner: (myBounds left + (self cornerRadius * 3))				@ (top + (self cornerRadius * 2)))		color: myColor.	aCanvas fillOval:		((myBounds right - (self cornerRadius * 3)) @ top			corner: (myBounds right - self cornerRadius)				@ (top + (self cornerRadius * 2)))		color: myColor.	myArcLengths := self arcLengths.	1 to: myArcLengths size do: [ :i | | length |		length := myArcLengths at: i.		aCanvas line: (myBounds left + cornerRadius - i) @ (myBounds bottom - 1 )			to: (myBounds left + cornerRadius - i) @ (myBounds bottom - length - 1)			color: myColor.		aCanvas line: (myBounds right - cornerRadius + i - 1) @ (myBounds bottom - 1)			to: (myBounds right - cornerRadius + i - 1) @ (myBounds bottom - length - 1)			color: myColor]	! !!PluggableTabButtonMorph methodsFor: 'initialization' stamp: 'KLC 1/22/2004 16:45' prior: 63571383!initialize	^ super initialize! !!PluggableTabButtonMorph methodsFor: 'initialization' stamp: 'KLC 1/22/2004 16:45' prior: 36261592!initialize	^ super initialize! !!PluggableTabButtonMorph methodsFor: 'stepping' stamp: 'KLC 2/2/2004 10:15' prior: 63572195!step	self subMorph step.	self changed.! !!PluggableTabButtonMorph methodsFor: 'stepping' stamp: 'KLC 2/2/2004 10:15' prior: 36261857!step	self subMorph step.	self changed.! !!PluggableTabButtonMorph methodsFor: 'stepping' stamp: 'KLC 1/23/2004 17:31' prior: 63572319!stepTime	^ self subMorph stepTime! !!PluggableTabButtonMorph methodsFor: 'stepping' stamp: 'KLC 1/23/2004 17:31' prior: 36262136!stepTime	^ self subMorph stepTime! !!PluggableTabButtonMorph methodsFor: 'stepping' stamp: 'KLC 1/23/2004 17:31' prior: 63572437!wantsSteps	^ self subMorph wantsSteps! !!PluggableTabButtonMorph methodsFor: 'stepping' stamp: 'KLC 1/23/2004 17:31' prior: 36262404!wantsSteps	^ self subMorph wantsSteps! !!PluggableTabButtonMorph methodsFor: 'actions' stamp: 'KLC 1/23/2004 15:38' prior: 63566400!toggle	self active: self active not! !!PluggableTabButtonMorph methodsFor: 'actions' stamp: 'KLC 1/23/2004 15:38' prior: 36262677!toggle	self active: self active not! !!PluggableTabButtonMorph methodsFor: 'updating' stamp: 'KLC 1/23/2004 17:02' prior: 63572975!update: aSelector	self textSelector ifNotNil: [		aSelector = self textSelector			ifTrue: [ | morph |				(aSelector isSymbol and: [model notNil])					ifTrue: [						morph :=							(self model perform: aSelector) asMorph]					ifFalse: [ morph := aSelector value asMorph].				self subMorph: morph]].	self changed! !!PluggableTabButtonMorph methodsFor: 'updating' stamp: 'KLC 1/23/2004 17:02' prior: 36262946!update: aSelector	self textSelector ifNotNil: [		aSelector = self textSelector			ifTrue: [ | morph |				(aSelector isSymbol and: [model notNil])					ifTrue: [						morph :=							(self model perform: aSelector) asMorph]					ifFalse: [ morph := aSelector value asMorph].				self subMorph: morph]].	self changed! !!PluggableTabButtonMorph commentStamp: 'KLC 9/17/2004 11:27' prior: 0!This is a specialized pluggable button morph that is meant to represent a tab in a set of tabs arranged horizontally.  Each tab will overlap slightly when drawn.  All but one tab will be drawn in left to right order in the specified color, but lighter.  The active tab will be drawn last in the full color and slightly taller to indicate that it is selected.  Clicking the active tab has no effect but clicking any other tab will change the active tab to the clicked tab.This morph does not itself accept any events.  The parent tab set will grab the mouse clicks and handle notifying the appropriate tabs that they have been activated or deactivated.There is a single selector which provides the text for the button label and affects the width of the tab.  When the width changes the tab will inform its parent that it has changed and that the layout needs to be updated.  The model for the text selector of course should be the client for the tab set.The button label can be a String, Text, or Morph.  Texts work better than plain Strings.!PluggableTabButtonMorph class	instanceVariableNames: ''!!PluggableTabButtonMorph class methodsFor: 'instance creation' stamp: 'KLC 1/22/2004 14:46' prior: 63574919!on: anObject label: getTextSelector	| instance |	instance := super new.	instance model: anObject.	instance textSelector: getTextSelector.	^ instance ! !!PluggableTabButtonMorph class methodsFor: 'instance creation' stamp: 'KLC 1/22/2004 14:46' prior: 36264977!on: anObject label: getTextSelector	| instance |	instance := super new.	instance model: anObject.	instance textSelector: getTextSelector.	^ instance ! !DataType subclass: #ColorType	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Protocols-Type Vocabularies'!!ColorType methodsFor: '*Etoys-initial value' stamp: 'sw 9/27/2001 17:28' prior: 23337037!initialValueForASlotFor: aPlayer	"Answer the value to give initially to a newly created slot of the given type in the given player"	^ Color random! !Object subclass: #Compiler	instanceVariableNames: 'parser cue'	classVariableNames: ''	poolDictionaries: ''	category: 'Compiler-Kernel'!!Compiler methodsFor: 'public access' stamp: 'ct 2/24/2024 21:05' prior: 23835436!compiledMethodFor: textOrStream in: aContext to: receiver notifying: aRequestor ifFail: failBlock	^ self		compiledMethodFor: textOrStream		in: aContext		to: receiver		notifying: aRequestor		ifFail: failBlock		logged: false! !!Compiler methodsFor: 'public access' stamp: 'nice 7/3/2025 22:45' prior: 23848500!parser	parser ifNil:		[self parserClass: ((cue ifNotNil: [cue getClass])				ifNil: [self preferredParserClass ]				ifNotNil: [:targetClass | targetClass parserClass])].	^parser! !!Compiler methodsFor: 'public access' stamp: 'nice 10/21/2025 15:13' prior: 36266340!parser	parser ifNil:		[self parserClass: ((cue ifNotNil: [cue getClass])				ifNil: [self class preferredParserClass ]				ifNotNil: [:targetClass | targetClass parserClass])].	^parser! !!Compiler methodsFor: 'private' stamp: 'ct 2/24/2024 21:04' prior: 23851082!evaluateCue: aCue ifFail: failBlock	^ self		evaluateCue: aCue		ifFail: failBlock		logged: false! !!Compiler methodsFor: 'private' stamp: 'ct 2/24/2024 21:26' prior: 23852586!evaluateCue: aCue ifFail: failBlock logged: logFlag	"Compiles the cue source into a parse tree, then generates code into	a method. Finally, the compiled method is invoked from here via 	withArgs:executeMethod:, hence the system no longer creates Doit method	litter on errors."	| methodNode method value |	methodNode := self compileCue: aCue noPattern: true ifFail: [^failBlock value].	method := self interactive				ifTrue: [methodNode generateWithTempNames]				ifFalse: [methodNode generate].	value := cue receiver				withArgs: (cue context ifNil: [#()] ifNotNil: [{cue context}])				executeMethod: method.		logFlag ifTrue:		[SystemChangeNotifier uniqueInstance			evaluated: (methodNode basicSourceText ifNil: [cue stringToLog]) "honor possible source updates (e.g., due to ReparseAfterSourceEditing)"			context: cue context].		^ value! !!Compiler methodsFor: 'public access logging' stamp: 'ct 2/24/2024 21:26' prior: 23861721!compiledMethodFor: textOrStream in: aContext to: receiver notifying: aRequestor ifFail: failBlock logged: logFlag	"Compiles the sourceStream into a parse tree, then generates code	 into a method, and answers it.  If receiver is not nil, then the text can	 refer to instance variables of that receiver (the Inspector uses this).	 If aContext is not nil, the text can refer to temporaries in that context	 (the Debugger uses this). If aRequestor is not nil, then it will receive a 	 notify:at: message before the attempt to evaluate is aborted."	| methodNode method |	methodNode := self		compileNoPattern: textOrStream		in: (self classForReceiver: receiver context: aContext)		context: aContext		notifying: aRequestor		ifFail: [^failBlock value].	method := self interactive		ifTrue: [ methodNode generateWithTempNames ] 		ifFalse: [ methodNode generate ].		logFlag ifTrue:		[SystemChangeNotifier uniqueInstance			evaluated: (methodNode basicSourceText ifNil: [cue stringToLog]) "honor possible source updates (e.g., due to ReparseAfterSourceEditing)"			context: aContext].		^method! !Compiler class	instanceVariableNames: ''!!Compiler class methodsFor: 'accessing' stamp: 'nice 7/3/2025 22:36' prior: 23879476!new	^ super new parserClass: self preferredParserClass! !!Compiler class methodsFor: 'accessing' stamp: 'nice 7/3/2025 22:18'!preferredParserClass	"Answer a parser class to use for parsing methods compiled by instances of the receiver."	^Parser! !Object subclass: #MIMEType	instanceVariableNames: 'main sub parameters'	classVariableNames: 'DefaultSuffixes StandardMIMEMappings'	poolDictionaries: ''	category: 'Network-MIME'!!MIMEType methodsFor: 'comparing' stamp: 'mir 3/6/2002 12:11' prior: 54286309!= anotherObject	anotherObject class == self class		ifFalse: [^false].	^self main = anotherObject main		and: [self sub = anotherObject sub]! !!MIMEType methodsFor: 'comparing' stamp: 'pre 6/1/2023 13:58' prior: 36269773!= anotherObject	anotherObject class == self class		ifFalse: [^false].	^self main asLowercase = anotherObject main asLowercase		and: [self sub asLowercase = anotherObject sub asLowercase]! !!MIMEType methodsFor: 'comparing' stamp: 'JMM 7/26/2006 16:26' prior: 54286520!beginsWith: aString	^self printString beginsWith: aString! !!MIMEType methodsFor: 'comparing' stamp: 'mir 12/17/2005 14:17' prior: 54286648!hash	^self main hash bitXor: self sub hash! !!MIMEType methodsFor: 'comparing' stamp: 'pre 6/1/2023 13:58' prior: 36270418!hash	^self main asLowercase hash bitXor: self sub asLowercase hash! !!MIMEType methodsFor: 'converting' stamp: 'mir 3/4/2002 18:21' prior: 54286761!asMIMEType	^self! !!MIMEType methodsFor: 'accessing' stamp: 'mir 3/4/2002 15:21' prior: 54286847!main	^main! !!MIMEType methodsFor: 'accessing' stamp: 'mir 3/4/2002 15:21' prior: 54286926!main: mainType	main := mainType! !!MIMEType methodsFor: 'accessing' stamp: 'pre 6/1/2023 14:08'!parameterAt: parameterName		^ parameters at: parameterName asLowercase! !!MIMEType methodsFor: 'accessing' stamp: 'mir 2/16/2006 23:33' prior: 54287027!parameters: params	parameters := params! !!MIMEType methodsFor: 'accessing' stamp: 'pre 6/1/2023 13:59' prior: 36271150!parameters: params	"We normalize as the access to parameters is case insensitive. --pre"	parameters := Dictionary newFrom: (params keys collect: [:key |		key asLowercase -> (params at: key)]).! !!MIMEType methodsFor: 'accessing' stamp: 'mir 3/4/2002 15:21' prior: 54287135!sub	^sub! !!MIMEType methodsFor: 'accessing' stamp: 'mir 3/4/2002 15:21' prior: 54287212!sub: subType	sub := subType! !!MIMEType methodsFor: 'printing' stamp: 'mir 3/4/2002 16:14' prior: 54287308!printOn: stream	stream		nextPutAll: main; nextPut: $/ ; nextPutAll: sub! !!MIMEType methodsFor: 'printing' stamp: 'mt 6/1/2023 11:17' prior: 36271757!printOn: stream	stream		nextPutAll: main; nextPut: $/ ;		nextPutAll: sub.	parameters ifNotNil: [		parameters isString			ifTrue: [ "OLD: broken parameter parsing"				stream nextPutAll: parameters]			ifFalse: [ "NEW: correct key-value parsing"				parameters keysAndValuesDo: [:key :value |					stream						nextPut: $; ; space;						nextPutAll: key;						nextPut: $= .					(value includesAnyOf: ';=/')						ifTrue: [stream nextPut: $"; nextPutAll: value; nextPut: $"]						ifFalse: [stream nextPutAll: value]] ]]! !!MIMEType methodsFor: 'initialize-release' stamp: 'pre 6/1/2023 13:22'!initialize	super initialize.	self 		main: '';		sub: '';		parameters: OrderedDictionary new.! !!MIMEType commentStamp: 'pre 6/1/2023 14:05' prior: 0!A MIMEType instances represent a specific MIME type including parameters.It adheres to https://datatracker.ietf.org/doc/html/rfc2045.------Design decisions:- the comparison currently normalizes the main and sub-type ad hoc to preserve the original case- parameter names are normalized to simplify the lookup logic!MIMEType class	instanceVariableNames: ''!!MIMEType class methodsFor: 'instance creation' stamp: 'mir 3/4/2002 17:09' prior: 54287566!contentTypeMultipart	^self main: 'multipart' sub: 'form-data'! !!MIMEType class methodsFor: 'instance creation' stamp: 'mir 3/6/2002 13:07' prior: 54287710!contentTypeURLEncoded	^self main: 'application' sub: 'x-www-form-urlencoded'! !!MIMEType class methodsFor: 'instance creation' stamp: 'mir 3/4/2002 17:06' prior: 54287869!defaultHTML	^self main: 'text' sub: 'html'! !!MIMEType class methodsFor: 'instance creation' stamp: 'mir 3/4/2002 15:25' prior: 54287994!defaultStream	^self main: 'application' sub: 'octet-stream'! !!MIMEType class methodsFor: 'instance creation' stamp: 'mir 3/4/2002 15:23' prior: 54288136!defaultText	^self main: 'text' sub: 'plain'! !!MIMEType class methodsFor: 'instance creation' stamp: 'tfel 8/9/2016 14:15' prior: 54288263!forExtension: fileExtension	| mime |	SmalltalkImage current platformName = 'Mac OS'		ifTrue: 			[mime := Smalltalk at: #MIMETypeMacResolver ifPresent: [:c | c getMIMETypeForFilename: 'a.',fileExtension]].	mime ifNotNil: [^mime].	^(self mimeMappings at: fileExtension asLowercase ifAbsent: [^nil]) first! !!MIMEType class methodsFor: 'instance creation' stamp: 'JMM 8/24/2006 13:38' prior: 54288654!forFileName: fileName	| ext type |	ext := FileDirectory extensionFor: fileName.	(ext = '' and: [SmalltalkImage current platformName = 'Mac OS'])		 ifTrue: [type := (FileDirectory default getMacFileTypeAndCreator: fileName) at: 1.			^self forExtension: type].	^self forExtension: (FileDirectory extensionFor: fileName)! !!MIMEType class methodsFor: 'instance creation' stamp: 'mir 2/16/2006 23:33' prior: 54289060!fromMIMEString: mimeString	| idx main rest sub parameters |	idx := mimeString indexOf: $/.	idx = 0		ifTrue: [self error: 'Illegal mime type string "' , mimeString , '".'].	main := mimeString copyFrom: 1 to: idx-1.	rest := mimeString copyFrom: idx+1 to: mimeString size.	idx := mimeString indexOf: $;.	idx = 0		ifTrue: [sub := rest]		ifFalse: [			sub := rest copyFrom: 1 to: idx.			parameters := rest copyFrom: idx+1 to: rest size].	 ^self		main: main		sub: sub		parameters: parameters! !!MIMEType class methodsFor: 'instance creation' stamp: 'pre 6/1/2023 13:23' prior: 36274739!fromMIMEString: mimeString	"Examples:		MIMEType fromMIMEString: 'text/plain'		MIMEType fromMIMEString: 'text/plain;charset=utf8'		MIMEType fromMIMEString: 'Message/Partial; number=2; total=3; id=""oc=jpbe0M2Yt4s@thumper.bellcore.com""'"	| idx main sub parameters |	parameters := OrderedDictionary new.	idx := mimeString indexOf: $/.	idx = 0		ifTrue: [self error: 'Illegal mime type string "' , mimeString , '".'].	main := mimeString copyFrom: 1 to: idx-1.	idx := mimeString indexOf: $; startingAt: idx+1.	idx = 0		ifTrue: [			sub := mimeString copyFrom: main size + 2 to: mimeString size]		ifFalse: [ | pos key val |			sub := mimeString copyFrom: main size + 2 to: idx-1.			pos := idx.			[pos < mimeString size] whileTrue: [				idx := idx + 1. "Skip $;"				[(mimeString at: idx) isSeparator] whileTrue: [idx := idx+1].				pos := mimeString indexOf: $= startingAt: idx.				key := mimeString copyFrom: idx to: pos-1.				idx := pos+1.				(mimeString at: idx) = $"					ifFalse: ["token"						pos := mimeString indexOf: $; startingAt: idx.						pos = 0 ifTrue: [pos := mimeString size + 1].						val := mimeString copyFrom: idx to: pos-1.						idx := pos]					ifTrue: ["quoted-string"						idx := idx+1.						pos := mimeString indexOf: $" startingAt: idx.						pos = 0 ifTrue: [self error: 'Illegal quoted-string in mime type string "' , mimeString , '".'].						val := mimeString copyFrom: idx to: pos-1.						idx := pos+1].				parameters at: key put: val]].	 ^self		main: main		sub: sub		parameters: parameters! !!MIMEType class methodsFor: 'instance creation' stamp: 'mir 3/4/2002 15:22' prior: 54289643!main: mainType sub: subType	^self new		main: mainType;		sub: subType! !!MIMEType class methodsFor: 'instance creation' stamp: 'pre 6/1/2023 13:19' prior: 36276985!main: mainType sub: subType	^self new		main: mainType;		sub: subType! !!MIMEType class methodsFor: 'instance creation' stamp: 'mir 2/16/2006 23:33' prior: 54289797!main: mainType sub: subType parameters: parameters	^self new		main: mainType;		sub: subType;		parameters: parameters! !!MIMEType class methodsFor: 'instance creation' stamp: 'pre 6/1/2023 13:19' prior: 36277324!main: mainType sub: subType parameters: parameters		^(self main: mainType sub: subType)		parameters: parameters;		yourself! !!MIMEType class methodsFor: 'class initialization' stamp: 'mir 3/25/2005 15:29' prior: 54290004!defaultSuffixes	"MIMEType defaultSuffixes"	^DefaultSuffixes ifNil: [DefaultSuffixes := self initializeDefaultSuffixes]! !!MIMEType class methodsFor: 'class initialization' stamp: 'JMM 2/8/2007 14:36' prior: 54290210!initialize	"MIMEType initialize"	self initializeStandardMIMETypes.  	FileDirectory initializeStandardMIMETypes.! !!MIMEType class methodsFor: 'class initialization' stamp: 'mir 3/25/2005 15:26' prior: 54290411!initializeDefaultSubTypeSuffixes	"MIMEType initializeDefaultSubTypeSuffixes"	| defaultSuffixes |	defaultSuffixes := Dictionary new: 43.	defaultSuffixes		at: 'jpeg' put: 'jpg';		yourself.	^defaultSuffixes! !!MIMEType class methodsFor: 'class initialization' stamp: 'mir 3/25/2005 15:31' prior: 54290708!initializeDefaultSuffixes	"MIMEType initializeDefaultSubTypeSuffixes"	"DefaultSuffixes := nil"	| defaultSuffixes |	defaultSuffixes := Dictionary new: 43.	defaultSuffixes		at: 'image/jpeg' put: 'jpg';		at: 'audio/x-mpeg' put: 'mp3';		at: 'video/x-mpeg' put: 'mpg';		at: 'image/png' put: 'png';		at: 'text/xml' put: 'xml';		yourself.	^defaultSuffixes! !!MIMEType class methodsFor: 'class initialization' stamp: 'mir 3/4/2002 17:03' prior: 54291154!initializeStandardMIMETypes	"MIMEType initializeStandardMIMETypes"	StandardMIMEMappings := Dictionary new.	self standardMIMETypes keysAndValuesDo:[:extension :mimeStrings |		StandardMIMEMappings			at: extension asString asLowercase			put: (mimeStrings collect: [:mimeString | MIMEType fromMIMEString: mimeString]).	].! !!MIMEType class methodsFor: 'class initialization' stamp: 'JMM 8/24/2006 13:51' prior: 54291565!standardMIMETypes	"MIMEType standardMIMETypes"	"We had to split this method because of the 256 literal limit in methods."	| mimeTypes |	mimeTypes := self standardMIMETypes2.	mimeTypes		at: 'adr' put: #('application/x-msaddr');		at: 'jpe' put: #('image/jpeg');		at: 'ttf' put: #('application/x-truetypefont');		at: 'wiz' put: #('application/msword');		at: 'xml' put: #('text/xml' 'text/html');		at: 'ppz' put: #('application/vnd.ms-powerpoint');		at: 'rpm' put: #('audio/x-pn-realaudio-plugin');		at: 'rgb' put: #('image/x-rgb');		at: 'mid' put: #('audio/midi' 'audio/x-midi');		at: 'pnm' put: #('image/x-portable-anymap');		at: 'bcpio' put: #('application/x-bcpio');		at: 'pot' put: #('application/vnd.ms-powerpoint');		at: 'o' put: #('application/octet-stream');		at: 'vgp' put: #('video/x-videogram-plugin');		at: 'ua' put: #('text/plain');		