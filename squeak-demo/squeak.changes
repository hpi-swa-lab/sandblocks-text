/2021 23:37'!testHenry142	self runRegex: #('^(a*){1,2}a$'		'' false nil		'a' true (1 'a' 2 ('' ''))		'aa' true (1 'aa' 2 ('a' ''))		'aaa' true (1 'aaa' 2 ('aa' '')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:37'!testHenry143	self runRegex: #('^(a+)*a$'		'' false nil		'a' true (1 'a' 2 ())		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('aa')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:37'!testHenry144	self runRegex: #('^(a+)+a$'		'' false nil		'a' false nil		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('aa')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:37'!testHenry145	self runRegex: #('^(a+)?a$'		'' false nil		'a' true (1 'a' 2 ())		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('aa')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:37'!testHenry146	self runRegex: #('^(a+){1,2}a$'		'' false nil		'a' false nil		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('aa')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:37'!testHenry147	self runRegex: #('^(a?)*a$'		'' false nil		'a' true (1 'a' 2 (''))		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('a' 'a')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:37'!testHenry148	self runRegex: #('^(a?)+a$'		'' false nil		'a' true (1 'a' 2 (''))		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('a' 'a')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:36'!testHenry149	self runRegex: #('^(a?)?a$'		'' false nil		'a' true (1 'a' 2 (''))		'aa' true (1 'aa' 2 ('a'))		'aaa' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:38'!testHenry150	self runRegex: #('^(a?){1,2}a$'		'' false nil		'a' true (1 'a' 2 ('' ''))		'aa' true (1 'aa' 2 ('a' ''))		'aaa' true (1 'aaa' 2 ('a' 'a')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:41'!testHenry151	self runRegex: #('^(a{1,2})*a$'		'' false nil		'a' true (1 'a' 2 ())		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('aa'))		'aaaa' true (1 'aaaa' 2 ('aa' 'a')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:41'!testHenry152	self runRegex: #('^(a{1,2})+a$'		'' false nil		'a' false nil		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('aa'))		'aaaa' true (1 'aaaa' 2 ('aa' 'a')))! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:42'!testHenry153	self runRegex: #('^(a{1,2})?a$'		'' false nil		'a' true (1 'a' 2 nil)		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('aa'))		'aaaa' false nil)! !!RxMatcherTest methodsFor: 'testing-henry' stamp: 'ct 10/20/2021 23:40'!testHenry154	self runRegex: #('^(a{1,2}){1,2}a$'		'' false nil		'a' false nil		'aa' true (1 'aa' 2 ('a'))		'aaa' true (1 'aaa' 2 ('aa'))		'aaaa' true (1 'aaaa' 2 ('aa' 'a')))! !!RxMatcherTest methodsFor: 'accessing' stamp: 'lr 1/15/2010 18:47' prior: 84742075!matcherClass	^ RxMatcher! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:28' prior: 84742181!testCaseInsensitive	| matcher |	matcher := self matcherClass forString: 'the quick brown fox' ignoreCase: true.	self assert: (matcher search: 'the quick brown fox').	self assert: (matcher search: 'The quick brown FOX').	self assert: (matcher search: 'What do you know about the quick brown fox?').	self assert: (matcher search: 'What do you know about THE QUICK BROWN FOX?')! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:28' prior: 84742641!testCaseSensitive	| matcher |	matcher := self matcherClass forString: 'the quick brown fox' ignoreCase: false.	self assert: (matcher search: 'the quick brown fox').	self deny: (matcher search: 'The quick brown FOX').	self assert: (matcher search: 'What do you know about the quick brown fox?').	self deny: (matcher search: 'What do you know about THE QUICK BROWN FOX?')! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:38' prior: 84743096!testCopyReplacingMatches	"See that the match context is preserved while copying stuff between matches:"		| matcher |	matcher := self matcherClass forString: '\<\d\D+'.	self assert: (matcher copy: '9aaa1bbb 8ccc' replacingMatchesWith: 'foo')		= 'foo1bbb foo'! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'hfm 4/2/2010 13:52' prior: 84743439!testCopyTranslatingMatches	| matcher |	matcher := self matcherClass forString: '\w+'.	self assert: (matcher copy: 'now is  the   time    ' translatingMatchesUsing: [ :each | each reversed ])		= 'won si  eht   emit    '! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'ct 10/12/2022 15:16'!testKeyedSubexpressions	{		#('abc' () ()).		#('(\w)+' () ()).		{'(?<foo>a)b(c)'. #(foo ('a')). {#foo. {1 to: 1}}}.		{'(?<foo>\w+)'. #(foo ('abc')). {#foo. {1 to: 3}}}.		{'(?<foo>\w)+'. #(foo ('a' 'b' 'c')). {#foo. {1 to: 1. 2 to: 2. 3 to: 3}}}.		{'(?<foo>((?<foo>b)|(?<foo>[^b]))+)'. #(foo ('a' 'b' 'c' 'abc' )). {#foo. {1 to: 1. 2 to: 2. 3 to: 3. 1 to: 3}}}.		#('abc(?<foo>\w)?' (foo ()) (foo ()))	} do: [:spec |		| matcher |		matcher := spec first asRegex.		self assert: (matcher matches: 'abc').		self			assert: (Dictionary newFromPairs: spec second)			equals: matcher allKeyedSubexpressions.		self			assert: (Dictionary newFromPairs: spec third) associations			equals:				(matcher keyedMarkers collect:					[:key | key -> (matcher keyedSubexpressionRanges: key) asArray])].! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'ct 5/1/2024 18:04' prior: 33793201!testKeyedSubexpressions	{		#('abc' () ()).		#('(\w)+' () ()).		{'(?<foo>a)b(c)'. #(foo ('a')). {#foo. {1 to: 1}}}.		{'(?<foo>\w+)'. #(foo ('abc')). {#foo. {1 to: 3}}}.		{'(?<foo>\w)+'. #(foo ('a' 'b' 'c')). {#foo. {1 to: 1. 2 to: 2. 3 to: 3}}}.		{'(?<foo>((?<foo>b)|(?<foo>[^b]))+)'. #(foo ('abc' 'a' 'b' 'c')). {#foo. {1 to: 3. 1 to: 1. 2 to: 2. 3 to: 3}}}.		#('abc(?<foo>\w)?' (foo ()) (foo ())).		{'(?<foo>)(?<foo>\w)*(?<foo>)'. #(foo ('' 'a' 'b' 'c' '')). {#foo. {1 to: 0. 1 to: 1. 2 to: 2. 3 to: 3. 4 to: 3}}}.	} do: [:spec |		| matcher |		matcher := spec first asRegex.		self assert: (matcher matches: 'abc').		self			assert: (Dictionary newFromPairs: spec second)			equals: matcher allKeyedSubexpressions.		self			assert: (Dictionary newFromPairs: spec third) associations			equals:				(matcher keyedMarkers collect:					[:key | key -> (matcher keyedSubexpressionRanges: key) asArray])].! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:45' prior: 84743741!testMatches	| matcher |	matcher := self matcherClass forString: '\w+'.	self assert: (matcher matches: 'now').	self deny: (matcher matches: 'now is')! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:38' prior: 84743973!testMatchesIn	| matcher |	matcher := self matcherClass forString: '\w+'.	self assert: (matcher matchesIn: 'now is the time') asArray 		= #('now' 'is' 'the' 'time')! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'hfm 4/2/2010 13:52' prior: 84744220!testMatchesInCollect	| matcher |	matcher := self matcherClass forString: '\w+'.	self assert: (matcher		matchesIn: 'now is the time'		collect: [ :each | each reversed ]) asArray			= #('won' 'si' 'eht' 'emit')! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:44' prior: 84744513!testMatchesInDo	| matcher expected |	matcher := self matcherClass forString: '\w+'.	expected := #('now' 'is' 'the' 'time') asOrderedCollection.	matcher 		matchesIn: 'now is the time'		do: [ :each | self assert: each = expected removeFirst ].	self assert: expected isEmpty! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:39' prior: 84744871!testMatchesOnStream	| matcher |	matcher := self matcherClass forString: '\w+'.	self assert: (matcher matchesOnStream: 'now is the time' readStream) asArray 		= #('now' 'is' 'the' 'time')! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'hfm 4/2/2010 13:52' prior: 84745141!testMatchesOnStreamCollect	| matcher |	matcher := self matcherClass forString: '\w+'.	self assert: (matcher 		matchesOnStream: 'now is the time' readStream 		collect: [ :each | each reversed ]) asArray			= #('won' 'si' 'eht' 'emit')! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:44' prior: 84745459!testMatchesOnStreamDo	| matcher expected |	matcher := self matcherClass forString: '\w+'.	expected := #('now' 'is' 'the' 'time') asOrderedCollection.	matcher 		matchesOnStream: 'now is the time' readStream		do: [ :each | self assert: each = expected removeFirst ].	self assert: expected isEmpty! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:45' prior: 84745840!testMatchesStream	| matcher |	matcher := self matcherClass forString: '\w+'.	self assert: (matcher matchesStream: 'now' readStream).	self deny: (matcher matchesStream: 'now is' readStream)! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'TestRunner 1/15/2010 20:51' prior: 84746120!testMatchingRangesIn	| matcher expected |	matcher := self matcherClass forString: '\w+'.	expected := #(1 3 5 6 8 10 12 15) asOrderedCollection.	(matcher matchingRangesIn: 'now is the time') do: [ :range |		self assert: range first = expected removeFirst.		self assert: range last = expected removeFirst ].	self assert: expected isEmpty! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'lr 1/15/2010 20:55' prior: 84746542!testSubexpressionCount	| matcher |	#(('a' 1) ('a(b)' 2) ('a(b(c))' 3) ('(a)(b)' 3) ('(a(b))*' 3)) do: [ :pair |		matcher := self matcherClass forString: pair first.		matcher supportsSubexpressions 			ifTrue: [ self assert: matcher subexpressionCount = pair last ] ]! !!RxMatcherTest methodsFor: 'testing-protocol' stamp: 'ct 10/5/2022 12:53'!testSubexpressions	{		{'abc'. #(('abc')). {{1 to: 3}}}.		{'(a)b(c)'. #(('abc') ('a') ('c')). {{1 to: 3}. {1 to: 1}. {3 to: 3}}}. 		{'(\w+)'. #(('abc') ('abc')). {{1 to: 3}. {1 to: 3}}}.		{'(\w)+'. #(('abc') ('a' 'b' 'c')). {{1 to: 3}. {1 to: 1. 2 to: 2. 3 to: 3}}}.		{'abc(\w)?'. #(('abc') ()). {{1 to: 3}. {}}}.		{'((a)|(b))((a)|(b))c'. #(('abc') ('a') ('a') () ('b') () ('b')). {{1 to: 3}. {1 to: 1}. {1 to: 1}. {}. {2 to: 2}. {}. {2 to: 2}}}	} do: [:spec |		| matcher |		matcher := spec first asRegex.		self assert: (matcher matches: 'abc').		self			assert: spec second			equals: (matcher allSubexpressions collect: #asArray).		self			assert: spec third			equals:				((1 to: matcher subexpressionCount) collect:					[:index | (matcher subexpressionRanges: index) asArray])].! !!RxMatcherTest methodsFor: 'testing-empty' stamp: 'lr 1/15/2010 21:46' prior: 84746890!testEmptyStringAtBeginningOfLine	| matcher |	matcher := self matcherClass forString: '^'.	self		assert: (matcher copy: 'foo1 bar1' , String cr , 'foo2 bar2' replacingMatchesWith: '*')			= ('*foo1 bar1' , String cr , '*foo2 bar2')		description: 'An empty string at the beginning of a line'! !!RxMatcherTest methodsFor: 'testing-empty' stamp: 'lr 1/15/2010 20:05' prior: 84747261!testEmptyStringAtBeginningOfWord	| matcher |	matcher := self matcherClass forString: '\<'.	self		assert: (matcher copy: 'foo bar' replacingMatchesWith: '*')			= '*foo *bar'		description: 'An empty string at the beginning of a word'! !!RxMatcherTest methodsFor: 'testing-empty' stamp: 'TestRunner 1/15/2010 21:18' prior: 84747583!testEmptyStringAtEndOfLine	| matcher |	matcher := self matcherClass forString: '$'.	self		assert: (matcher copy: 'foo1 bar1' , String cr , 'foo2 bar2' replacingMatchesWith: '*')			= ('foo1 bar1*', String cr , 'foo2 bar2*')		description: 'An empty string at the end of a line'! !!RxMatcherTest methodsFor: 'testing-empty' stamp: 'TestRunner 1/15/2010 21:18' prior: 84747949!testEmptyStringAtEndOfWord	| matcher |	matcher := self matcherClass forString: '\>'.	self		assert: (matcher copy: 'foo bar' replacingMatchesWith: '*')			= 'foo* bar*'		description: 'An empty string at the end of a word'! !!RxMatcherTest methodsFor: 'testing-empty' stamp: 'TestRunner 1/15/2010 21:18' prior: 84748259!testEmptyStringAtWordBoundary	| matcher |	matcher := self matcherClass forString: '\b'.	self		assert: (matcher copy: 'foo bar' replacingMatchesWith: '*')			= '*foo* *bar*'		description: 'An empty string at a word boundary'! !!RxMatcherTest methodsFor: 'testing-empty' stamp: 'TestRunner 1/15/2010 21:19' prior: 84748572!testEmptyStringNotAtWordBoundary	| matcher |	matcher := self matcherClass forString: '\B'.	self		assert: (matcher copy: 'foo bar' replacingMatchesWith: '*')			= 'f*o*o b*a*r'		description: 'An empty string not at a word boundary'! !!RxMatcherTest methodsFor: 'testing' stamp: 'ct 8/23/2021 18:02'!testCapturingGroup	self runRegex: #('(a)(b)c'		'c' false nil		'abc' true (1 'abc' 2 'a' 3 'b')		'eabcd' true (1 'abc' 2 'a' 3 'b')).	self flag: #tests. "ct: It might be helpful to test subexpressionCount, too"! !!RxMatcherTest methodsFor: 'testing' stamp: 'nice 11/12/2025 21:41'!testLongestMatch	self runRegex:		#('.*(ABC|B)'			'fooB' true (1 'fooB' 2 'B')			'fooABC' true (1 'fooABC' 2 'ABC' )).	self runRegex:		#('.*(ABCD|BC)'			'fooBC' true (1 'fooBC' 2 'BC')			'fooABCD' true (1 'fooABCD' 2 'ABCD')).				"mantis 0005391"	self runRegex:		#('[1-9]|1[0-9]'			'15' true (1 '15' )		).	self runRegex:		#('1[0-9]|[1-9]'			'15' true (1 '15' )		)! !!RxMatcherTest methodsFor: 'testing' stamp: 'ct 10/5/2022 14:48'!testMatchNullable	self assert: #('A' '' '') equals: ('AB' allRegexMatches: 'A?') asArray.! !!RxMatcherTest methodsFor: 'testing' stamp: 'ct 8/23/2021 18:02'!testNonCapturingGroup	self runRegex: #('(?:a)(b)c'		'bc' false nil		'abc' true (1 'abc' 2 'b')		'eabcd' true (1 'abc' 2 'b')).	self flag: #tests. "ct: It might be helpful to test subexpressionCount, too"! !!RxMatcherTest methodsFor: 'testing' stamp: 'pre 5/20/2016 09:35' prior: 84748880!testOptionalMultipleQuantifiedSubexpression	<timeout: 0.1>	self runRegex: #('((aa?){2})'		'' false nil		'a' false nil		'aa' true (1 'aa')		'baaa' true (1 'aaa' 2 'aaa'))! !!RxMatcherTest methodsFor: 'testing' stamp: 'pre 5/20/2016 09:34' prior: 84749378!testOptionalNestedIntoMultipleQuantified	<timeout: 0.1>	self runRegex: #('(aa?){2}'		'' false nil		'a' false nil		'aa' true (1 'aa')		'baaa' true (1 'aaa' 2 'a'))! !!RxMatcherTest methodsFor: 'testing' stamp: 'lr 1/15/2010 19:47' prior: 84749618!testRegex001	self runRegex: #('^.*$' 		'' true (1 '')		'a' true (1 'a')		'abc' true (1 'abc'))! !!RxMatcherTest methodsFor: 'testing' stamp: 'lr 1/15/2010 19:47' prior: 84749787!testRegex002	self runRegex: #('a\w+c'		' abb_bbc ' true (1 'abb_bbc')		'abb-bc' false nil)! !!RxMatcherTest methodsFor: 'testing' stamp: 'lr 1/15/2010 19:47' prior: 84749951!testRegex003	self runRegex: #('a\W+c'		' abb_bbc ' false nil		'abb-bc' false nil		'a.,:;-&!!"#%/()={[]}+?\~*''c' true (1 'a.,:;-&!!"#%/()={[]}+?\~*''c'))! !!RxMatcherTest methodsFor: 'testing' stamp: 'ct 10/12/2022 21:11' prior: 84750179!testRegex004	self runRegex: #(':isVowel:'		'aei' true nil		'xyz' false nil).	self runRegex: #(':^isVowel:'		'aei' false nil		'xyz' true nil)! !!RxMatcherTest methodsFor: 'testing-extensions' stamp: 'lr 4/23/2010 08:50' prior: 84750340!testStringAllRangesOfRegexMatches	| result |	result := 'aabbcc' allRangesOfRegexMatches: 'b+'.	self assert: result size = 1.	self assert: result first first = 3.	self assert: result first last = 4	! !!RxMatcherTest methodsFor: 'testing-extensions' stamp: 'lr 4/23/2010 08:50' prior: 84750625!testStringAllRegexMatches	| result |	result := 'aabbcc' allRegexMatches: 'b+'.	self assert: result size = 1.	self assert: result first = 'bb'! !!RxMatcherTest methodsFor: 'testing-extensions' s