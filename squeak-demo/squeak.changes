True: [aContext cannotReturn: aBlock value to: aContext].	ctx := self.	ctx isUnwindContext ifFalse: [ctx := ctx findNextUnwindContextUpTo: aContext].	[ctx isNil] whileFalse: [		(ctx tempAt: 2) ifNil: [ | unwindBlock |			ctx tempAt: 2 put: true.   "see Note 1; unwind block hasn't run yet"			unwindBlock := ctx tempAt: 1.   "ctx tempAt: 1 refers to the unwind block"			thisContext terminateTo: ctx.   "see Note 2"			unwindBlock value.   "execute the unwind block"			ctx tempAt: 2 put: false].   "see Note 1; unwind block has completed"		ctx := ctx findNextUnwindContextUpTo: aContext].	thisContext terminateTo: aContext.	^aBlock value		"Note 1: ctx tempAt: 2 refers to the 'complete' variable in unwind contexts (#ensure: and	 #ifCurtailed:). #true means the receiver block has already finished but the unwind block	 has not run yet. #false then marks the unwind block as completed.	 See also #unwindTo:safely: and #finishIncompleteUnwindsUpTo: for more information."		"Note 2: The unwind algorithm runs at the top of the context chain being unwound hence	 we need to keep removing the part of the context chain down to the next unwind context	 for the unwind block to be executed in the correct evaluation context. "! !!Context methodsFor: 'private' stamp: 'jar 11/19/2025 10:34' prior: 35039247!unwindAndResume: aContext evaluating: aBlock	"Unwind the receiver to aContext and resume with aBlock value as result of last send.	 Execute any unwind blocks while unwinding.	 ASSUMES aContext is a sender of thisContext."		| ctx |	ctx := self.	ctx isUnwindContext "Note 1" ifFalse: [ctx := ctx findNextUnwindContextUpTo: aContext].	[ctx isNil] whileFalse: [  "ctx is an #ensure: or #ifCurtailed: context"		(ctx tempAt: 2) ifNil: [ | unwindBlock |   "unwind block hasn't run yet; see Note 4"			ctx tempAt: 2 put: #unwindRunnable.			unwindBlock := ctx tempAt: 1.   "#ensure:/ifCurtailed: argument block; Note 2"			thisContext terminateTo: ctx.   "Note 3"			unwindBlock